@namespace Caissalytics.Components.Board
@using Caissalytics.Core
@using Caissalytics.Data
@inject IJSRuntime JS
@inject IUserProfileService ProfileService
@inject IAppearanceService AppearanceService
@implements IAsyncDisposable

<div class="board-column @(SideGauge != null ? "has-side-gauge" : "")">
	@if (ShowPlayerBars)
	{
		<div class="board-player-bar top-bar @(TopPlayerIsUser ? "bar-is-user" : "")">
			<div class="player-info-group">
				@RenderPieceIcon(TopPlayerIsWhite)
				<span class="player-name-text @(TopPlayerIsUser ? "player-name-user" : "")">
					@TopPlayerName
					@if (TopPlayerIsUser)
					{
						<span class="player-user-badge" title="@Loc["Board_You"]">@Loc["Board_You"]</span>
					}
				</span>
				@if (!string.IsNullOrEmpty(TopPlayerElo))
				{
					<span class="player-elo-badge">@TopPlayerElo</span>
				}
				@RenderCapturedMaterial(TopCapturedPieces, TopMaterialAdvantage)
			</div>
			@if (ClockState.HasClocks && !string.IsNullOrEmpty(TopClockFormatted))
			{
				<div class="board-clock-badge @(TopIsActive ? "clock-active" : "") @(TopIsLowTime ? "clock-low-time" : "")"
					 title="Time remaining: @TopClock">
					<span class="clock-icon">⏱</span>
					<span class="clock-digits">@TopClockFormatted</span>
				</div>
			}
		</div>
	}

	<div class="board-middle-row">
		@if (SideGauge != null)
		{
			@SideGauge
		}
		<div class="board-wrapper @($"board-theme-{_appearanceSettings.BoardTheme}")">
			<div id="@_elementId" class="chessground-target"></div>

			@if (_showPromotionDialog)
			{
				<div class="promotion-dialog-overlay">
					<div class="promotion-dialog-content">
						<button class="promotion-piece-btn" @onclick="() => SelectPromotion(PieceType.Queen)" title="@Loc["Board_Promotion_Queen"]">
							@(_pendingPromotionColor == PieceColor.White ? "♕" : "♛")
						</button>
						<button class="promotion-piece-btn" @onclick="() => SelectPromotion(PieceType.Rook)" title="@Loc["Board_Promotion_Rook"]">
							@(_pendingPromotionColor == PieceColor.White ? "♖" : "♜")
						</button>
						<button class="promotion-piece-btn" @onclick="() => SelectPromotion(PieceType.Bishop)" title="@Loc["Board_Promotion_Bishop"]">
							@(_pendingPromotionColor == PieceColor.White ? "♗" : "♝")
						</button>
						<button class="promotion-piece-btn" @onclick="() => SelectPromotion(PieceType.Knight)" title="@Loc["Board_Promotion_Knight"]">
							@(_pendingPromotionColor == PieceColor.White ? "♘" : "♞")
						</button>
					</div>
				</div>
			}
		</div>
	</div>

	@if (ShowPlayerBars)
	{
		<div class="board-player-bar bottom-bar @(BottomPlayerIsUser ? "bar-is-user" : "")">
			<div class="player-info-group">
				@RenderPieceIcon(BottomPlayerIsWhite)
				<span class="player-name-text @(BottomPlayerIsUser ? "player-name-user" : "")">
					@BottomPlayerName
					@if (BottomPlayerIsUser)
					{
						<span class="player-user-badge" title="@Loc["Board_You"]">@Loc["Board_You"]</span>
					}
				</span>
				@if (!string.IsNullOrEmpty(BottomPlayerElo))
				{
					<span class="player-elo-badge">@BottomPlayerElo</span>
				}
				@RenderCapturedMaterial(BottomCapturedPieces, BottomMaterialAdvantage)
			</div>
			@if (ClockState.HasClocks && !string.IsNullOrEmpty(BottomClockFormatted))
			{
				<div class="board-clock-badge @(BottomIsActive ? "clock-active" : "") @(BottomIsLowTime ? "clock-low-time" : "")"
					 title="Time remaining: @BottomClock">
					<span class="clock-icon">⏱</span>
					<span class="clock-digits">@BottomClockFormatted</span>
				</div>
			}
		</div>
	}

	<div class="board-controls-toolbar">
		<button class="board-control-btn" title="@Loc["Board_FirstMove"]" @onclick="OnFirst" disabled="@(!CanGoBack)">
			<svg class="board-control-icon" viewBox="0 0 24 24" fill="currentColor">
				<path d="M5 5h2v14H5zm4 7 10 7V5z"/>
			</svg>
		</button>
		<button class="board-control-btn" title="@Loc["Board_PrevMove"]" @onclick="OnPrev" disabled="@(!CanGoBack)">
			<svg class="board-control-icon" viewBox="0 0 24 24" fill="currentColor">
				<path d="M17 5v14l-10-7z"/>
			</svg>
		</button>
		<button class="board-control-btn" title="@Loc["Board_NextMove"]" @onclick="OnNext" disabled="@(!CanGoForward)">
			<svg class="board-control-icon" viewBox="0 0 24 24" fill="currentColor">
				<path d="M7 5v14l10-7z"/>
			</svg>
		</button>
		<button class="board-control-btn" title="@Loc["Board_LastMove"]" @onclick="OnLast" disabled="@(!CanGoForward)">
			<svg class="board-control-icon" viewBox="0 0 24 24" fill="currentColor">
				<path d="M5 5v14l10-7-10-7zm12 0h2v14h-2z"/>
			</svg>
		</button>
		<div class="control-divider"></div>
		<button class="board-control-btn" title="@Loc["Board_FlipBoard"]" @onclick="ToggleOrientation">
			<svg class="board-control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
				<path d="M3 3v5h5"/>
				<path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
				<path d="M16 16h5v5"/>
			</svg>
		</button>
	</div>
</div>

@code {
	[Parameter, EditorRequired] public BoardPosition Position { get; set; } = default!;
	[Parameter] public Move? LastMove { get; set; }
	[Parameter] public string Orientation { get; set; } = "white";
	[Parameter] public EventCallback<Move> OnMoveMade { get; set; }
	[Parameter] public EventCallback<string> OrientationChanged { get; set; }

	[Parameter] public bool CanGoBack { get; set; }
	[Parameter] public bool CanGoForward { get; set; }
	[Parameter] public EventCallback OnFirst { get; set; }
	[Parameter] public EventCallback OnPrev { get; set; }
	[Parameter] public EventCallback OnNext { get; set; }
	[Parameter] public EventCallback OnLast { get; set; }
	[Parameter] public bool EnableSound { get; set; } = true;

	[Parameter] public GameTree? Tree { get; set; }
	[Parameter] public RenderFragment? SideGauge { get; set; }

	private BoardClockState ClockState => GameClockHelper.GetClockState(Tree);

	private string WhiteName => Tree?.Headers.GetValueOrDefault("White", "White") ?? "White";
	private string BlackName => Tree?.Headers.GetValueOrDefault("Black", "Black") ?? "Black";
	private string? WhiteElo => Tree != null && Tree.Headers.TryGetValue("WhiteElo", out var we) && !string.IsNullOrWhiteSpace(we) && we != "?" ? we : null;
	private string? BlackElo => Tree != null && Tree.Headers.TryGetValue("BlackElo", out var be) && !string.IsNullOrWhiteSpace(be) && be != "?" ? be : null;

	private bool HasPlayerInfo => WhiteName != "White" || BlackName != "Black" || WhiteElo != null || BlackElo != null;
	private bool ShowPlayerBars => Tree != null && (ClockState.HasClocks || HasPlayerInfo || MaterialState.HasCaptures);

	private BoardMaterialState MaterialState => MaterialHelper.GetMaterialState(Position);

	private List<CapturedPiece> TopCapturedPieces => TopPlayerIsWhite ? MaterialState.WhiteCaptured : MaterialState.BlackCaptured;
	private int TopMaterialAdvantage => TopPlayerIsWhite ? MaterialState.WhiteAdvantage : MaterialState.BlackAdvantage;

	private List<CapturedPiece> BottomCapturedPieces => BottomPlayerIsWhite ? MaterialState.WhiteCaptured : MaterialState.BlackCaptured;
	private int BottomMaterialAdvantage => BottomPlayerIsWhite ? MaterialState.WhiteAdvantage : MaterialState.BlackAdvantage;

	private bool TopPlayerIsWhite => Orientation != "white";
	private bool BottomPlayerIsWhite => Orientation == "white";

	private string TopPlayerName => TopPlayerIsWhite ? WhiteName : BlackName;
	private string? TopPlayerElo => TopPlayerIsWhite ? WhiteElo : BlackElo;
	private string? TopClock => TopPlayerIsWhite ? ClockState.WhiteClock : ClockState.BlackClock;
	private string? TopClockFormatted => TopPlayerIsWhite ? ClockState.WhiteClockFormatted : ClockState.BlackClockFormatted;
	private bool TopIsActive => !ClockState.IsGameOver && (TopPlayerIsWhite ? ClockState.IsWhiteTurn : !ClockState.IsWhiteTurn);
	private bool TopIsLowTime => TopPlayerIsWhite ? ClockState.WhiteLowTime : ClockState.BlackLowTime;

	private string BottomPlayerName => BottomPlayerIsWhite ? WhiteName : BlackName;
	private string? BottomPlayerElo => BottomPlayerIsWhite ? WhiteElo : BlackElo;
	private string? BottomClock => BottomPlayerIsWhite ? ClockState.WhiteClock : ClockState.BlackClock;
	private string? BottomClockFormatted => BottomPlayerIsWhite ? ClockState.WhiteClockFormatted : ClockState.BlackClockFormatted;
	private bool BottomIsActive => !ClockState.IsGameOver && (BottomPlayerIsWhite ? ClockState.IsWhiteTurn : !ClockState.IsWhiteTurn);
	private bool BottomIsLowTime => BottomPlayerIsWhite ? ClockState.WhiteLowTime : ClockState.BlackLowTime;

	private UserProfile _userProfile = new();
	private AppearanceSettings _appearanceSettings = new();
	private Move? _lastSoundMove;

	private string? WhiteFideId => Tree != null && Tree.Headers.TryGetValue("WhiteFideId", out var id) ? id : null;
	private string? BlackFideId => Tree != null && Tree.Headers.TryGetValue("BlackFideId", out var id) ? id : null;

	private bool WhiteIsUser => _userProfile.MatchesPlayer(WhiteName, WhiteFideId);
	private bool BlackIsUser => _userProfile.MatchesPlayer(BlackName, BlackFideId);

	private bool TopPlayerIsUser => TopPlayerIsWhite ? WhiteIsUser : BlackIsUser;
	private bool BottomPlayerIsUser => BottomPlayerIsWhite ? WhiteIsUser : BlackIsUser;

	protected override async Task OnInitializedAsync()
	{
		Loc.OnLanguageChanged += StateHasChanged;
		ProfileService.OnProfileChanged += HandleProfileChanged;
		AppearanceService.OnAppearanceChanged += HandleAppearanceChanged;
		await LoadProfileAsync();
		_appearanceSettings = await AppearanceService.GetSettingsAsync();
		_lastSoundMove = LastMove;
	}

	private async Task LoadProfileAsync()
	{
		_userProfile = await ProfileService.GetProfileAsync();
	}

	private async void HandleProfileChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadProfileAsync();
			StateHasChanged();
		});
	}

	private async void HandleAppearanceChanged(AppearanceSettings settings)
	{
		await InvokeAsync(() =>
		{
			_appearanceSettings = settings;
			StateHasChanged();
		});
	}

	private static RenderFragment RenderCapturedMaterial(List<CapturedPiece> captured, int advantage) => builder =>
	{
		if (captured.Count == 0 && advantage <= 0) return;

		builder.OpenElement(0, "div");
		builder.AddAttribute(1, "class", "captured-material-group");

		if (captured.Count > 0)
		{
			builder.OpenElement(2, "div");
			builder.AddAttribute(3, "class", "captured-pieces-list");
			int seq = 4;
			foreach (var piece in captured)
			{
				builder.OpenElement(seq++, "span");
				string colorClass = piece.Color == PieceColor.White ? "white" : "black";
				string typeClass = piece.Type.ToString().ToLowerInvariant();
				builder.AddAttribute(seq++, "class", $"captured-piece {typeClass} {colorClass}");
				builder.AddAttribute(seq++, "title", $"Captured {colorClass} {typeClass}");
				builder.CloseElement();
			}
			builder.CloseElement(); // captured-pieces-list
		}

		if (advantage > 0)
		{
			builder.OpenElement(100, "span");
			builder.AddAttribute(101, "class", "material-advantage-badge");
			builder.AddAttribute(102, "title", $"Material lead: +{advantage}");
			builder.AddContent(103, $"+{advantage}");
			builder.CloseElement();
		}

		builder.CloseElement(); // captured-material-group
	};

	private static RenderFragment RenderPieceIcon(bool isWhite) => builder =>
	{
		builder.OpenElement(0, "span");
		builder.AddAttribute(1, "class", isWhite ? "player-piece-indicator piece-white" : "player-piece-indicator piece-black");
		builder.AddAttribute(2, "title", isWhite ? "White" : "Black");

		builder.OpenElement(3, "svg");
		builder.AddAttribute(4, "class", "piece-icon-svg");
		builder.AddAttribute(5, "viewBox", "0 0 45 45");
		builder.AddAttribute(6, "aria-hidden", "true");

		builder.OpenElement(7, "path");
		builder.AddAttribute(8, "class", isWhite ? "pawn-white-path" : "pawn-black-path");
		builder.AddAttribute(9, "d", "M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z");
		builder.CloseElement(); // path

		builder.CloseElement(); // svg
		builder.CloseElement(); // span
	};

	private readonly string _elementId = $"board_{Guid.NewGuid():N}";
	private IJSObjectReference? _module;
	DotNetObjectReference<ChessgroundBoard>? _dotNetRef;
	private bool _isInitialized = false;
	private bool _isDisposed = false;
	private ulong _lastRenderedZobrist;
	private string _lastRenderedOrientation = "white";

	private bool _showPromotionDialog = false;
	private Square _pendingFrom = Square.None;
	private Square _pendingTo = Square.None;
	private PieceColor _pendingPromotionColor = PieceColor.White;

	protected override async Task OnParametersSetAsync()
	{
		if (_isInitialized && Position != null)
		{
			if (Position.ZobristKey != _lastRenderedZobrist || Orientation != _lastRenderedOrientation)
			{
				_lastRenderedZobrist = Position.ZobristKey;
				_lastRenderedOrientation = Orientation;
				await UpdateBoardStateAsync(Position, LastMove);
			}
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			AppearanceService.SetJSRuntime(JS);
			_dotNetRef = DotNetObjectReference.Create(this);
			_module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chessgroundInterop.js");

			var dests = MoveGenerator.GetLegalDestinations(Position);
			string turnColor = Position.ActiveColor == PieceColor.White ? "white" : "black";
			string fen = FenParser.ToFen(Position, includeCounters: false);

			var config = new
			{
				fen = fen,
				orientation = Orientation,
				turnColor = turnColor,
				dests = dests
			};

			await _module.InvokeVoidAsync("initBoard", _elementId, _dotNetRef, config);
			_lastRenderedZobrist = Position.ZobristKey;
			_lastRenderedOrientation = Orientation;
			_isInitialized = true;
		}
	}

	public async Task UpdateBoardStateAsync(BoardPosition pos, Move? lastMove, List<object>? shapes = null)
	{
		if (_isDisposed || !_isInitialized || _module == null) return;

		Position = pos;
		LastMove = lastMove;
		_lastRenderedZobrist = pos.ZobristKey;
		_lastRenderedOrientation = Orientation;

		var dests = MoveGenerator.GetLegalDestinations(pos);
		string turnColor = pos.ActiveColor == PieceColor.White ? "white" : "black";
		string fen = FenParser.ToFen(pos, includeCounters: false);
		bool inCheck = MoveGenerator.IsInCheck(pos, pos.ActiveColor);

		string[]? lastMoveArr = lastMove.HasValue && !lastMove.Value.IsEmpty
			? [lastMove.Value.From.Name(), lastMove.Value.To.Name()]
			: null;

		try
		{
			await _module.InvokeVoidAsync("updateBoard", _elementId, fen, Orientation, turnColor, dests, lastMoveArr, inCheck);

			if (shapes != null)
			{
				await _module.InvokeVoidAsync("drawShapes", _elementId, shapes);
			}

			if (EnableSound && lastMove.HasValue && !lastMove.Value.IsEmpty && (_lastSoundMove == null || !_lastSoundMove.Value.Equals(lastMove.Value)))
			{
				_lastSoundMove = lastMove;
				if (inCheck)
				{
					_ = AppearanceService.PlaySoundAsync(ChessSoundType.Check, JS);
				}
				else if (lastMove.Value.IsCapture || lastMove.Value.IsEnPassant)
				{
					_ = AppearanceService.PlaySoundAsync(ChessSoundType.Capture, JS);
				}
				else
				{
					_ = AppearanceService.PlaySoundAsync(ChessSoundType.Move, JS);
				}
			}
		}
		catch (ObjectDisposedException) { }
		catch (JSDisconnectedException) { }
		catch (JSException) { }
		catch (InvalidOperationException) { }
	}

	public async Task RedrawAsync()
	{
		if (_isDisposed || !_isInitialized || _module == null) return;
		try
		{
			await _module.InvokeVoidAsync("redrawBoard", _elementId);
		}
		catch { }
	}

	[JSInvokable]
	public async Task OnPieceMoved(string orig, string dest)
	{
		var fromSq = SquareExtensions.Parse(orig);
		var toSq = SquareExtensions.Parse(dest);

		if (fromSq == Square.None || toSq == Square.None) return;

		var piece = Position[fromSq];
		bool isPawn = piece.Type == PieceType.Pawn;
		bool isPromo = isPawn && (toSq.Rank() == 7 || toSq.Rank() == 0);

		if (isPromo)
		{
			_pendingFrom = fromSq;
			_pendingTo = toSq;
			_pendingPromotionColor = piece.Color;
			_showPromotionDialog = true;
			StateHasChanged();
			return;
		}

		// Find matching legal move
		var legalMoves = MoveGenerator.GenerateLegalMoves(Position);
		var move = legalMoves.FirstOrDefault(m => m.From == fromSq && m.To == toSq);

		if (!move.IsEmpty)
		{
			await OnMoveMade.InvokeAsync(move);
		}
		else
		{
			// Invalid move: revert board
			await UpdateBoardStateAsync(Position, LastMove);
		}
	}

	private async Task SelectPromotion(PieceType promoType)
	{
		_showPromotionDialog = false;
		var legalMoves = MoveGenerator.GenerateLegalMoves(Position);
		var move = legalMoves.FirstOrDefault(m => m.From == _pendingFrom && m.To == _pendingTo && m.Promotion == promoType);

		if (!move.IsEmpty)
		{
			await OnMoveMade.InvokeAsync(move);
		}
		else
		{
			await UpdateBoardStateAsync(Position, LastMove);
		}
	}

	private async Task ToggleOrientation()
	{
		Orientation = Orientation == "white" ? "black" : "white";
		await OrientationChanged.InvokeAsync(Orientation);
		await UpdateBoardStateAsync(Position, LastMove);
	}

	public async ValueTask DisposeAsync()
	{
		_isDisposed = true;
		Loc.OnLanguageChanged -= StateHasChanged;
		ProfileService.OnProfileChanged -= HandleProfileChanged;
		AppearanceService.OnAppearanceChanged -= HandleAppearanceChanged;
		try
		{
			if (_module != null)
			{
				await _module.InvokeVoidAsync("destroyBoard", _elementId);
				await _module.DisposeAsync();
			}
		}
		catch { }

		try
		{
			_dotNetRef?.Dispose();
		}
		catch { }
	}
}
