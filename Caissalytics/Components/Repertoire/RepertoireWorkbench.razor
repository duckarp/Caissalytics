	{
		Workspace.CreateAnalysisTab(
			title: $"Analysis: {game.White} vs {game.Black}",
			pgn: game.Pgn,
			targetDatabase: _selectedDb,
			databaseGameId: game.Id);
	}

	private static string GetResultClass(string result)
	{
		return result switch
		{
			"1-0" => "white-win",
			"0-1" => "black-win",
			_ => "draw"
		};
	}

	private string GetRepertoireStatusDisplay(string? status)
	{
		return (status?.ToLowerInvariant()) switch
		{
			"main" => Loc["Rep_Main_Badge"],
			"alt" => Loc["Rep_Alt_Badge"],
			"surprise" => Loc["Rep_Surprise_Badge"],
			_ => status ?? ""
		};
	}

	public void Dispose()
	{
		StopReplay();
		Loc.OnLanguageChanged -= StateHasChanged;
		RepertoireService.OnRepertoireChanged -= HandleRepertoireChanged;
		DatabaseService.OnActiveDatabaseChanged -= HandleActiveDatabaseChanged;
	}
