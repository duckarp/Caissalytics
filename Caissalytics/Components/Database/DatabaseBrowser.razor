	private async Task LoadBulkMoveTargetFoldersAsync(string dbName)
	{
		_bulkMoveTargetFolderOptions.Clear();
		if (string.IsNullOrWhiteSpace(dbName)) return;

		var folders = string.Equals(dbName, _currentDbName, StringComparison.OrdinalIgnoreCase)
			? _folders
			: await DatabaseService.GetFoldersAsync(dbName);

		void AddNode(GameFolder folder, int depth)
		{
			string indent = new string(' ', depth * 3);
			string prefix = depth > 0 ? $"{indent}↳ " : "";
			_bulkMoveTargetFolderOptions.Add((folder.Id, $"{prefix}📁 {folder.Name}"));
			foreach (var child in folders.Where(f => f.ParentId == folder.Id).OrderBy(f => f.SortOrder).ThenBy(f => f.Name))
			{
				AddNode(child, depth + 1);
			}
		}

		foreach (var root in folders.Where(f => f.ParentId == null).OrderBy(f => f.SortOrder).ThenBy(f => f.Name))
		{
			AddNode(root, 0);
		}
	}

