	private static string FormatFileSize(long bytes)
	{
		if (bytes < 1024) return $"{bytes} B";
		if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):0.1} KB";
		if (bytes < 1024L * 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):0.2} MB";
		return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):0.2} GB";
	}

	private async Task CreateDbFromPgnAsync()
	{
		if (_isCreatingFromPgn || !CanStartCreateDbFromPgn)
		{
			return;
		}

		string name = _newDbName.Trim();
		_isCreatingFromPgn = true;
		_createPgnFinished = false;
		_newDbPgnError = "";
		_createPgnProgress = new PgnImportProgress();
		_createPgnCts = new CancellationTokenSource();

		var progressReporter = new Progress<PgnImportProgress>(p =>
		{
			_createPgnProgress = p;
			InvokeAsync(StateHasChanged);
		});

		// Capture locals for the background task so we don't capture 'this' state mutably
		var token = _createPgnCts.Token;

		try
		{
			var db = await DatabaseService.CreateDatabaseAsync(name);
			_createdPgnDbName = db.Name;

			if (_newDbPgnSource == PgnSource.Text)
			{
				var pgnText = _newDbPgnText;
				await Task.Run(() => DatabaseService.ImportPgnTextAsync(db.Name, pgnText, progressReporter, token), token);
			}
			else if (!string.IsNullOrEmpty(_newDbDroppedFilePath) && File.Exists(_newDbDroppedFilePath))
			{
				var fileName = _newDbPgnFileName;
				var filePath = _newDbDroppedFilePath;
				await Task.Run(async () =>
				{
					await using var fsRead = File.OpenRead(filePath);
					await DatabaseService.ImportPgnStreamAsync(db.Name, fsRead, fileName, progressReporter, token);
				}, token);
			}
			else
			{
				string tempFile = Path.Combine(Path.GetTempPath(), $"caissa_create_db_{Guid.NewGuid():N}.tmp");
				try
				{
					await using (var fs = File.Create(tempFile))
					{
						if (_newDbDroppedStreamRef != null)
						{
							await using var jsStream = await _newDbDroppedStreamRef.OpenReadStreamAsync(maxAllowedSize: 2048L * 1024 * 1024, cancellationToken: token);
							await jsStream.CopyToAsync(fs, token);
						}
						else if (_newDbPgnFile != null)
						{
							await using var browserStream = _newDbPgnFile.OpenReadStream(maxAllowedSize: 2048L * 1024 * 1024, cancellationToken: token);
							await browserStream.CopyToAsync(fs, token);
						}
						else
						{
							throw new InvalidOperationException("No file was selected.");
						}
					}

					var fileName = _newDbPgnFileName;
					await Task.Run(async () =>
					{
						await using var fsRead = File.OpenRead(tempFile);
						await DatabaseService.ImportPgnStreamAsync(db.Name, fsRead, fileName, progressReporter, token);
					}, token);
				}
				finally
				{
					try { if (File.Exists(tempFile)) File.Delete(tempFile); } catch { }
				}
			}

			_createPgnFinished = true;
			_currentDbName = db.Name;
			await LoadDatabasesAsync();
		}
		catch (OperationCanceledException)
		{
			_newDbPgnError = "Import was cancelled.";
		}
		catch (Exception ex)
		{
			_newDbPgnError = $"Import error: {ex.Message}";
		}
		finally
		{
			_isCreatingFromPgn = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void CancelCreateDbFromPgn()
	{
		_createPgnCts?.Cancel();
	}

	private async Task InstallMasterCollection(string catalogId)
	{
		_isInstallingMaster = true;
		_installStatus = "Initializing installation...";
		_installProgressPct = 0;
		StateHasChanged();

		var progress = new Progress<(int current, int total, string status)>(p =>
		{
			_installProgressPct = p.total > 0 ? (int)((double)p.current / p.total * 100) : p.current;
			_installStatus = p.status;
			InvokeAsync(StateHasChanged);
		});

		try
		{
			await Task.Run(() => DatabaseService.InstallMasterDatabaseAsync(catalogId, progress));
			await Task.Delay(300);
			_masterCatalog = await DatabaseService.GetMasterCatalogAsync();
			await LoadDatabasesAsync();
			_showNewDbModal = false;
		}
		catch (Exception ex)
		{
			_installStatus = $"Installation error: {ex.Message}";
		}
		finally
		{
			_isInstallingMaster = false;
			await InvokeAsync(StateHasChanged);
		}
	}

