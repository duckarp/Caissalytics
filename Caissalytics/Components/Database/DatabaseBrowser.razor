@namespace Caissalytics.Components.Database
@using Caissalytics.Data
@inject IDatabaseService DatabaseService
@inject IOnlineGameSyncService SyncService
@inject IUserProfileService ProfileService
@inject WorkspaceState Workspace
@implements IDisposable

<div class="db-browser-container">
	<!-- Left Sidebar: Databases List -->
	<div class="db-sidebar">
		<div class="db-sidebar-header">
			<div class="db-sidebar-title">
				<span>🗄️</span>
				<span>@Loc["Db_Databases"]</span>
			</div>
			<button class="btn-secondary" @onclick="() => _showNewDbModal = true">@Loc["Db_NewDb"]</button>
		</div>

		<div class="db-list-wrapper">
			@foreach (var db in _databases)
			{
				bool isSelected = string.Equals(db.Name, _currentDbName, StringComparison.OrdinalIgnoreCase);
				bool isOnlineDb = IsOnlineGamesDb(db.Name);
				<div class="db-card @(isSelected ? "db-card-active" : "")" @onclick="() => SelectDatabaseAsync(db.Name)">
					<div class="db-card-top">
						<span class="db-card-name">@db.Name</span>
						<div class="db-card-badges">
							@if (db.IsReference)
							{
								<span class="db-badge-reference" title="Designated reference database for opening analysis">@Loc["Db_Reference"]</span>
							}
							@if (db.IsActive)
							{
								<span class="db-badge-active">@Loc["Common_Active"]</span>
							}
						</div>
					</div>
					<div class="db-card-meta">
						<span>@Loc["Db_GamesCount", db.GameCount.ToString("N0")]</span>
						<span>•</span>
						<span>@db.FormattedSize</span>
					</div>
					<div class="db-card-actions">
						@if (!db.IsReference)
						{
							<button class="db-card-btn db-card-btn-ref" title="Set as primary reference database for opening analysis" @onclick:stopPropagation="true" @onclick="() => SetAsReferenceDb(db.Name)">@Loc["Db_SetRef"]</button>
						}
						@if (isOnlineDb)
						{
							<button class="db-card-btn db-card-btn-sync" title="Sync online games from Lichess &amp; Chess.com" @onclick:stopPropagation="true" @onclick="OpenOnlineSyncModal">@Loc["Db_Sync"]</button>
						}
						@if (_databases.Count > 1)
						{
							<button class="db-card-btn" title="Delete database" @onclick:stopPropagation="true" @onclick="() => PromptDeleteDatabase(db)">@Loc["Db_Delete"]</button>
						}
					</div>
				</div>
			}
		</div>

		<div class="db-sidebar-footer">
			<button class="btn-secondary btn-master-lib" @onclick="OpenMasterLibraryModal">@Loc["Db_MasterLib"]</button>
			@if (!IsOnlineGamesDb(_currentDbName))
			{
				<button class="btn-primary" @onclick="AddNewGame">@Loc["Db_AddNewGame"]</button>
				<button class="btn-secondary" @onclick="() => _showImportModal = true">@Loc["Db_ImportPgn"]</button>
			}
		</div>
	</div>

	<!-- Main Content: Games Filter & Table -->
	<div class="db-main-content">
		<div class="db-main-header">
			<div class="db-title-group">
				<h2 class="db-current-title">@_currentDbName</h2>
				@if (IsCurrentDbReference)
				{
					<span class="db-badge-reference" title="Primary Reference Database for opening analysis">@Loc["Db_ReferenceDb"]</span>
				}
				<span class="db-game-count-badge">@Loc["Db_GamesCount", _totalCount.ToString("N0")]</span>
			</div>

			<div class="db-header-actions">
				@if (!IsCurrentDbReference)
				{
					<button class="btn-secondary btn-header-ref" title="Designate this database as the Master Reference for opening analysis" @onclick="() => SetAsReferenceDb(_currentDbName)">@Loc["Db_SetAsReference"]</button>
				}
				<button class="btn-secondary btn-master-lib" @onclick="OpenMasterLibraryModal">@Loc["Db_MasterLib"]</button>
				@if (IsOnlineGamesDb(_currentDbName))
				{
					<button class="btn-secondary" @onclick="OpenOnlineSyncModal">@Loc["Db_SyncGames"]</button>
					<button class="btn-secondary btn-clean-foreign" title="Scan and purge scouted/foreign games not belonging to your online handles" @onclick="PromptCleanForeignGames">@Loc["Db_CleanForeign"]</button>
				}
				else
				{
					<button class="btn-primary" @onclick="AddNewGame">@Loc["Db_AddNewGame"]</button>
					<button class="btn-secondary" @onclick="() => _showImportModal = true">@Loc["Db_ImportPgn"]</button>
				}
			</div>
		</div>

		<!-- Filter Bar -->
		<div class="db-filter-bar">
			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Player"]</label>
				<input class="filter-input" placeholder="@Loc["Db_Filter_PlayerPlaceholder"]" @bind="_filter.Player" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Eco"]</label>
				<input class="filter-input filter-input-small" placeholder="B90" @bind="_filter.Eco" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_MinElo"]</label>
				<input class="filter-input filter-input-small" type="number" placeholder="2500" @bind="_filter.MinElo" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Result"]</label>
				<select class="filter-select" @bind="_filter.Result">
					<option value="all">@Loc["Db_Filter_All"]</option>
					<option value="1-0">@Loc["Db_Filter_WhiteWin"]</option>
					<option value="0-1">@Loc["Db_Filter_BlackWin"]</option>
					<option value="1/2-1/2">@Loc["Db_Filter_Draw"]</option>
				</select>
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Event"]</label>
				<input class="filter-input" placeholder="@Loc["Db_Filter_EventPlaceholder"]" @bind="_filter.Event" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-actions">
				<button class="btn-primary" @onclick="SearchAsync">@Loc["Db_Filter_Search"]</button>
				<button class="btn-secondary" @onclick="ResetFilterAsync">@Loc["Db_Filter_Reset"]</button>
			</div>
		</div>

		<!-- Games Grid Table -->
		<div class="db-grid-container">
			@if (_isLoading)
			{
				<div class="reference-empty-state">
					<span>@Loc["Db_LoadingGames"]</span>
				</div>
			}
			else if (_games.Count == 0)
			{
				<div class="reference-empty-state">
					<span class="empty-state-icon">♟️</span>
					<h4>@Loc["Db_NoGamesMatch"]</h4>
					<p>@Loc["Db_NoGamesMatchDesc"]</p>
				</div>
			}
			else
			{
				<table class="db-games-table">
					<thead>
						<tr>
							@if (ShowPlatformColumn)
							{
								<th class="col-platform" title="Source platform">@Loc["Db_Col_Site"]</th>
							}
							<th class="col-players">@Loc["Db_Col_White"]</th>
							<th class="col-elo">@Loc["Db_Col_Elo"]</th>
							<th class="col-players">@Loc["Db_Col_Black"]</th>
							<th class="col-elo">@Loc["Db_Col_Elo"]</th>
							<th class="col-result">@Loc["Db_Col_Result"]</th>
							<th class="col-eco">@Loc["Db_Col_Eco"]</th>
							<th class="col-date">@Loc["Db_Col_Date"]</th>
							<th class="col-event">@Loc["Db_Col_Event"]</th>
							<th class="col-moves">@Loc["Db_Col_Moves"]</th>
							<th class="col-actions"></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var game in _games)
						{
							<tr class="db-game-row @(IsUserGame(game) ? "db-game-row-user" : "")" @ondblclick="() => OpenGameInAnalysis(game)">
								@if (ShowPlatformColumn)
								{
									<td class="col-platform">
										<PlatformIcon Game="game" />
									</td>
								}
								<td class="col-players @(IsWhiteUser(game) ? "player-name-user" : "")">
									<span>@game.White</span>
									@if (IsWhiteUser(game))
									{
										<span class="db-user-tag" title="You (matches your profile)">@Loc["Db_You"]</span>
									}
								</td>
								<td class="col-elo">@(game.WhiteElo?.ToString() ?? "-")</td>
								<td class="col-players @(IsBlackUser(game) ? "player-name-user" : "")">
									<span>@game.Black</span>
									@if (IsBlackUser(game))
									{
										<span class="db-user-tag" title="You (matches your profile)">@Loc["Db_You"]</span>
									}
								</td>
								<td class="col-elo">@(game.BlackElo?.ToString() ?? "-")</td>
								<td class="col-result">
									<span class="ref-result-badge @GetResultClass(game.Result)">@game.Result</span>
								</td>
								<td class="col-eco">@game.Eco</td>
								<td class="col-date">@game.FormattedDate</td>
								<td class="col-event" title="@game.Event">@game.Event</td>
								<td class="col-moves">@game.PlyCount</td>
								<td class="col-actions">
									<div class="row-actions-group">
										<button class="btn-secondary-small" title="@Loc["Db_OpenGame"]" @onclick="() => OpenGameInAnalysis(game)">@Loc["Db_OpenGame"]</button>
										<button class="btn-danger-small" title="@Loc["Db_DeleteGame"]" @onclick="() => PromptDeleteGame(game)">🗑️</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<!-- Pagination Footer -->
		<div class="db-pagination-footer">
			<div class="pagination-info">
				@Loc["Db_ShowingGames", Math.Min((_filter.PageNumber - 1) * _filter.PageSize + 1, _totalCount), Math.Min(_filter.PageNumber * _filter.PageSize, _totalCount), _totalCount]
			</div>

			<div class="pagination-controls">
				<button class="btn-secondary" disabled="@(_filter.PageNumber <= 1)" @onclick="PreviousPageAsync">@Loc["Db_PrevPage"]</button>
				<span class="pagination-info">@Loc["Db_PageOf", _filter.PageNumber, TotalPages]</span>
				<button class="btn-secondary" disabled="@(_filter.PageNumber >= TotalPages)" @onclick="NextPageAsync">@Loc["Db_NextPage"]</button>
			</div>
		</div>
	</div>
</div>

<!-- New Database Modal -->
@if (_showNewDbModal)
{
	<div class="modal-backdrop" @onclick="() => _showNewDbModal = false">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_CreateDb_Title"]</h3>
				<button class="modal-close-btn" @onclick="() => _showNewDbModal = false">✕</button>
			</div>
			<div class="modal-body">
				<div class="modal-form-group">
					<label class="filter-label">@Loc["Db_CreateDb_Name"]</label>
					<input class="modal-input" placeholder="@Loc["Db_CreateDb_Placeholder"]" @bind="_newDbName" />
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="() => _showNewDbModal = false">@Loc["Common_Cancel"]</button>
				<button class="btn-primary" disabled="@string.IsNullOrWhiteSpace(_newDbName)" @onclick="CreateDatabaseAsync">@Loc["Db_CreateDb_Btn"]</button>
			</div>
		</div>
	</div>
}

<!-- PGN Import Modal -->
<PgnImportDialog IsOpen="_showImportModal"
				 DatabaseName="@_currentDbName"
				 OnClose="() => _showImportModal = false"
				 OnImportCompleted="HandleImportCompletedAsync" />

<!-- Clean Foreign Games Confirmation Modal -->
@if (_showCleanForeignModal)
{
	<div class="modal-backdrop" @onclick="() => _showCleanForeignModal = false">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_CleanForeign_Title", SyncService.OnlineGamesDatabaseName]</h3>
				<button class="modal-close-btn" @onclick="() => _showCleanForeignModal = false">✕</button>
			</div>
			<div class="modal-body">
				<p class="modal-desc">
					"My online games" is reserved for games synced from your online accounts (Lichess &amp; Chess.com).
				</p>
				@if (_isScanningForeign)
				{
					<div class="reference-empty-state">
						<span>@Loc["Db_CleanForeign_Scanning"]</span>
					</div>
				}
				else if (_foreignGamesCount == 0)
				{
					<div class="clean-foreign-empty-state">
						<span class="empty-state-icon">✅</span>
						<h4>@Loc["Db_CleanForeign_AllClean"]</h4>
						<p>@Loc["Db_CleanForeign_AllCleanDesc", SyncService.OnlineGamesDatabaseName]</p>
					</div>
				}
				else
				{
					<div class="modal-warning-box">
						<div class="modal-warning-title">@Loc["Db_CleanForeign_Detected"]</div>
						<div>@Loc["Db_CleanForeign_Found", _foreignGamesCount, _foreignGamesCount == 1 ? "game" : "games"]</div>
						<div class="clean-foreign-handles-list">
							@Loc["Db_CleanForeign_ActiveHandles"] <strong>@(GetActiveProfileHandlesString())</strong>
						</div>
						<div class="modal-irreversible-warning">
							@Loc["Db_CleanForeign_Irreversible"]
						</div>
					</div>
				}

				@if (!string.IsNullOrEmpty(_cleanStatus))
				{
					<div class="stat-pill-sub clean-status-msg">@_cleanStatus</div>
				}
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="() => _showCleanForeignModal = false">
					@(_cleanFinished ? Loc["Common_Close"] : Loc["Common_Cancel"])
				</button>
				@if (!_isScanningForeign && _foreignGamesCount > 0 && !_cleanFinished)
				{
					<button class="btn-danger" @onclick="ExecuteCleanForeignGamesAsync" disabled="@_isCleaningForeign">
						@(_isCleaningForeign ? "..." : Loc["Db_CleanForeign_PurgeBtn", _foreignGamesCount])
					</button>
				}
			</div>
		</div>
	</div>
}

<!-- Delete Game Confirmation Modal -->
@if (_showDeleteModal && _gameToDelete != null)
{
	<div class="modal-backdrop" @onclick="() => _showDeleteModal = false">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_DeleteConfirm_Title"]</h3>
				<button class="modal-close-btn" @onclick="() => _showDeleteModal = false">✕</button>
			</div>
			<div class="modal-body">
				<div class="modal-warning-box">
					<div class="modal-warning-title">@Loc["Db_DeleteConfirm_Warning"]</div>
					<div>@Loc["Db_DeleteConfirm_Question", _currentDbName]</div>
					<div class="modal-game-summary">
						<PlatformIcon Game="_gameToDelete" />
						<span>@_gameToDelete.White vs @_gameToDelete.Black (@_gameToDelete.FormattedDate) • @_gameToDelete.Result</span>
					</div>
					<div class="modal-irreversible-warning">
						@Loc["Db_DeleteConfirm_Irreversible"]
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="() => _showDeleteModal = false">@Loc["Common_Cancel"]</button>
				<button class="btn-danger" @onclick="ConfirmDeleteGameAsync">@Loc["Common_Delete"]</button>
			</div>
		</div>
	</div>
}

<!-- Delete Database Confirmation Modal -->
@if (_showDeleteDbModal && _dbToDelete != null)
{
	<div class="modal-backdrop" @onclick="CancelDeleteDatabase">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_DeleteConfirm_Title"]</h3>
				<button class="modal-close-btn" @onclick="CancelDeleteDatabase">✕</button>
			</div>
			<div class="modal-body">
				<div class="modal-warning-box">
					<div class="modal-warning-title">@Loc["Db_DeleteConfirm_Warning"]</div>
					<div>@Loc["Db_DeleteConfirm_Question", _dbToDelete.Name]</div>
					<div class="modal-game-summary">
						<span>🗄️ @_dbToDelete.Name • @_dbToDelete.GameCount.ToString("N0") games • @_dbToDelete.FormattedSize</span>
					</div>
					<div class="modal-irreversible-warning">
						@Loc["Db_DeleteConfirm_Irreversible"]
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="CancelDeleteDatabase">@Loc["Common_Cancel"]</button>
				<button class="btn-danger" @onclick="ConfirmDeleteDatabaseAsync">@Loc["Common_Delete"]</button>
			</div>
		</div>
	</div>
}

<!-- Master Reference Library Modal -->
@if (_showMasterLibModal)
{
	<div class="modal-backdrop" @onclick="CloseMasterLibraryModal">
		<div class="modal-dialog master-lib-modal" @onclick:stopPropagation="true">
			<div class="modal-header">
				<div class="master-lib-header-info">
					<span class="modal-icon">📚</span>
					<div>
						<h3 class="modal-title">Master Reference Library</h3>
						<p class="modal-subtitle">Curated Grandmaster collections to power your Opening Explorer and game study.</p>
					</div>
				</div>
				<button class="modal-close-btn" @onclick="CloseMasterLibraryModal" disabled="@_isInstallingMaster">✕</button>
			</div>
			<div class="modal-body master-lib-body">
				@if (_isInstallingMaster)
				{
					<div class="master-install-progress-card">
						<div class="master-install-spinner"></div>
						<div class="master-install-status-text">@_installStatus</div>
						<div class="install-progress-track">
							<div class="install-progress-bar @($"prog-w-{(int)Math.Round(_installProgressPct / 10.0) * 10}")"></div>
						</div>
						<span class="install-progress-pct">@_installProgressPct%</span>
					</div>
				}
				else
				{
					<div class="master-catalog-grid">
						@foreach (var item in _masterCatalog)
						{
							<div class="master-card @(item.IsInstalled ? "master-card-installed" : "")">
								<div class="master-card-top-row">
									<span class="master-tag master-tag-@item.Tag.ToLowerInvariant()">@item.Tag</span>
									<span class="master-era">@item.Era</span>
								</div>
								<h4 class="master-card-title">@item.Title</h4>
								<p class="master-card-desc">@item.Description</p>
								<div class="master-card-footer">
									<span class="master-games-count">@item.EstimatedGameCount.ToString("N0") games</span>
									@if (item.IsInstalled)
									{
										<div class="master-installed-actions">
											<span class="master-installed-badge">✓ Installed</span>
											@if (!string.Equals(item.DatabaseName, _referenceDbName, StringComparison.OrdinalIgnoreCase))
											{
												<button class="btn-xs-reference" title="Designate as primary reference database" @onclick="() => SetAsReferenceDb(item.DatabaseName)">Set as Ref</button>
											}
										</div>
									}
									else
									{
										<button class="btn-install-master" @onclick="() => InstallMasterCollection(item.Id)">Install Collection</button>
									}
								</div>
							</div>
						}
					</div>

					<div class="master-external-tip">
						<span class="tip-icon">💡</span>
						<div class="tip-content">
							<span class="tip-title">Community Mega-Databases:</span>
							<span>Looking for millions of games? Download <strong>Lumbra's GigaBase</strong> (e.g. <em>OTB Elite 2400+</em>) or weekly <strong>TWIC</strong> updates and drag &amp; drop the <code>.7z</code> or <code>.zip</code> file directly into <strong>Import Games</strong>.</span>
						</div>
					</div>
				}
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="CloseMasterLibraryModal" disabled="@_isInstallingMaster">Close</button>
			</div>
		</div>
	</div>
}

<!-- Online Games Sync Dialog -->
<OnlineGamesSyncDialog IsOpen="_showOnlineSyncModal"
					   OnClose="HandleSyncDialogClosed"
					   OnDatabaseSelected="HandleSyncDbSelectedAsync" />

@code {
	[Parameter] public DatabaseBrowserTab? Tab { get; set; }

	private List<DatabaseInfo> _databases = new();
	private string _currentDbName = "";
	private string _referenceDbName = "ClassicalMasters";
	private List<GameHeader> _games = new();
	private int _totalCount = 0;
	private bool _isLoading = false;
	private GameFilter _filter = new() { PageSize = 50 };

	private bool _showNewDbModal = false;
	private string _newDbName = "";
	private bool _showImportModal = false;
	private bool _showDeleteModal = false;
	private GameHeader? _gameToDelete;

	private bool _showDeleteDbModal = false;
	private DatabaseInfo? _dbToDelete;
	private bool _showOnlineSyncModal = false;
	private bool _showCleanForeignModal = false;
	private bool _isScanningForeign = false;
	private bool _isCleaningForeign = false;
	private bool _cleanFinished = false;
	private int _foreignGamesCount = 0;
	private string _cleanStatus = "";
	private UserProfile _userProfile = new();

	private bool _showMasterLibModal = false;
	private bool _isInstallingMaster = false;
	private string _installStatus = "";
	private int _installProgressPct = 0;
	private List<MasterCatalogItem> _masterCatalog = new();

	private bool IsCurrentDbReference => string.Equals(_currentDbName, _referenceDbName, StringComparison.OrdinalIgnoreCase);

	private bool IsOnlineGamesDb(string? name) =>
		string.Equals(name, SyncService.OnlineGamesDatabaseName, StringComparison.OrdinalIgnoreCase);

	private bool ShowPlatformColumn =>
		IsOnlineGamesDb(_currentDbName) ||
		_games.Any(g => !string.IsNullOrEmpty(g.Platform));

	private bool IsWhiteUser(GameHeader game) => _userProfile.MatchesPlayer(game.White);
	private bool IsBlackUser(GameHeader game) => _userProfile.MatchesPlayer(game.Black);
	private bool IsUserGame(GameHeader game) => IsWhiteUser(game) || IsBlackUser(game);

	private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_filter.PageSize));

	protected override async Task OnInitializedAsync()
	{
		DatabaseService.OnActiveDatabaseChanged += HandleActiveDatabaseChanged;
		DatabaseService.OnReferenceDatabaseChanged += HandleReferenceDatabaseChanged;
		DatabaseService.OnDatabaseModified += HandleDatabaseModified;
		ProfileService.OnProfileChanged += HandleProfileChanged;
		Loc.OnLanguageChanged += StateHasChanged;
		await LoadProfileAsync();

		if (Tab != null && !string.IsNullOrWhiteSpace(Tab.TargetDatabase))
		{
			_currentDbName = Tab.TargetDatabase;
			Tab.TargetDatabase = null;
		}

		await LoadDatabasesAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		if (Tab != null && !string.IsNullOrWhiteSpace(Tab.TargetDatabase))
		{
			string target = Tab.TargetDatabase;
			Tab.TargetDatabase = null;
			await SelectDatabaseAsync(target);
		}
	}

	private async Task LoadProfileAsync()
	{
		_userProfile = await ProfileService.GetProfileAsync();
	}

	private async void HandleProfileChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadProfileAsync();
			StateHasChanged();
		});
	}

	private async Task LoadDatabasesAsync()
	{
		_databases = await DatabaseService.GetDatabasesAsync();
		_referenceDbName = await DatabaseService.GetReferenceDatabaseAsync();
		if (!_databases.Any(d => string.Equals(d.Name, _currentDbName, StringComparison.OrdinalIgnoreCase)))
		{
			var active = _databases.FirstOrDefault(d => d.IsActive) ?? _databases.FirstOrDefault();
			if (active != null)
			{
				_currentDbName = active.Name;
			}
		}
		await LoadGamesAsync();
	}

	private async Task SetAsReferenceDb(string dbName)
	{
		await DatabaseService.SetReferenceDatabaseAsync(dbName);
		_referenceDbName = dbName;
		await LoadDatabasesAsync();
	}

	private async Task OpenMasterLibraryModal()
	{
		_showMasterLibModal = true;
		_isInstallingMaster = false;
		_masterCatalog = await DatabaseService.GetMasterCatalogAsync();
	}

	private void CloseMasterLibraryModal()
	{
		if (!_isInstallingMaster)
		{
			_showMasterLibModal = false;
		}
	}

	private async Task InstallMasterCollection(string catalogId)
	{
		_isInstallingMaster = true;
		_installStatus = "Initializing installation...";
		_installProgressPct = 0;
		StateHasChanged();

		var progress = new Progress<(int current, int total, string status)>(p =>
		{
			_installProgressPct = p.total > 0 ? (int)((double)p.current / p.total * 100) : p.current;
			_installStatus = p.status;
			InvokeAsync(StateHasChanged);
		});

		try
		{
			await Task.Run(() => DatabaseService.InstallMasterDatabaseAsync(catalogId, progress));
			await Task.Delay(300);
			_masterCatalog = await DatabaseService.GetMasterCatalogAsync();
			await LoadDatabasesAsync();
			_showMasterLibModal = false;
		}
		catch (Exception ex)
		{
			_installStatus = $"Installation error: {ex.Message}";
		}
		finally
		{
			_isInstallingMaster = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private async void HandleReferenceDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			_referenceDbName = await DatabaseService.GetReferenceDatabaseAsync();
			_databases = await DatabaseService.GetDatabasesAsync();
			StateHasChanged();
		});
	}

	private async Task SelectDatabaseAsync(string dbName)
	{
		_currentDbName = dbName;
		await DatabaseService.SetActiveDatabaseAsync(dbName);
		_filter.PageNumber = 1;
		await LoadGamesAsync();
	}

	private async Task LoadGamesAsync()
	{
		_isLoading = true;
		StateHasChanged();

		try
		{
			var (games, count) = await DatabaseService.SearchGamesAsync(_currentDbName, _filter);
			_games = games;
			_totalCount = count;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[DatabaseBrowser] Error searching games: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task SearchAsync()
	{
		_filter.PageNumber = 1;
		await LoadGamesAsync();
	}

	private async Task ResetFilterAsync()
	{
		_filter = new GameFilter { PageSize = 50 };
		await LoadGamesAsync();
	}

	private async Task HandleFilterKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			await SearchAsync();
		}
	}

	private async Task PreviousPageAsync()
	{
		if (_filter.PageNumber > 1)
		{
			_filter.PageNumber--;
			await LoadGamesAsync();
		}
	}

	private async Task NextPageAsync()
	{
		if (_filter.PageNumber < TotalPages)
		{
			_filter.PageNumber++;
			await LoadGamesAsync();
		}
	}

	private async Task CreateDatabaseAsync()
	{
		if (string.IsNullOrWhiteSpace(_newDbName)) return;

		string name = _newDbName.Trim();
		_showNewDbModal = false;
		_newDbName = "";

		var db = await DatabaseService.CreateDatabaseAsync(name);
		_currentDbName = db.Name;
		await LoadDatabasesAsync();
	}

	private void OpenOnlineSyncModal()
	{
		_showOnlineSyncModal = true;
	}

	private async Task HandleSyncDialogClosed()
	{
		_showOnlineSyncModal = false;
		await LoadDatabasesAsync();
	}

	private async Task HandleSyncDbSelectedAsync(string dbName)
	{
		_showOnlineSyncModal = false;
		await LoadDatabasesAsync();
		await SelectDatabaseAsync(dbName);
