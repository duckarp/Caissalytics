	private static string GetResultClass(string result)
	{
		return result switch
		{
			"1-0" => "ref-result-white",
			"0-1" => "ref-result-black",
			"1/2-1/2" => "ref-result-draw",
			_ => ""
		};
	}

	private string GetActiveProfileHandlesString()
	{
		var handles = new List<string>();
		if (!string.IsNullOrWhiteSpace(_userProfile.LichessUsername)) handles.Add($"Lichess: {_userProfile.LichessUsername}");
		if (!string.IsNullOrWhiteSpace(_userProfile.ChessComUsername)) handles.Add($"Chess.com: {_userProfile.ChessComUsername}");
		if (!string.IsNullOrWhiteSpace(_userProfile.FullName)) handles.Add(_userProfile.FullName);
		if (!string.IsNullOrWhiteSpace(_userProfile.FideId)) handles.Add($"FIDE: {_userProfile.FideId}");
		return handles.Count > 0 ? string.Join(", ", handles) : "No online handles configured";
	}

	private async Task PromptCleanForeignGames()
	{
		_showCleanForeignModal = true;
		_isScanningForeign = true;
		_isCleaningForeign = false;
		_cleanFinished = false;
		_cleanStatus = "";
		_foreignGamesCount = 0;
		StateHasChanged();

		try
		{
			var allHeaders = await DatabaseService.GetAllGameHeadersAsync(SyncService.OnlineGamesDatabaseName);
			_foreignGamesCount = allHeaders.Count(g =>
			{
				bool isUserGame = _userProfile.MatchesPlayer(g.White) || _userProfile.MatchesPlayer(g.Black);
				bool isOnlinePlatform = g.Platform == "lichess" || g.Platform == "chesscom";
				return !isUserGame || !isOnlinePlatform;
			});
		}
		catch (Exception ex)
		{
			_cleanStatus = $"Scan error: {ex.Message}";
			_foreignGamesCount = 0;
		}
		finally
		{
			_isScanningForeign = false;
			StateHasChanged();
		}
	}

	private async Task ExecuteCleanForeignGamesAsync()
	{
		_isCleaningForeign = true;
		_cleanStatus = "Purging foreign and scouted games...";
		StateHasChanged();

		try
		{
			int purged = await SyncService.PurgeNonSyncedGamesAsync(_userProfile);
			_cleanFinished = true;
			_cleanStatus = $"Successfully purged {purged} foreign games from '{SyncService.OnlineGamesDatabaseName}'!";
			_foreignGamesCount = 0;
			await LoadDatabasesAsync();
			await LoadGamesAsync();
		}
		catch (Exception ex)
		{
			_cleanStatus = $"Purge error: {ex.Message}";
		}
		finally
		{
			_isCleaningForeign = false;
			StateHasChanged();
		}
	}

	public void Dispose()
	{
		DatabaseService.OnActiveDatabaseChanged -= HandleActiveDatabaseChanged;
		DatabaseService.OnReferenceDatabaseChanged -= HandleReferenceDatabaseChanged;
		DatabaseService.OnDatabaseModified -= HandleDatabaseModified;
		ProfileService.OnProfileChanged -= HandleProfileChanged;
		Loc.OnLanguageChanged -= StateHasChanged;
	}
}
