				_dotNetRef ??= DotNetObjectReference.Create(this);
				_dropModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDropInterop.js");
				_browserDropInstance = await _dropModule.InvokeAsync<IJSObjectReference>(
					"registerWorkbenchDrop",
					_dbBrowserRef,
					_dotNetRef,
					nameof(OnBrowserFileDropped),
					new[] { ".pgn", ".zip", ".7z" },
					new { mode = "stream" }
				);
			}
			catch { }
		}

		if (_showNewDbModal && _newDbMode == NewDbMode.PgnImport && _newDbPgnSource == PgnSource.File)
		{
			if (_newDbDropInstance == null)
			{
				try
				{
					_dotNetRef ??= DotNetObjectReference.Create(this);
					_dropModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDropInterop.js");
					_newDbDropInstance = await _dropModule.InvokeAsync<IJSObjectReference>(
						"registerDropZone",
