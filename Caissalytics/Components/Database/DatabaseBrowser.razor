<!-- Delete Folder Confirmation Modal -->
@if (_showDeleteFolderModal && _folderToDelete != null)
{
	<div class="modal-backdrop" @onclick="CancelDeleteFolder">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">🗑️ @Loc["Db_DeleteFolderConfirm_Title"]</h3>
				<button class="modal-close-btn" @onclick="CancelDeleteFolder">✕</button>
			</div>
			<div class="modal-body">
				<div class="modal-warning-box">
					<div class="modal-warning-title">@Loc["Db_DeleteFolderConfirm_Warning"]</div>
					<div class="modal-game-summary">
						<span>📁 @_folderToDelete.Name (@_folderToDelete.Path)</span>
					</div>
					<div>
						@Loc["Db_DeleteFolderConfirm_Question", _folderToDelete.Name, GetTargetFolderName(_folderToDelete.ParentId)]
					</div>
					@if (_folderToDelete.TotalGameCount > 0 || _folderToDelete.SubfolderCount > 0)
					{
