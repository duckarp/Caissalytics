	private void HandleDragOverFolder(long? targetFolderId)
	{
		if (!_draggedGameId.HasValue && !_draggedFolderId.HasValue)
		{
			_folderDropTargetId = null;
			return;
		}

		if (_draggedFolderId.HasValue && targetFolderId.HasValue &&
			IsDescendantOrSelfFolder(targetFolderId.Value, _draggedFolderId.Value))
		{
			_folderDropTargetId = null;
			return;
		}

		_folderDropTargetId = targetFolderId ?? -1;
	}

	private async Task HandleDropOnFolderAsync(long? targetFolderId)
	{
		long? draggedGame = _draggedGameId;
		long? draggedFolder = _draggedFolderId;
		HandleRowDragEnd();

		if (draggedGame.HasValue)
		{
			if (_selectedGameIds.Contains(draggedGame.Value) && _selectedGameIds.Count > 1)
			{
				_bulkMoveGameIds = _selectedGameIds.ToList();
				_bulkMoveTargetDb = _currentDbName;
				_bulkMoveTargetFolderId = targetFolderId;
				_bulkMoveError = "";
				_isBulkMoving = false;
				await LoadBulkMoveTargetFoldersAsync(_bulkMoveTargetDb);
				_showBulkMoveModal = true;
			}
			else
			{
				var game = _games.FirstOrDefault(g => g.Id == draggedGame.Value)
					?? await DatabaseService.GetGameByIdAsync(_currentDbName, draggedGame.Value);
				if (game != null && game.FolderId != targetFolderId)
				{
					PromptMoveGame(game, targetFolderId);
				}
			}
		}
		else if (draggedFolder.HasValue)
		{
			var folder = _folders.FirstOrDefault(f => f.Id == draggedFolder.Value);
			if (folder != null && folder.ParentId != targetFolderId)
			{
				if (!targetFolderId.HasValue || !IsDescendantOrSelfFolder(targetFolderId.Value, draggedFolder.Value))
				{
					PromptMoveFolder(folder, targetFolderId);
				}
			}
		}
	}

