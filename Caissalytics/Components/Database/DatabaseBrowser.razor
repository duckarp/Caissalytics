	private List<GameFolder> GetChildFolders(long? parentId)
	{
		return _folders
			.Where(f => f.ParentId == parentId)
			.OrderBy(f => f.SortOrder)
			.ThenBy(f => f.Name, StringComparer.OrdinalIgnoreCase)
			.ToList();
	}

	private List<GameFolder> GetCurrentFolderBreadcrumbs()
	{
		var crumbs = new List<GameFolder>();
		if (!_currentFolderId.HasValue) return crumbs;

		var map = _folders.ToDictionary(f => f.Id);
		var visited = new HashSet<long>();
		long? cursor = _currentFolderId;
		while (cursor.HasValue && visited.Add(cursor.Value) && map.TryGetValue(cursor.Value, out var folder))
		{
			crumbs.Add(folder);
			cursor = folder.ParentId;
		}
		crumbs.Reverse();
		return crumbs;
	}

	private string GetFolderPath(long folderId)
	{
		return _folders.FirstOrDefault(f => f.Id == folderId)?.Path ?? "";
	}

	private bool IsDescendantOrSelfFolder(long candidateFolderId, long ancestorFolderId)
	{
		var map = _folders.ToDictionary(f => f.Id);
		var visited = new HashSet<long>();
		long? cursor = candidateFolderId;
		while (cursor.HasValue && visited.Add(cursor.Value))
		{
			if (cursor.Value == ancestorFolderId) return true;
			cursor = map.TryGetValue(cursor.Value, out var folder) ? folder.ParentId : null;
		}
		return false;
	}

	private List<(long Id, string Label)> GetFlattenedFolderOptions(long? excludeFolderAndDescendantsId = null)
	{
		var result = new List<(long Id, string Label)>();
		void Traverse(long? parentId)
		{
			foreach (var folder in GetChildFolders(parentId))
			{
				if (excludeFolderAndDescendantsId.HasValue &&
					IsDescendantOrSelfFolder(folder.Id, excludeFolderAndDescendantsId.Value))
				{
					continue;
				}
				result.Add((folder.Id, $"📁 {folder.Path}"));
				Traverse(folder.Id);
			}
		}
		Traverse(null);
		return result;
	}

