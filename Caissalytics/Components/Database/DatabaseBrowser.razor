<!-- Export PGN Modal -->
@if (_showExportModal)
{
	<div class="modal-backdrop" @onclick="CloseExportModal">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_Export_Title", _currentDbName]</h3>
				<button class="modal-close-btn" @onclick="CloseExportModal">✕</button>
			</div>
			<div class="modal-body">
				<p class="modal-desc">@Loc["Db_Export_Desc"]</p>

				<div class="save-mode-container">
					<span class="save-mode-title">@Loc["Db_Export_Scope"]</span>
					<div class="save-mode-options">
						<label class="save-mode-label">
							<input type="radio" name="exportScope" value="all" checked="@(_exportScope == "all")" @onchange='() => _exportScope = "all"' />
							<div class="save-mode-text-col">
								<strong>@Loc["Db_Export_All"]</strong>
								<span class="save-mode-desc">@Loc["Db_Export_AllDesc", _exportAllCount]</span>
							</div>
						</label>

						<label class="save-mode-label">
							<input type="radio" name="exportScope" value="filtered" checked="@(_exportScope == "filtered")" @onchange='() => _exportScope = "filtered"' />
							<div class="save-mode-text-col">
								<strong>@Loc["Db_Export_Filtered"]</strong>
								<span class="save-mode-desc">@Loc["Db_Export_FilteredDesc", _exportFilteredCount]</span>
							</div>
						</label>
					</div>
				</div>

				<div class="modal-form-group">
					<label class="filter-label">@Loc["Db_Export_Filename"]</label>
					<input class="modal-input" @bind="_exportFilename" @bind:event="oninput" />
				</div>

				@if (_isExporting)
				{
					<div class="reference-empty-state">
						<span>@Loc["Db_Export_Running"]</span>
					</div>
					@if (_exportTotal > 0)
					{
						<div class="stat-pill-sub clean-status-msg">@Loc["Db_Export_Progress", _exportCurrent, _exportTotal]</div>
					}
				}
				else if (_exportFinished)
				{
					<div class="clean-foreign-empty-state">
						<span class="empty-state-icon">✅</span>
						<h4>@Loc["Db_Export_Done"]</h4>
						<p>@Loc["Db_Export_DoneDesc", _exportedCount, _exportSavedPath]</p>
					</div>
				}

				@if (!string.IsNullOrEmpty(_exportStatus))
				{
					<div class="stat-pill-sub clean-status-msg">@_exportStatus</div>
				}
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="CloseExportModal">
					@(_exportFinished ? Loc["Common_Close"] : Loc["Common_Cancel"])
				</button>
				@if (!_isExporting && !_exportFinished)
				{
					<button class="btn-primary" disabled="@(_exportSelectedCount == 0)" @onclick="ExecuteExportAsync">@Loc["Db_Export_DownloadBtn"]</button>
				}
			</div>
		</div>
	</div>
}

