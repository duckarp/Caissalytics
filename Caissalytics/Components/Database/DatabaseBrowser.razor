@namespace Caissalytics.Components.Database
@using Caissalytics.Data
@using Caissalytics.Components.Board
@using Microsoft.JSInterop
@inject IDatabaseService DatabaseService
@inject IOnlineGameSyncService SyncService
@inject IUserProfileService ProfileService
@inject WorkspaceState Workspace
@inject IJSRuntime JS
@inject IAppWindowProvider WindowProvider
@implements IDisposable

<div class="db-browser-container" @ref="_dbBrowserRef">
	<div class="workbench-drag-drop-overlay">
		<div class="drop-overlay-icon">📥</div>
		<div class="drop-overlay-title">@Loc["Db_DropImport_Title"]</div>
		<div class="drop-overlay-subtitle">@Loc["Db_DropImport_Subtitle"]</div>
	</div>
	<!-- Left Sidebar: Databases List -->
	<div class="db-sidebar">
		<div class="db-sidebar-header">
			<div class="db-sidebar-title">
				<span>🗄️</span>
				<span>@Loc["Db_Databases"]</span>
			</div>
			<button class="btn-secondary" @onclick="() => OpenNewDbModal(NewDbMode.Create)">@Loc["Db_NewDb"]</button>
		</div>

		<div class="db-list-wrapper">
			@foreach (var db in _databases)
			{
				bool isSelected = string.Equals(db.Name, _currentDbName, StringComparison.OrdinalIgnoreCase);
				bool isOnlineDb = IsOnlineGamesDb(db.Name);
				<div class="db-card @(isSelected ? "db-card-active" : "")" @onclick="() => SelectDatabaseAsync(db.Name)">
					<div class="db-card-top">
						<span class="db-card-name">@db.Name</span>
						<div class="db-card-badges">
							@if (db.IsReference)
							{
								<span class="db-badge-reference" title="Designated reference database for opening analysis">@Loc["Db_Reference"]</span>
							}
							@if (db.IsActive)
							{
								<span class="db-badge-active">@Loc["Common_Active"]</span>
							}
						</div>
					</div>
					<div class="db-card-meta">
						<span>@Loc["Db_GamesCount", db.GameCount.ToString("N0")]</span>
						<span>•</span>
						<span>@db.FormattedSize</span>
					</div>
					<div class="db-card-actions">
						@if (!db.IsReference)
						{
							<button class="db-card-btn db-card-btn-ref" title="Set as primary reference database for opening analysis" @onclick:stopPropagation="true" @onclick="() => SetAsReferenceDb(db.Name)">@Loc["Db_SetRef"]</button>
						}
						@if (isOnlineDb)
						{
							<button class="db-card-btn db-card-btn-sync" title="Sync online games from Lichess &amp; Chess.com" @onclick:stopPropagation="true" @onclick="OpenOnlineSyncModal">@Loc["Db_Sync"]</button>
						}
						@if (_databases.Count > 1)
						{
							<button class="db-card-btn" title="Delete database" @onclick:stopPropagation="true" @onclick="() => PromptDeleteDatabase(db)">@Loc["Db_Delete"]</button>
						}
					</div>
				</div>
			}
		</div>

		<div class="db-sidebar-footer">
			@if (!IsOnlineGamesDb(_currentDbName))
			{
				<button class="btn-primary" @onclick="AddNewGame">@Loc["Db_AddNewGame"]</button>
				<button class="btn-secondary" @onclick="() => _showImportModal = true">@Loc["Db_ImportPgn"]</button>
			}
		</div>
	</div>

	<!-- Main Content: Games Filter & Table -->
	<div class="db-main-content">
		<div class="db-main-header">
			<div class="db-title-group">
				<h2 class="db-current-title">@_currentDbName</h2>
				@if (IsCurrentDbReference)
				{
					<span class="db-badge-reference" title="Primary Reference Database for opening analysis">@Loc["Db_ReferenceDb"]</span>
				}
				<span class="db-game-count-badge">@Loc["Db_GamesCount", _totalCount.ToString("N0")]</span>
			</div>

			<div class="db-header-actions">
				@if (!IsCurrentDbReference)
				{
					<button class="btn-secondary btn-header-ref" title="Designate this database as the Master Reference for opening analysis" @onclick="() => SetAsReferenceDb(_currentDbName)">@Loc["Db_SetAsReference"]</button>
				}

				<div class="db-maintenance-container">
					<button type="button" class="btn-secondary db-maintenance-btn @(_showMaintenanceMenu ? "active" : "")" title="Database maintenance actions" @onclick="ToggleMaintenanceMenu">
						<span>@Loc["Db_Maintenance"]</span>
						<span class="dropdown-caret">▾</span>
					</button>
					@if (_showMaintenanceMenu)
					{
						<div class="maintenance-dropdown-backdrop" @onclick="CloseMaintenanceMenu"></div>
						<div class="maintenance-dropdown-menu">
							<button type="button" class="maintenance-menu-item" @onclick="HandleMaintenanceFillEco">
								<span>@Loc["Db_FillEco"]</span>
							</button>
							@if (IsOnlineGamesDb(_currentDbName))
							{
								<button type="button" class="maintenance-menu-item" @onclick="HandleMaintenanceCleanForeign">
									<span>@Loc["Db_CleanForeign"]</span>
								</button>
							}
						</div>
					}
				</div>

				<button class="btn-secondary btn-export-pgn" title="Export games from this database to a PGN file" @onclick="OpenExportModal">@Loc["Db_ExportPgn"]</button>

				@if (IsOnlineGamesDb(_currentDbName))
				{
					<button class="btn-primary" @onclick="OpenOnlineSyncModal">@Loc["Db_SyncGames"]</button>
				}
				else
				{
					<button class="btn-secondary" @onclick="() => _showImportModal = true">@Loc["Db_ImportPgn"]</button>
					<button class="btn-primary" @onclick="AddNewGame">@Loc["Db_AddNewGame"]</button>
				}
			</div>
		</div>

		<!-- Filter Bar -->
		<div class="db-filter-bar">
			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Player"]</label>
				<input class="filter-input" placeholder="@Loc["Db_Filter_PlayerPlaceholder"]" @bind="_filter.Player" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Eco"]</label>
				<input class="filter-input filter-input-small" placeholder="B90" @bind="_filter.Eco" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Opening"]</label>
				<input class="filter-input" list="opening-filter-names" placeholder="@Loc["Db_Filter_OpeningPlaceholder"]" @bind="_filter.Opening" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
				<datalist id="opening-filter-names">
					@foreach (var openingName in _openingNames)
					{
						<option value="@openingName"></option>
					}
				</datalist>
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_MinElo"]</label>
				<input class="filter-input filter-input-small" type="number" placeholder="2500" @bind="_filter.MinElo" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Result"]</label>
				<select class="filter-select" @bind="_filter.Result">
					<option value="all">@Loc["Db_Filter_All"]</option>
					<option value="1-0">@Loc["Db_Filter_WhiteWin"]</option>
					<option value="0-1">@Loc["Db_Filter_BlackWin"]</option>
					<option value="1/2-1/2">@Loc["Db_Filter_Draw"]</option>
				</select>
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Time"]</label>
				<select class="filter-select" @bind="_filter.TimeClass">
					<option value="all">@Loc["Db_Filter_All"]</option>
					<option value="bullet">@Loc["Db_Time_Bullet"]</option>
					<option value="blitz">@Loc["Db_Time_Blitz"]</option>
					<option value="rapid">@Loc["Db_Time_Rapid"]</option>
					<option value="standard">@Loc["Db_Time_Standard"]</option>
				</select>
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Event"]</label>
				<input class="filter-input" placeholder="@Loc["Db_Filter_EventPlaceholder"]" @bind="_filter.Event" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-group">
				<label class="filter-label">@Loc["Db_Filter_Note"]</label>
				<input class="filter-input" placeholder="@Loc["Db_Filter_NotePlaceholder"]" @bind="_filter.Note" @bind:event="oninput" @onkeydown="HandleFilterKeyDown" />
			</div>

			<div class="filter-actions">
				<button class="btn-primary" @onclick="SearchAsync">@Loc["Db_Filter_Search"]</button>
				<button class="btn-secondary" @onclick="ResetFilterAsync">@Loc["Db_Filter_Reset"]</button>
				<button type="button" class="btn-secondary btn-position-filter @(_filter.PositionZobristKey.HasValue ? "active" : "")" title="@Loc["Db_Filter_ModalTitle"]" @onclick="OpenPositionFilterModal">
					<span>@Loc["Db_Filter_Position"]</span>
					@if (_filter.PositionZobristKey.HasValue)
					{
						<span class="position-filter-dot">●</span>
					}
				</button>
			</div>
		</div>

		@if (_filter.PositionZobristKey.HasValue)
		{
			<div class="db-active-position-bar">
				<div class="active-position-pill">
					<span class="pill-icon">♟️</span>
					<span class="pill-label">@Loc["Db_Filter_PositionActive"]:</span>
					<span class="pill-fen" title="@_filter.PositionFen">@GetShortFen(_filter.PositionFen)</span>
					<button type="button" class="pill-btn pill-btn-edit" title="Edit Position" @onclick="OpenPositionFilterModal">✏️</button>
					<button type="button" class="pill-btn pill-btn-clear" title="@Loc["Db_Filter_ClearPosition"]" @onclick="ClearPositionFilterAsync">✕</button>
				</div>
			</div>
		}

		<!-- Per-Database Folder Navigation & Action Bar -->
		<div class="db-folder-bar">
			<div class="db-folder-breadcrumbs">
				<button type="button"
						class="db-breadcrumb-item @(!_currentFolderId.HasValue && !_showAllGamesFlat ? "active" : "") @(_folderDropTargetId == -1 ? "drop-active" : "")"
						@ondragover:preventDefault="true"
						@ondragover="() => HandleDragOverFolder(null)"
						@ondrop="() => HandleDropOnFolderAsync(null)"
						@onclick="() => NavigateToFolderAsync(null)">
					<span>🗄️ @_currentDbName</span>
				</button>

				@if (!_showAllGamesFlat && _currentFolderId.HasValue)
				{
					@foreach (var crumb in GetCurrentFolderBreadcrumbs())
					{
						<span class="db-breadcrumb-sep">/</span>
						<button type="button"
								class="db-breadcrumb-item @(crumb.Id == _currentFolderId ? "active" : "") @(_folderDropTargetId == crumb.Id ? "drop-active" : "")"
								@ondragover:preventDefault="true"
								@ondragover="() => HandleDragOverFolder(crumb.Id)"
								@ondrop="() => HandleDropOnFolderAsync(crumb.Id)"
								@onclick="() => NavigateToFolderAsync(crumb.Id)">
							<span>📁 @crumb.Name</span>
						</button>
					}
				}
			</div>

			<div class="db-folder-bar-actions">
				@if (_folders.Count > 0)
				{
					<div class="db-folder-view-toggle">
						<button type="button"
								class="db-view-toggle-btn @(!_showAllGamesFlat ? "active" : "")"
								@onclick="() => SetFolderViewModeAsync(false)">
							📁 @Loc["Db_FoldersView"]
						</button>
						<button type="button"
								class="db-view-toggle-btn @(_showAllGamesFlat ? "active" : "")"
								@onclick="() => SetFolderViewModeAsync(true)">
							📋 @Loc["Db_AllGamesView"]
						</button>
					</div>
				}

				<button type="button"
						class="btn-secondary btn-new-folder"
						title="@Loc["Db_NewFolder"]"
						@onclick="() => StartCreatingFolder(_currentFolderId)">
					@Loc["Db_NewFolder"]
				</button>
			</div>
		</div>

		<!-- Folders & Games Grid Container -->
		<div class="db-grid-container">
			@if (!_showAllGamesFlat && (_creatingFolder || _currentFolderId.HasValue || GetChildFolders(_currentFolderId).Count > 0))
			{
				<div class="db-folders-section">
					@if (_creatingFolder && _creatingFolderParentId == _currentFolderId)
					{
						<div class="db-folder-inline-editor">
							<span class="db-folder-row-icon">📁</span>
							<input class="db-folder-inline-input"
								   placeholder="@Loc["Db_FolderPlaceholder"]"
								   @bind="_newFolderName"
								   @bind:event="oninput"
								   @onkeydown="HandleNewFolderKeyDownAsync" />
							<button type="button" class="db-folder-inline-btn db-folder-inline-confirm" title="@Loc["Common_Save"]" @onclick="CommitCreateFolderAsync">✓</button>
							<button type="button" class="db-folder-inline-btn" title="@Loc["Common_Cancel"]" @onclick="CancelCreateFolder">✕</button>
						</div>
					}

					@if (_currentFolderId.HasValue)
					{
						long? parentId = CurrentFolder?.ParentId;
						long parentDropKey = parentId ?? -1;
						<div class="db-folder-row db-folder-row-parent @(_folderDropTargetId == parentDropKey ? "drop-active" : "")"
							 @ondragover:preventDefault="true"
							 @ondragover="() => HandleDragOverFolder(parentId)"
							 @ondrop="() => HandleDropOnFolderAsync(parentId)"
							 @onclick="() => NavigateToFolderAsync(parentId)">
							<div class="db-folder-row-main">
								<span class="db-folder-row-icon">↩️</span>
								<span class="db-folder-row-name">@Loc["Db_ParentFolder"]</span>
							</div>
						</div>
					}

					@foreach (var folder in GetChildFolders(_currentFolderId))
					{
						@RenderFolderNode(folder, 0)
					}
				</div>
			}

			@if (_isLoading)
			{
				<div class="reference-empty-state">
					<span>@Loc["Db_LoadingGames"]</span>
				</div>
			}
			else if (_games.Count == 0)
			{
				@if (_showAllGamesFlat || (!_currentFolderId.HasValue && GetChildFolders(null).Count == 0))
				{
					<div class="reference-empty-state">
						<span class="empty-state-icon">♟️</span>
						<h4>@Loc["Db_NoGamesMatch"]</h4>
						<p>@Loc["Db_NoGamesMatchDesc"]</p>
					</div>
				}
			}
			else
			{
				@if (_selectedGameIds.Count > 0)
				{
					<div class="db-bulk-bar">
						<div class="db-bulk-left">
							<span class="db-bulk-badge">☑️ @Loc["Db_SelectedGamesCount", _selectedGameIds.Count]</span>
							<button type="button" class="btn-clear-link" @onclick="ClearSelection">@Loc["Db_DeselectAll"]</button>
						</div>
						<div class="db-bulk-right">
							<button type="button" class="btn-primary-small btn-bulk-move" @onclick="OpenBulkMoveModal">
								📁 @Loc["Db_MoveSelectedGames", _selectedGameIds.Count]
							</button>
						</div>
					</div>
				}

				<table class="db-games-table">
					<thead>
						<tr>
							<th class="col-select">
								<input type="checkbox"
									   class="db-game-checkbox"
									   checked="@IsAllPageSelected"
									   @onchange="ToggleSelectAllPage"
									   title="@Loc["Db_Col_Select"]" />
							</th>
							<th class="col-index" title="@Loc["Db_DragToReorder"]">@Loc["Db_Col_Index"]</th>
							@if (ShowPlatformColumn)
							{
								<th class="col-platform" title="Source platform">@Loc["Db_Col_Site"]</th>
							}
							<th class="col-players">@Loc["Db_Col_White"]</th>
							<th class="col-elo">@Loc["Db_Col_Elo"]</th>
							<th class="col-players">@Loc["Db_Col_Black"]</th>
							<th class="col-elo">@Loc["Db_Col_Elo"]</th>
							<th class="col-result">@Loc["Db_Col_Result"]</th>
							<th class="col-eco">@Loc["Db_Col_Eco"]</th>
							<th class="col-date">@Loc["Db_Col_Date"]</th>
							<th class="col-time">@Loc["Db_Col_Time"]</th>
							<th class="col-event">@Loc["Db_Col_Event"]</th>
							<th class="col-note">@Loc["Db_Col_Note"]</th>
							<th class="col-moves">@Loc["Db_Col_Moves"]</th>
							<th class="col-actions"></th>
						</tr>
					</thead>
					<tbody>
						@for (int i = 0; i < _games.Count; i++)
						{
							int rowIndex = i;
							var game = _games[rowIndex];
							int rowNumber = (_filter.PageNumber - 1) * _filter.PageSize + rowIndex + 1;
							bool isDragging = _draggedRowIndex == rowIndex;
							bool isDragOverTop = _dragOverRowIndex == rowIndex && _draggedRowIndex.HasValue && _draggedRowIndex.Value > rowIndex;
							bool isDragOverBottom = _dragOverRowIndex == rowIndex && _draggedRowIndex.HasValue && _draggedRowIndex.Value < rowIndex;

							<tr @key="game.Id"
								data-game-id="@game.Id"
								draggable="@(_editingNoteGameId != game.Id ? "true" : "false")"
								class="db-game-row @(IsUserGame(game) ? "db-game-row-user" : "") @(_selectedGameIds.Contains(game.Id) ? "row-selected" : "") @(isDragging ? "row-dragging" : "") @(isDragOverTop ? "row-drag-over-top" : "") @(isDragOverBottom ? "row-drag-over-bottom" : "")"
								@ondragstart="() => HandleRowDragStart(rowIndex, game)"
								@ondragover="() => HandleRowDragOver(rowIndex)"
								@ondragover:preventDefault="true"
								@ondrop="() => HandleRowDropAsync(rowIndex)"
								@ondragend="HandleRowDragEnd"
								@ondblclick="() => OpenGameInAnalysis(game)">
								<td class="col-select" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
									<input type="checkbox"
										   class="db-game-checkbox"
										   checked="@_selectedGameIds.Contains(game.Id)"
										   @onchange="e => ToggleSelectGame(game.Id, e)" />
								</td>
								<td class="col-index" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
									<div class="db-row-index-cell">
										<span class="db-row-drag-handle @(isDragging ? "dragging" : "")"
											  tabindex="0"
											  title="@Loc["Db_DragToReorder"]"
											  aria-label="@Loc["Db_DragToReorder"]"
											  @onkeydown="(e) => HandleRowHandleKeyDownAsync(e, rowIndex)"
											  @onkeydown:preventDefault="true">⠿</span>
										<span class="db-row-number">@($"{rowNumber}.")</span>
									</div>
								</td>
								@if (ShowPlatformColumn)
								{
									<td class="col-platform">
										<PlatformIcon Game="game" />
									</td>
								}
								<td class="col-players @(IsWhiteUser(game) ? "player-name-user" : "")">
									<span>@game.White</span>
									@if (IsWhiteUser(game))
									{
										<span class="db-user-tag" title="You (matches your profile)">@Loc["Db_You"]</span>
									}
								</td>
								<td class="col-elo">@(game.WhiteElo?.ToString() ?? "-")</td>
								<td class="col-players @(IsBlackUser(game) ? "player-name-user" : "")">
									<span>@game.Black</span>
									@if (IsBlackUser(game))
									{
										<span class="db-user-tag" title="You (matches your profile)">@Loc["Db_You"]</span>
									}
								</td>
								<td class="col-elo">@(game.BlackElo?.ToString() ?? "-")</td>
								<td class="col-result">
									<span class="ref-result-badge @GetResultClass(game.Result)">@game.Result</span>
								</td>
								<td class="col-eco">@game.Eco</td>
								<td class="col-date">@game.FormattedDate</td>
								<td class="col-time" title="@(game.TimeClass.Length > 0 ? game.TimeControl : null)">
									@if (game.TimeClass.Length > 0)
									{
										<span class="time-class time-class-@game.TimeClass">@TimeClassLabel(game)</span>
									}
									else
									{
										<span class="time-class-none">–</span>
									}
								</td>
								<td class="col-event" title="@game.Event">@game.Event</td>
								<td class="col-note" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
									<div class="db-note-cell-group">
										@if (_showAllGamesFlat && game.FolderId.HasValue)
										{
											string folderPath = GetFolderPath(game.FolderId.Value);
											if (!string.IsNullOrEmpty(folderPath))
											{
												<button type="button"
														class="db-game-folder-pill"
														title="@folderPath"
														@onclick="() => NavigateToFolderAsync(game.FolderId)">
													📁 @folderPath
												</button>
											}
										}
										@if (_editingNoteGameId == game.Id)
										{
											<div class="db-note-edit-wrapper">
												<input class="db-note-input"
													   placeholder="@Loc["Db_NoteInputPlaceholder"]"
													   @bind="_editingNoteValue"
													   @bind:event="oninput"
													   @onkeydown="(e) => HandleNoteKeyDownAsync(e, game)"
													   @onblur="() => CommitNoteEditAsync(game)"
													   autofocus />
											</div>
										}
										else if (!string.IsNullOrWhiteSpace(game.Note))
										{
											<button type="button" class="db-note-badge" title="@Loc["Db_EditNote"]" @onclick="() => StartEditingNote(game)">
												<span class="db-note-tag-icon">🏷️</span>
												<span class="db-note-text">@game.Note</span>
											</button>
										}
										else
										{
											<button type="button" class="db-note-add-btn" title="@Loc["Db_AddNote"]" @onclick="() => StartEditingNote(game)">
												@Loc["Db_AddNote"]
											</button>
										}
									</div>
								</td>
								<td class="col-moves">@game.PlyCount</td>
								<td class="col-actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
									<div class="row-actions-group">
										@if (_folders.Count > 0)
										{
											@if (_movingGameId == game.Id)
											{
												<select class="db-row-folder-select"
														value="@(game.FolderId?.ToString() ?? "")"
														@onchange="e => HandleMoveGameSelectChangedAsync(game, e)">
													<option value="">@Loc["Db_RootFolder"]</option>
													@foreach (var opt in GetFlattenedFolderOptions())
													{
														<option value="@opt.Id">@opt.Label</option>
													}
												</select>
											}
											<button type="button"
													class="btn-secondary-small btn-move-folder"
													title="@Loc["Db_MoveToFolderTitle"]"
													@onclick="() => ToggleMoveGameMenu(game.Id)">📁</button>
										}
										<button class="btn-secondary-small" title="@Loc["Db_OpenGame"]" @onclick="() => OpenGameInAnalysis(game)">@Loc["Db_OpenGame"]</button>
										<button class="btn-danger-small" title="@Loc["Db_DeleteGame"]" @onclick="() => PromptDeleteGame(game)">🗑️</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<!-- Pagination Footer -->
		<div class="db-pagination-footer">
			<div class="pagination-info">
				@Loc["Db_ShowingGames", Math.Min((_filter.PageNumber - 1) * _filter.PageSize + 1, _totalCount), Math.Min(_filter.PageNumber * _filter.PageSize, _totalCount), _totalCount]
			</div>

			<div class="pagination-controls">
				<button class="btn-secondary" disabled="@(_filter.PageNumber <= 1)" @onclick="PreviousPageAsync">@Loc["Db_PrevPage"]</button>
				<span class="pagination-info">@Loc["Db_PageOf", _filter.PageNumber, TotalPages]</span>
				<button class="btn-secondary" disabled="@(_filter.PageNumber >= TotalPages)" @onclick="NextPageAsync">@Loc["Db_NextPage"]</button>
			</div>
		</div>
	</div>
</div>

<!-- New Database Modal (blank / download / import PGN) -->
@if (_showNewDbModal)
{
	<div class="modal-backdrop" @onclick="CloseNewDbModal">
		<div class="modal-dialog @NewDbModalDialogClass" @onclick:stopPropagation="true">
			<div class="modal-header">
				<div class="master-lib-header-info">
					<span class="modal-icon">@NewDbModalIcon</span>
					<div>
						<h3 class="modal-title">@NewDbModalTitle</h3>
						@if (!string.IsNullOrEmpty(NewDbModalSubtitle))
						{
							<p class="modal-subtitle">@NewDbModalSubtitle</p>
						}
					</div>
				</div>
				<button class="modal-close-btn" @onclick="CloseNewDbModal" disabled="@(_isInstallingMaster || _isCreatingFromPgn)">✕</button>
			</div>
			<div class="modal-body @(_newDbMode == NewDbMode.Remote ? "master-lib-body" : "")">
				<div class="import-mode-selector">
					<button type="button"
							class="import-mode-btn @(_newDbMode == NewDbMode.Create ? "active" : "")"
							disabled="@(_isInstallingMaster || _isCreatingFromPgn)"
							@onclick="() => SetNewDbMode(NewDbMode.Create)">
						@Loc["Db_NewDb_Tab_Create"]
					</button>
					<button type="button"
							class="import-mode-btn @(_newDbMode == NewDbMode.Remote ? "active" : "")"
							disabled="@(_isInstallingMaster || _isCreatingFromPgn)"
							@onclick="() => SetNewDbMode(NewDbMode.Remote)">
						@Loc["Db_NewDb_Tab_Remote"]
					</button>
					<button type="button"
							class="import-mode-btn @(_newDbMode == NewDbMode.PgnImport ? "active" : "")"
							disabled="@(_isInstallingMaster || _isCreatingFromPgn)"
							@onclick="() => SetNewDbMode(NewDbMode.PgnImport)">
						@Loc["Db_NewDb_Tab_Import"]
					</button>
				</div>

				@if (_newDbMode == NewDbMode.Create)
				{
					<div class="modal-form-group">
						<label class="filter-label">@Loc["Db_CreateDb_Name"]</label>
						<input class="modal-input" placeholder="@Loc["Db_CreateDb_Placeholder"]" @bind="_newDbName" />
					</div>
				}
				else if (_newDbMode == NewDbMode.Remote)
				{
					@if (_isInstallingMaster)
					{
						<div class="master-install-progress-card">
							<div class="master-install-spinner"></div>
							<div class="master-install-status-text">@_installStatus</div>
							<div class="install-progress-track">
								<div class="install-progress-bar @($"prog-w-{(int)Math.Round(_installProgressPct / 10.0) * 10}")"></div>
							</div>
							<span class="install-progress-pct">@_installProgressPct%</span>
						</div>
					}
					else
					{
						<div class="master-catalog-grid">
							@foreach (var item in _masterCatalog)
							{
								<div class="master-card @(item.IsInstalled ? "master-card-installed" : "")">
									<div class="master-card-top-row">
										<span class="master-tag master-tag-@item.Tag.ToLowerInvariant()">@item.Tag</span>
										<span class="master-era">@item.Era</span>
									</div>
									<h4 class="master-card-title">@item.Title</h4>
									<p class="master-card-desc">@item.Description</p>
									<div class="master-card-footer">
										<span class="master-games-count">@item.EstimatedGameCount.ToString("N0") games</span>
										@if (item.IsInstalled)
										{
											<div class="master-installed-actions">
												<span class="master-installed-badge">✓ Installed</span>
												@if (!string.Equals(item.DatabaseName, _referenceDbName, StringComparison.OrdinalIgnoreCase))
												{
													<button class="btn-xs-reference" title="Designate as primary reference database" @onclick="() => SetAsReferenceDb(item.DatabaseName)">Set as Ref</button>
												}
											</div>
										}
										else
										{
											<button class="btn-install-master" @onclick="() => InstallMasterCollection(item.Id)">Install Collection</button>
										}
									</div>
								</div>
							}
						</div>

						<div class="master-external-tip">
							<span class="tip-icon">💡</span>
							<div class="tip-content">
								<span class="tip-title">Community Mega-Databases:</span>
								<span>Looking for millions of games? Download <strong>Lumbra's GigaBase</strong> (e.g. <em>OTB Elite 2400+</em>) or weekly <strong>TWIC</strong> updates and drag &amp; drop the <code>.7z</code> or <code>.zip</code> file directly into <strong>Import Games</strong>.</span>
							</div>
						</div>
					}
				}
				else
				{
					@if (_isCreatingFromPgn)
					{
						<div class="progress-container">
							<div class="progress-bar-track">
								<div class="progress-bar-fill @($"bar-w-{_createPgnProgress.PercentComplete}")"></div>
							</div>

							<div class="progress-stats-grid">
								<div>Status: @_createPgnProgress.CurrentStage</div>
								<div>Progress: @_createPgnProgress.PercentComplete%</div>
								<div>Games Saved: @_createPgnProgress.GamesSaved</div>
								<div>Elapsed: @_createPgnProgress.Elapsed.ToString(@"mm\:ss")</div>
							</div>
						</div>
					}
					else if (_createPgnFinished)
					{
						<div class="reference-empty-state">
							@if (_createPgnProgress.GamesSaved > 0)
							{
								<span class="empty-state-icon">✅</span>
								<h4>Database Created!</h4>
								<p>"@_createdPgnDbName" was created with @_createPgnProgress.GamesSaved @(_createPgnProgress.GamesSaved == 1 ? "game" : "games") in @_createPgnProgress.Elapsed.ToString(@"mm\:ss").</p>
							}
							else
							{
								<span class="empty-state-icon">⚠️</span>
								<h4>No Games Imported</h4>
								<p>"@_createdPgnDbName" was created, but no valid chess games could be parsed from the provided input. Please check the PGN format and try again.</p>
							}
						</div>
					}
					else
					{
						<div class="modal-form-group">
							<label class="filter-label">@Loc["Db_CreateDb_Name"]</label>
							<input class="modal-input" placeholder="@Loc["Db_CreateDb_Placeholder"]" @bind="_newDbName" />
						</div>

						<div class="import-mode-selector">
							<button type="button"
									class="import-mode-btn @(_newDbPgnSource == PgnSource.Text ? "active" : "")"
									@onclick="() => SetNewDbPgnSource(PgnSource.Text)">
								📝 Paste PGN
							</button>
							<button type="button"
									class="import-mode-btn @(_newDbPgnSource == PgnSource.File ? "active" : "")"
									@onclick="() => SetNewDbPgnSource(PgnSource.File)">
								📁 Upload File
							</button>
						</div>

						@if (_newDbPgnSource == PgnSource.Text)
						{
							<div class="modal-form-group">
								<div class="import-textarea-header">
									<label class="filter-label">Paste PGN Content</label>
									@if (!string.IsNullOrWhiteSpace(_newDbPgnText))
									{
										<span class="import-char-counter">@_newDbPgnText.Length.ToString("N0") characters</span>
									}
								</div>
								<textarea class="modal-textarea"
										  placeholder="Paste one or more PGN games here..."
										  @bind="_newDbPgnText"
										  @bind:event="oninput"
										  spellcheck="false"
										  rows="9"></textarea>
								<div class="import-textarea-hint">
									<span>Supports single or multiple games. Tags, variations, and comments are preserved.</span>
									@if (!string.IsNullOrWhiteSpace(_newDbPgnText))
									{
										<button type="button" class="btn-clear-link" @onclick="ClearNewDbPgnText">Clear text</button>
									}
								</div>
							</div>
						}
						else
						{
							<div class="modal-form-group">
								<label class="filter-label">Select or Drop Chess File to Import</label>
								<label @ref="_newDbDropzoneRef"
									   class="dropzone-box @(_newDbPgnDragOver ? "drag-active" : "")">
									<div class="dropzone-icon" style="pointer-events: none;">📥</div>
									<div class="dropzone-text" style="pointer-events: none;">Click or drag &amp; drop chess file here</div>
									<div class="dropzone-subtext" style="pointer-events: none;">Supports PGN files (.pgn), Zip archives (.zip), and 7-Zip archives (.7z)</div>
									<div class="import-format-badges" style="pointer-events: none;">
										<span class="format-badge">.pgn</span>
										<span class="format-badge">.zip (TWIC, Chess.cz)</span>
										<span class="format-badge">.7z (Lumbra's GigaBase)</span>
									</div>
									<InputFile OnChange="HandleNewDbPgnFileSelected" class="hidden-file-input" accept=".pgn,.zip,.7z" />
								</label>
							</div>

							@if (!string.IsNullOrEmpty(_newDbPgnFileName))
							{
								<div class="filter-group">
									<span class="filter-label">Selected File:</span>
									<span class="score-cell">@_newDbPgnFileName (@FormatFileSize(_newDbPgnFileSize))</span>
								</div>
							}
						}

						@if (!string.IsNullOrEmpty(_newDbPgnError))
						{
							<div class="ref-result-black">@_newDbPgnError</div>
						}
					}
				}
			</div>
			<div class="modal-footer">
				@if (_newDbMode == NewDbMode.Create)
				{
					<button class="btn-secondary" @onclick="CloseNewDbModal">@Loc["Common_Cancel"]</button>
					<button class="btn-primary" disabled="@string.IsNullOrWhiteSpace(_newDbName)" @onclick="CreateDatabaseAsync">@Loc["Db_CreateDb_Btn"]</button>
				}
				else if (_newDbMode == NewDbMode.Remote)
				{
					<button class="btn-secondary" @onclick="CloseNewDbModal" disabled="@_isInstallingMaster">Close</button>
				}
				else
				{
					@if (_isCreatingFromPgn)
					{
						<button class="btn-secondary" @onclick="CancelCreateDbFromPgn">Cancel</button>
					}
					else if (_createPgnFinished)
					{
						@if (_createPgnProgress.GamesSaved == 0)
						{
							<button class="btn-secondary" @onclick="() => _createPgnFinished = false">Try Again</button>
						}
						<button class="btn-primary" @onclick="CloseNewDbModal">Done</button>
					}
					else
					{
						<button class="btn-secondary" @onclick="CloseNewDbModal">Cancel</button>
						<button class="btn-primary" disabled="@(!CanStartCreateDbFromPgn)" @onclick="CreateDbFromPgnAsync">Create &amp; Import</button>
					}
				}
			</div>
		</div>
	</div>
}

<!-- PGN Import Modal -->
<PgnImportDialog IsOpen="_showImportModal"
				 DatabaseName="@_currentDbName"
				 InitialFile="@_initialImportFile"
				 OnClose="() => { _showImportModal = false; _initialImportFile = null; }"
				 OnImportCompleted="HandleImportCompletedAsync" />

<!-- Clean Foreign Games Confirmation Modal -->
@if (_showCleanForeignModal)
{
	<div class="modal-backdrop" @onclick="() => _showCleanForeignModal = false">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_CleanForeign_Title", SyncService.OnlineGamesDatabaseName]</h3>
				<button class="modal-close-btn" @onclick="() => _showCleanForeignModal = false">✕</button>
			</div>
			<div class="modal-body">
				<p class="modal-desc">
					"My online games" is reserved for games synced from your online accounts (Lichess &amp; Chess.com).
				</p>
				@if (_isScanningForeign)
				{
					<div class="reference-empty-state">
						<span>@Loc["Db_CleanForeign_Scanning"]</span>
					</div>
				}
				else if (_foreignGamesCount == 0)
				{
					<div class="clean-foreign-empty-state">
						<span class="empty-state-icon">✅</span>
						<h4>@Loc["Db_CleanForeign_AllClean"]</h4>
						<p>@Loc["Db_CleanForeign_AllCleanDesc", SyncService.OnlineGamesDatabaseName]</p>
					</div>
				}
				else
				{
					<div class="modal-warning-box">
						<div class="modal-warning-title">@Loc["Db_CleanForeign_Detected"]</div>
						<div>@Loc["Db_CleanForeign_Found", _foreignGamesCount, _foreignGamesCount == 1 ? "game" : "games"]</div>
						<div class="clean-foreign-handles-list">
							@Loc["Db_CleanForeign_ActiveHandles"] <strong>@(GetActiveProfileHandlesString())</strong>
						</div>
						<div class="modal-irreversible-warning">
							@Loc["Db_CleanForeign_Irreversible"]
						</div>
					</div>
				}

				@if (!string.IsNullOrEmpty(_cleanStatus))
				{
					<div class="stat-pill-sub clean-status-msg">@_cleanStatus</div>
				}
			</div>
			<div class="modal-footer">
				<button class="btn-secondary" @onclick="() => _showCleanForeignModal = false">
					@(_cleanFinished ? Loc["Common_Close"] : Loc["Common_Cancel"])
				</button>
				@if (!_isScanningForeign && _foreignGamesCount > 0 && !_cleanFinished)
				{
					<button class="btn-danger" @onclick="ExecuteCleanForeignGamesAsync" disabled="@_isCleaningForeign">
						@(_isCleaningForeign ? "..." : Loc["Db_CleanForeign_PurgeBtn", _foreignGamesCount])
					</button>
				}
			</div>
		</div>
	</div>
}

<!-- Fill Missing ECO Modal -->
@if (_showFillEcoModal)
{
	<div class="modal-backdrop" @onclick="() => _showFillEcoModal = false">
		<div class="modal-dialog" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">@Loc["Db_FillEco_Title", _currentDbName]</h3>
				<button class="modal-close-btn" @onclick="() => _showFillEcoModal = false">✕</button>
