	private void PromptFillEco()
	{
		_showFillEcoModal = true;
		_isFillingEco = false;
		_fillEcoFinished = false;
		_fillEcoCount = 0;
		_fillEcoCurrent = 0;
		_fillEcoTotal = 0;
		_fillEcoStatus = "";
		StateHasChanged();
	}

	private async Task ExecuteFillEcoAsync()
	{
		_isFillingEco = true;
		_fillEcoCount = 0;
		_fillEcoCurrent = 0;
		_fillEcoTotal = 0;
		_fillEcoStatus = "";
		StateHasChanged();

		try
		{
			var progress = new Progress<(int current, int total, string status)>(p =>
			{
				_fillEcoCurrent = p.current;
				_fillEcoTotal = p.total;
				StateHasChanged();
			});

			int filled = await DatabaseService.FillMissingEcoAsync(_currentDbName, progress);
			_fillEcoCount = filled;
			_fillEcoFinished = true;
			_fillEcoStatus = filled > 0 ? Loc["Db_FillEco_Filled", filled, _currentDbName] : Loc["Db_FillEco_None"];

			// OnDatabaseModified (fired by the service) already triggers a reload of the
			// current database, but ensure the visible list reflects the updated ECO codes.
			await LoadGamesAsync();
		}
		catch (Exception ex)
		{
			_fillEcoStatus = $"ECO fill error: {ex.Message}";
		}
		finally
		{
			_isFillingEco = false;
			StateHasChanged();
		}
	}

	private async Task OpenExportModal()
	{
		_showExportModal = true;
		_isExporting = false;
		_exportFinished = false;
		_exportScope = "all";
		_exportAllCount = 0;
		_exportFilteredCount = 0;
		_exportedCount = 0;
		_exportCurrent = 0;
		_exportTotal = 0;
		_exportStatus = "";
		_exportFilename = SanitizeExportFilename(_currentDbName);
		_exportSavedPath = "";
		StateHasChanged();

		try
		{
			// Count probes: the filter total ignores paging, so PageSize = 1 keeps it cheap.
			var (_, allCount) = await DatabaseService.SearchGamesAsync(_currentDbName, new GameFilter());
			_exportAllCount = allCount;

			var probe = _filter.Clone();
			probe.PageSize = 1;
			var (_, filteredCount) = await DatabaseService.SearchGamesAsync(_currentDbName, probe);
			_exportFilteredCount = filteredCount;
		}
		catch (Exception ex)
		{
			_exportStatus = $"Export not available: {ex.Message}";
		}

		StateHasChanged();
	}

	private void CloseExportModal()
	{
		if (_isExporting)
		{
			return;
		}

		_showExportModal = false;
		_exportStatus = "";
		StateHasChanged();
	}

	private async Task ExecuteExportAsync()
	{
		if (_exportSelectedCount == 0)
		{
			return;
		}

		_isExporting = true;
		_exportFinished = false;
		_exportedCount = 0;
		_exportCurrent = 0;
		_exportTotal = 0;
		_exportStatus = "";
		StateHasChanged();

		string filename = SanitizeExportFilename(_exportFilename);
		if (!filename.EndsWith(".pgn", StringComparison.OrdinalIgnoreCase))
		{
			filename += ".pgn";
		}

		// The Photino web view does not handle blob downloads, so the destination
		// is picked with a native save dialog and the file is written by the app.
		string? targetPath;
		try
		{
			targetPath = await WindowProvider.Window.ShowSaveFileAsync(
				Loc["Db_Export_SaveTitle"], filename, new[] { ("PGN files", new[] { ".pgn" }) });
		}
		catch (Exception ex)
		{
			_exportStatus = $"Export error: {ex.Message}";
			_isExporting = false;
			StateHasChanged();
			return;
		}

		if (string.IsNullOrWhiteSpace(targetPath))
		{
			_isExporting = false;
			StateHasChanged();
			return;
		}

		try
		{
			using var fileStream = new FileStream(targetPath, FileMode.Create, FileAccess.Write, FileShare.None);
			using var writer = new StreamWriter(fileStream);

			var progress = new Progress<(int current, int total, string status)>(p =>
			{
				_exportCurrent = p.current;
				_exportTotal = p.total;
				InvokeAsync(StateHasChanged);
			});

			GameFilter? exportFilter = _exportScope == "filtered" ? _filter.Clone() : null;

			_exportedCount = await DatabaseService.ExportGamesToPgnAsync(
				_currentDbName,
				exportFilter,
				async chunk => await writer.WriteAsync(chunk),
				progress);

			_exportSavedPath = targetPath;
			_exportFinished = true;
		}
		catch (Exception ex)
		{
			_exportStatus = $"Export error: {ex.Message}";
			try
			{
				if (File.Exists(targetPath))
				{
					File.Delete(targetPath);
				}
			}
			catch
			{
				// Ignore cleanup errors for the partial file
			}
		}
		finally
		{
			_isExporting = false;
			StateHasChanged();
		}
	}

	private static string SanitizeExportFilename(string name)
	{
		if (string.IsNullOrWhiteSpace(name))
		{
			return "export.pgn";
		}

		char[] invalid = Path.GetInvalidFileNameChars();
		char[] chars = new char[name.Length];
		for (int i = 0; i < name.Length; i++)
		{
			chars[i] = Array.IndexOf(invalid, name[i]) >= 0 ? '_' : name[i];
		}

		string sanitized = new string(chars).Trim();
		return string.IsNullOrWhiteSpace(sanitized) ? "export.pgn" : sanitized;
	}

	public void Dispose()
	{
		DatabaseService.OnActiveDatabaseChanged -= HandleActiveDatabaseChanged;
		DatabaseService.OnReferenceDatabaseChanged -= HandleReferenceDatabaseChanged;
		DatabaseService.OnDatabaseModified -= HandleDatabaseModified;
		ProfileService.OnProfileChanged -= HandleProfileChanged;
		Loc.OnLanguageChanged -= StateHasChanged;
		if (_newDbDropInstance != null)
		{
			try { _ = _newDbDropInstance.InvokeVoidAsync("dispose"); } catch { }
			_newDbDropInstance = null;
		}
		if (_browserDropInstance != null)
		{
			try { _ = _browserDropInstance.InvokeVoidAsync("dispose"); } catch { }
			_browserDropInstance = null;
		}
		if (_newDbDroppedStreamRef != null)
		{
			try { _ = _newDbDroppedStreamRef.DisposeAsync(); } catch { }
			_newDbDroppedStreamRef = null;
		}
		_dotNetRef?.Dispose();
		_dotNetRef = null;
		if (_dropModule != null)
		{
			try { _ = _dropModule.DisposeAsync(); } catch { }
			_dropModule = null;
		}
	}
