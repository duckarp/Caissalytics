	}

	private async Task HandlePositionFilterSavedAsync(string fen)
	{
		_showPositionFilterModal = false;
		try
		{
			var pos = FenParser.Parse(fen);
			_filter.PositionZobristKey = pos.ZobristKey;
			_filter.PositionFen = fen;
			_filter.PageNumber = 1;
			await LoadGamesAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[DatabaseBrowser] Failed to parse position filter FEN: {ex.Message}");
		}
	}

	private async Task ClearPositionFilterAsync()
	{
		_filter.PositionZobristKey = null;
		_filter.PositionFen = null;
		_filter.PageNumber = 1;
		await LoadGamesAsync();
	}

	private static string GetShortFen(string? fen)
	{
		if (string.IsNullOrWhiteSpace(fen)) return "";
		var parts = fen.Trim().Split(' ');
		return parts.Length > 0 ? parts[0] : fen;
	}

	private async Task HandleFilterKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			await SearchAsync();
		}
	}

	private async Task PreviousPageAsync()
	{
		if (_filter.PageNumber > 1)
		{
			_filter.PageNumber--;
			await LoadGamesAsync();
		}
	}

	private async Task NextPageAsync()
	{
		if (_filter.PageNumber < TotalPages)
		{
			_filter.PageNumber++;
			await LoadGamesAsync();
		}
	}

	private async Task CreateDatabaseAsync()
	{
		if (string.IsNullOrWhiteSpace(_newDbName)) return;

		string name = _newDbName.Trim();
		_showNewDbModal = false;
		_newDbName = "";

		var db = await DatabaseService.CreateDatabaseAsync(name);
		_currentDbName = db.Name;
		_currentFolderId = null;
		await LoadDatabasesAsync();
	}

