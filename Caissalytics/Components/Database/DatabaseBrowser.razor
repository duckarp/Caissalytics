			? (_bulkMoveTargetFolderOptions.FirstOrDefault(o => o.Id == _bulkMoveTargetFolderId.Value).Label ?? "Folder")
			: Loc["Db_RootFolder"];
		return $"{_bulkMoveTargetDb} / {folderName}";
	}

	private async Task ConfirmBulkMoveAsync()
	{
		if (_bulkMoveGameIds.Count == 0 || string.IsNullOrWhiteSpace(_bulkMoveTargetDb)) return;

		_isBulkMoving = true;
		_bulkMoveError = "";

		try
		{
			await DatabaseService.MoveGamesAsync(_currentDbName, _bulkMoveGameIds, _bulkMoveTargetDb, _bulkMoveTargetFolderId);
			foreach (var id in _bulkMoveGameIds)
			{
				_selectedGameIds.Remove(id);
			}
			_showBulkMoveModal = false;
			_bulkMoveGameIds.Clear();
			await LoadGamesAsync(showLoading: false);
		}
		catch (Exception ex)
		{
			_bulkMoveError = $"Error moving games: {ex.Message}";
		}
		finally
		{
			_isBulkMoving = false;
			StateHasChanged();
		}
	}

	private RenderFragment RenderFolderNode(GameFolder folder, int depth) => __builder =>
	{
		var childFolders = GetChildFolders(folder.Id);
		bool isCreatingChildHere = _creatingFolder && _creatingFolderParentId == folder.Id;
		bool isExpanded = _expandedFolderIds.Contains(folder.Id) || isCreatingChildHere;
		bool isDropTarget = _folderDropTargetId == folder.Id;
		var moveOptions = GetFlattenedFolderOptions(folder.Id);

		<div class="db-folder-tree-item @(depth > 0 ? "db-folder-tree-nested" : "")" @key="folder.Id">
			<div class="db-folder-row @(isDropTarget ? "drop-active" : "") @(_draggedFolderId == folder.Id ? "folder-dragging" : "")"
				 draggable="@(_renamingFolderId != folder.Id ? "true" : "false")"
				 @ondragstart:stopPropagation="true"
				 @ondragstart="() => HandleFolderDragStart(folder.Id)"
				 @ondragend="HandleRowDragEnd"
				 @ondragover:preventDefault="true"
				 @ondragover:stopPropagation="true"
				 @ondragover="() => HandleDragOverFolder(folder.Id)"
				 @ondrop:stopPropagation="true"
				 @ondrop="() => HandleDropOnFolderAsync(folder.Id)"
				 @onclick="() => NavigateToFolderAsync(folder.Id)">
				<div class="db-folder-row-main">
					@if (childFolders.Count > 0)
					{
						<button type="button"
								class="db-folder-expand-btn"
								title="@(isExpanded ? "Collapse subfolders" : "Expand subfolders")"
								@onclick:stopPropagation="true"
								@onclick="() => ToggleFolderSubtreeExpanded(folder.Id)">
							@(isExpanded ? "▾" : "▸")
						</button>
					}
					else
					{
						<span class="db-folder-expand-spacer"></span>
					}

					<span class="db-folder-row-icon">@(isExpanded && childFolders.Count > 0 ? "📂" : "📁")</span>

					@if (_renamingFolderId == folder.Id)
					{
						<div class="db-folder-inline-rename" @onclick:stopPropagation="true">
							<input class="db-folder-inline-input"
								   @bind="_renamingFolderName"
								   @bind:event="oninput"
								   @onkeydown="e => HandleRenameFolderKeyDownAsync(e, folder.Id)" />
							<button type="button" class="db-folder-inline-btn db-folder-inline-confirm" title="@Loc["Common_Save"]" @onclick="() => CommitRenameFolderAsync(folder.Id)">✓</button>
							<button type="button" class="db-folder-inline-btn" title="@Loc["Common_Cancel"]" @onclick="CancelRenameFolder">✕</button>
						</div>
					}
					else
					{
						<span class="db-folder-row-name">@folder.Name</span>
					}
				</div>

				<div class="db-folder-row-right" @onclick:stopPropagation="true">
					<div class="db-folder-row-badges">
						@if (folder.SubfolderCount > 0)
						{
							<span class="db-folder-meta-badge">@Loc["Db_SubfoldersCount", folder.SubfolderCount]</span>
						}
						<span class="db-folder-meta-badge">@Loc["Db_GamesCount", folder.TotalGameCount.ToString("N0")]</span>
					</div>

					@if (_movingFolderMenuId == folder.Id)
					{
						<select class="db-row-folder-select"
								value="@(folder.ParentId?.ToString() ?? "")"
								@onchange="e => HandleMoveFolderSelectChangedAsync(folder, e)">
							<option value="">@Loc["Db_RootFolder"]</option>
							@foreach (var opt in moveOptions)
							{
								<option value="@opt.Id">@opt.Label</option>
							}
						</select>
					}

					<div class="db-folder-row-actions">
						<button type="button" class="db-folder-action-btn" title="@Loc["Db_NewSubfolder"]" @onclick="() => StartCreatingFolder(folder.Id)">+📁</button>
						<button type="button" class="db-folder-action-btn" title="@Loc["Db_RenameFolder"]" @onclick="() => StartRenamingFolder(folder)">✎</button>
						@if (moveOptions.Count > 0 || folder.ParentId.HasValue)
						{
							<button type="button" class="db-folder-action-btn" title="@Loc["Db_MoveToFolderTitle"]" @onclick="() => ToggleMoveFolderMenu(folder.Id)">⇄</button>
						}
						<button type="button" class="db-folder-action-btn db-folder-action-danger" title="@Loc["Db_DeleteFolder"]" @onclick="() => PromptDeleteFolder(folder)">🗑️</button>
					</div>
				</div>
			</div>

			@if (isExpanded && (childFolders.Count > 0 || isCreatingChildHere))
			{
				<div class="db-folder-subtree-children">
					@if (isCreatingChildHere)
					{
						<div class="db-folder-inline-editor">
							<span class="db-folder-row-icon">📁</span>
							<input class="db-folder-inline-input"
								   placeholder="@Loc["Db_FolderPlaceholder"]"
								   @bind="_newFolderName"
								   @bind:event="oninput"
								   @onkeydown="HandleNewFolderKeyDownAsync" />
							<button type="button" class="db-folder-inline-btn db-folder-inline-confirm" title="@Loc["Common_Save"]" @onclick="CommitCreateFolderAsync">✓</button>
							<button type="button" class="db-folder-inline-btn" title="@Loc["Common_Cancel"]" @onclick="CancelCreateFolder">✕</button>
						</div>
					}

					@foreach (var sub in childFolders)
					{
						@RenderFolderNode(sub, depth + 1)
					}
				</div>
			}
		</div>
	};

	private long? _editingNoteGameId = null;
	private string _editingNoteValue = "";
	private int? _draggedRowIndex = null;
	private int? _dragOverRowIndex = null;

	private void StartEditingNote(GameHeader game)
	{
		_editingNoteGameId = game.Id;
		_editingNoteValue = game.Note ?? "";
	}

	private void CancelNoteEdit()
	{
		_editingNoteGameId = null;
		_editingNoteValue = "";
	}

	private async Task CommitNoteEditAsync(GameHeader game)
	{
		if (_editingNoteGameId != game.Id) return;

		string newNote = (_editingNoteValue ?? "").Trim();
		_editingNoteGameId = null;
		_editingNoteValue = "";

		if (string.Equals(game.Note ?? "", newNote, StringComparison.Ordinal))
		{
			return;
		}

		game.Note = newNote;
		game.Pgn = GameHeader.SetNoteInPgn(game.Pgn, newNote);
		await DatabaseService.UpdateGameNoteAsync(_currentDbName, game.Id, newNote);
	}

	private async Task HandleNoteKeyDownAsync(KeyboardEventArgs e, GameHeader game)
	{
		if (e.Key == "Enter")
		{
			await CommitNoteEditAsync(game);
		}
		else if (e.Key == "Escape")
		{
			CancelNoteEdit();
		}
	}

	private void HandleRowDragStart(int index, GameHeader game)
	{
		if (_editingNoteGameId == game.Id) return;
		_draggedRowIndex = index;
		_draggedGameId = game.Id;
		_draggedFolderId = null;
		_dragOverRowIndex = null;
		_folderDropTargetId = null;
	}

	private void HandleRowDragOver(int index)
	{
		_folderDropTargetId = null;
		if (!_draggedRowIndex.HasValue || _draggedRowIndex.Value == index)
		{
			_dragOverRowIndex = null;
			return;
		}
		_dragOverRowIndex = index;
	}

	private void HandleRowDragEnd()
	{
		_draggedRowIndex = null;
		_dragOverRowIndex = null;
		_draggedGameId = null;
		_draggedFolderId = null;
		_folderDropTargetId = null;
	}

	private async Task HandleRowDropAsync(int targetIndex)
	{
		if (!_draggedRowIndex.HasValue)
		{
			HandleRowDragEnd();
			return;
		}

		int sourceIndex = _draggedRowIndex.Value;
		HandleRowDragEnd();

		await MoveRowAsync(sourceIndex, targetIndex);
	}

	private async Task HandleRowHandleKeyDownAsync(KeyboardEventArgs e, int rowIndex)
	{
		if (e.Key == "ArrowUp" && rowIndex > 0)
		{
			await MoveRowAsync(rowIndex, rowIndex - 1);
		}
		else if (e.Key == "ArrowDown" && rowIndex < _games.Count - 1)
		{
			await MoveRowAsync(rowIndex, rowIndex + 1);
		}
	}

	private async Task MoveRowAsync(int sourceIndex, int targetIndex)
	{
		if (sourceIndex == targetIndex || sourceIndex < 0 || sourceIndex >= _games.Count || targetIndex < 0 || targetIndex >= _games.Count)
		{
			return;
		}

		var movedGame = _games[sourceIndex];
		_games.RemoveAt(sourceIndex);
		_games.Insert(targetIndex, movedGame);
		StateHasChanged();

		var orderedIds = _games.Select(g => g.Id).ToList();
		await DatabaseService.ReorderGamesAsync(_currentDbName, orderedIds);
	}

	private async Task SearchAsync()
	{
		_filter.PageNumber = 1;
		await LoadGamesAsync();
	}

	private async Task ResetFilterAsync()
	{
		_filter = new GameFilter { PageSize = 50 };
		await LoadGamesAsync();
	}

	private void OpenPositionFilterModal()
	{
