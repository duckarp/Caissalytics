@namespace Caissalytics.Components.Database
@using Caissalytics.Data

@if (!string.IsNullOrEmpty(EffectivePlatform))
{
	@if (!string.IsNullOrWhiteSpace(EffectiveUrl))
	{
		<a href="@EffectiveUrl"
		   target="_blank"
		   rel="noopener noreferrer"
		   class="platform-icon-link"
		   title="@TooltipText"
		   @onclick:stopPropagation="true">
			<span class="platform-game-icon @EffectivePlatform">
				@RenderPlatformSvg(EffectivePlatform)
			</span>
		</a>
	}
	else
	{
		<span class="platform-game-icon @EffectivePlatform" title="@TooltipText">
			@RenderPlatformSvg(EffectivePlatform)
		</span>
	}
}

@code {
	[Parameter] public GameHeader? Game { get; set; }
	[Parameter] public string? Platform { get; set; }
	[Parameter] public string? Url { get; set; }

	private string EffectivePlatform => Game?.Platform ?? Platform ?? string.Empty;
	private string? EffectiveUrl => Game?.ExternalUrl ?? Url;

	private string TooltipText
	{
		get
		{
			string name = EffectivePlatform switch
			{
				"lichess" => "Lichess",
				"chesscom" => "Chess.com",
				_ => "Online"
			};

			return !string.IsNullOrWhiteSpace(EffectiveUrl)
				? $"Played on {name} (Click to open game)"
				: $"Played on {name}";
		}
	}

	private RenderFragment RenderPlatformSvg(string platform) => __builder =>
	{
		if (platform == "lichess")
		{
			<svg viewBox="0 0 45 45" class="platform-svg lichess-svg" aria-hidden="true">
				<g class="lichess-g" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
					<path d="M 22,10 C 32.5,11 38.5,18 38,39 L 15,39 C 15,30 25,32.5 23,18" class="lichess-body" />
					<path d="M 24,18 C 24.38,20.91 18.45,25.37 16,27 C 13,29 13.18,31.34 11,31 C 9.958,30.06 12.41,27.96 11,28 C 10,28 11.19,29.23 10,30 C 9,30 5.997,31 6,26 C 6,24 12,14 12,14 C 12,14 13.89,12.1 14,10.5 C 13.27,9.506 13.5,8.5 13.5,7.5 C 14.5,6.5 16.5,10 16.5,10 L 18.5,10 C 18.5,10 19.28,8.008 21,7 C 22,7 22,10 22,10" class="lichess-body" />
					<path d="M 9.5 25.5 A 0.5 0.5 0 1 1 8.5,25.5 A 0.5 0.5 0 1 1 9.5 25.5 z" class="lichess-detail" />
					<circle cx="14.5" cy="15.5" r="0.8" class="lichess-detail" />
				</g>
			</svg>
		}
		else if (platform == "chesscom")
		{
			<svg viewBox="20 20 250 350" class="platform-svg chesscom-svg" aria-hidden="true">
				<path class="chesscom-pawn" d="M168.5 217.1c0-27.8 8.4-52.9 26.5-73.9l-18.8-12.4c13.4-9.7 22.1-25.5 22.1-43.3 0-29.6-23.9-53.5-53.3-53.5S91.7 57.9 91.7 87.5c0 17.8 8.7 33.6 22.1 43.3l-38.5 25.4c0 8.5 2 15.3 6 22.7h34c-.1 3.3-.1 7.5-.1 12.5-.8 18.8-6.3 48.7-50.1 82.2-21 15.9-31 43.5-31 70.9 0 1.4 2.9 21.5 111 21.5s111-20.2 111-21.5c0-5.8-.5-11.6-1.4-17.3-50.2-12.9-86.2-57.8-86.2-110.1z" />
			</svg>
		}
	};
}
