@namespace Caissalytics.Components.Database
@using Caissalytics.Data
@using Microsoft.JSInterop
@inject IDatabaseService DatabaseService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
	<div class="modal-backdrop" @onclick="HandleBackdropClick">
		<div @ref="_dialogRef" class="modal-dialog modal-dialog-large @(_isDragOver ? "drag-active" : "")" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">Import Games into @DatabaseName</h3>
				<button class="modal-close-btn" @onclick="CloseDialog">✕</button>
			</div>

			<div class="modal-body">
				@if (string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase))
				{
					<div class="reference-empty-state">
						<span class="empty-state-icon">🔒</span>
						<h4>Protected Database</h4>
						<p>"@DatabaseName" is reserved exclusively for games synchronized via Lichess and Chess.com APIs. Manual PGN imports are disabled.</p>
					</div>
				}
				else if (_isImporting)
				{
					<div class="progress-container">
						<div class="progress-bar-track">
							<div class="progress-bar-fill @($"bar-w-{_progress.PercentComplete}")"></div>
						</div>

						<div class="progress-stats-grid">
							<div>Status: @_progress.CurrentStage</div>
							<div>Progress: @_progress.PercentComplete%</div>
							<div>Games Saved: @_progress.GamesSaved</div>
							<div>Speed: @_progress.GamesPerSecond.ToString("0") games/s</div>
							<div>Elapsed: @_progress.Elapsed.ToString(@"mm\:ss")</div>
							<div>Data: @FormatFileSize(_progress.BytesProcessed)</div>
						</div>
					</div>
				}
				else if (_isFinished)
				{
					<div class="reference-empty-state">
						@if (_progress.GamesSaved > 0)
						{
							<span class="empty-state-icon">✅</span>
							<h4>Import Completed!</h4>
							<p>Successfully imported @_progress.GamesSaved @(_progress.GamesSaved == 1 ? "game" : "games") in @_progress.Elapsed.ToString(@"mm\:ss").</p>
						}
						else
						{
							<span class="empty-state-icon">⚠️</span>
							<h4>No Games Imported</h4>
							<p>No valid chess games could be parsed from the provided input. Please check the PGN format and try again.</p>
						}
					</div>
				}
				else
				{
					<div class="import-mode-selector">
						<button type="button"
								class="import-mode-btn @(_importMode == ImportMode.File ? "active" : "")"
								@onclick="() => SetMode(ImportMode.File)">
							📁 Drop or Upload File
						</button>
						<button type="button"
								class="import-mode-btn @(_importMode == ImportMode.Text ? "active" : "")"
								@onclick="() => SetMode(ImportMode.Text)">
							📝 Paste PGN
						</button>
					</div>

					@if (_importMode == ImportMode.File)
					{
						<div class="modal-form-group">
							<label class="filter-label">Select or Drop Chess File to Import</label>
							<label @ref="_dropzoneRef"
								   class="dropzone-box @(_isDragOver ? "drag-active" : "")">
								<div class="dropzone-icon" style="pointer-events: none;">📥</div>
								<div class="dropzone-text" style="pointer-events: none;">Click or drag &amp; drop chess file here</div>
								<div class="dropzone-subtext" style="pointer-events: none;">Supports PGN files (.pgn), Zip archives (.zip), and 7-Zip archives (.7z)</div>
								<div class="import-format-badges" style="pointer-events: none;">
									<span class="format-badge">.pgn</span>
									<span class="format-badge">.zip (TWIC, Chess.cz)</span>
									<span class="format-badge">.7z (Lumbra's GigaBase)</span>
								</div>
								<InputFile OnChange="HandleFileSelected" class="hidden-file-input" accept=".pgn,.zip,.7z" />
							</label>
						</div>

						@if (!string.IsNullOrEmpty(_selectedFileName))
						{
							<div class="filter-group">
								<span class="filter-label">Selected File:</span>
								<span class="score-cell">@_selectedFileName (@FormatFileSize(_fileSize))</span>
							</div>
						}
					}
					else
					{
						<div class="modal-form-group">
							<div class="import-textarea-header">
								<label class="filter-label">Paste PGN Content</label>
								@if (!string.IsNullOrWhiteSpace(_pastedPgn))
								{
									<span class="import-char-counter">@_pastedPgn.Length.ToString("N0") characters</span>
								}
							</div>
							<textarea class="modal-textarea"
									  placeholder="Paste one or more PGN games here...&#10;&#10;[Event &quot;World Championship 1972&quot;]&#10;[Site &quot;Reykjavik ISL&quot;]&#10;[Date &quot;1972.07.23&quot;]&#10;[Round &quot;6&quot;]&#10;[White &quot;Fischer, Robert J.&quot;]&#10;[Black &quot;Spassky, Boris V.&quot;]&#10;[Result &quot;1-0&quot;]&#10;&#10;1. c4 e6 2. Nf3 d5 3. d4 Nf6 4. Nc3 Be7 5. Bg5 O-O 6. e3 h6 7. Bh4 b6 8. cxd5 Nxd5 9. Bxe7 Qxe7 10. Nxd5 exd5 11. Rc1 Be6 12. Qa4 c5 13. Qa3 Rc8 1-0"
									  @bind="_pastedPgn"
									  @bind:event="oninput"
									  spellcheck="false"
									  rows="9"></textarea>
							<div class="import-textarea-hint">
								<span>Supports single or multiple games. Tags, variations, and comments are preserved.</span>
								@if (!string.IsNullOrWhiteSpace(_pastedPgn))
								{
									<button type="button" class="btn-clear-link" @onclick="ClearPastedPgn">Clear text</button>
								}
							</div>
						</div>
					}

					@if (!string.IsNullOrEmpty(_errorMessage))
					{
						<div class="ref-result-black">@_errorMessage</div>
					}
				}
			</div>

			<div class="modal-footer">
				@if (_isImporting)
				{
					<button class="btn-secondary" @onclick="CancelImport">Cancel</button>
				}
				else if (_isFinished)
				{
					@if (_progress.GamesSaved == 0)
					{
						<button class="btn-secondary" @onclick="() => _isFinished = false">Try Again</button>
					}
					<button class="btn-primary" @onclick="CloseDialog">Done</button>
				}
				else
				{
					<button class="btn-secondary" @onclick="CloseDialog">Cancel</button>
					<button class="btn-primary" disabled="@(!CanStartImport)" @onclick="StartImportAsync">Start Import</button>
				}
			</div>
		</div>
	</div>
}

@code {
	public record InitialDroppedFile(string FileName, long FileSize, IJSStreamReference? StreamRef = null, string? FilePath = null);

	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public string DatabaseName { get; set; } = "Default";
	[Parameter] public InitialDroppedFile? InitialFile { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback OnImportCompleted { get; set; }

	private enum ImportMode
	{
		File,
		Text
	}

	private ImportMode _importMode = ImportMode.File;
	private string _pastedPgn = "";
	private IBrowserFile? _selectedFile;
	private IJSStreamReference? _droppedStreamRef;
	private string? _droppedFilePath;
	private string _selectedFileName = "";
	private long _fileSize = 0;
	private bool _isImporting = false;
	private bool _isFinished = false;
	private string _errorMessage = "";
	private PgnImportProgress _progress = new();
	private CancellationTokenSource? _importCts;
	private bool _prevIsOpen = false;

	private bool _isDragOver = false;
	private ElementReference _dialogRef;
	private ElementReference _dropzoneRef;
	private IJSObjectReference? _dropModule;
	private IJSObjectReference? _dropInstance;
	private DotNetObjectReference<PgnImportDialog>? _dotNetRef;

	private bool CanStartImport => !string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase) &&
		(_importMode == ImportMode.Text
			? !string.IsNullOrWhiteSpace(_pastedPgn)
			: (_selectedFile != null || _droppedStreamRef != null || (!string.IsNullOrEmpty(_droppedFilePath) && File.Exists(_droppedFilePath))));

	protected override void OnParametersSet()
	{
		if (IsOpen && !_prevIsOpen)
		{
			_isFinished = false;
			_isImporting = false;
			_errorMessage = "";
			_importMode = ImportMode.File;
		}
		_prevIsOpen = IsOpen;

		if (InitialFile != null)
		{
			if (_droppedStreamRef != null && _droppedStreamRef != InitialFile.StreamRef)
			{
				try { _ = _droppedStreamRef.DisposeAsync(); } catch { }
			}
			_droppedStreamRef = InitialFile.StreamRef;
			_droppedFilePath = InitialFile.FilePath;
			_selectedFileName = InitialFile.FileName;
			_fileSize = InitialFile.FileSize;
			_selectedFile = null;
			_importMode = ImportMode.File;
			_errorMessage = "";
			InitialFile = null;
		}
	}

	private void SetMode(ImportMode mode)
	{
		_importMode = mode;
		_errorMessage = "";
	}

	private void ClearPastedPgn()
	{
		_pastedPgn = string.Empty;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (IsOpen)
		{
			if (_dropInstance == null)
			{
				try
				{
					_dotNetRef ??= DotNetObjectReference.Create(this);
					_dropModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDropInterop.js");
					_dropInstance = await _dropModule.InvokeAsync<IJSObjectReference>(
						"registerDropZone",
						_dialogRef,
						_dotNetRef,
						nameof(OnFileDropped),
						new[] { ".pgn", ".zip", ".7z" },
						new { mode = "stream" }
					);
				}
				catch { }
			}
		}
		else
		{
			if (_dropInstance != null)
			{
				await _dropInstance.DisposeJsInstanceAsync();
				_dropInstance = null;
			}
		}
	}

	[JSInvokable]
	public async Task OnFileDropped(string fileName, long fileSize, IJSStreamReference streamRef)
	{
		if (_droppedStreamRef != null && _droppedStreamRef != streamRef)
		{
			try { await _droppedStreamRef.DisposeAsync(); } catch { }
		}

		_isDragOver = false;
		_importMode = ImportMode.File;
		_selectedFileName = fileName;
		_fileSize = fileSize;
		_droppedStreamRef = streamRef;
		_droppedFilePath = null;
		_selectedFile = null;
		_errorMessage = "";
		await InvokeAsync(StateHasChanged);
	}

	[JSInvokable]
	public async Task OnFileDroppedPath(string filePath)
	{
		try
		{
			if (!File.Exists(filePath))
			{
				_errorMessage = $"File not found: {filePath}";
				StateHasChanged();
				return;
			}

			var fileInfo = new FileInfo(filePath);
			var ext = fileInfo.Extension.ToLowerInvariant();
			if (ext != ".pgn" && ext != ".zip" && ext != ".7z")
			{
				_errorMessage = $"Unsupported file type \"{fileInfo.Name}\". Supported formats: .pgn, .zip, .7z";
				StateHasChanged();
				return;
			}

			if (_droppedStreamRef != null)
			{
				try { await _droppedStreamRef.DisposeAsync(); } catch { }
				_droppedStreamRef = null;
			}

			_isDragOver = false;
			_importMode = ImportMode.File;
			_selectedFileName = fileInfo.Name;
			_fileSize = fileInfo.Length;
			_droppedFilePath = filePath;
			_selectedFile = null;
			_errorMessage = "";
			await InvokeAsync(StateHasChanged);
		}
		catch (Exception ex)
		{
			_errorMessage = $"Error accessing file: {ex.Message}";
			StateHasChanged();
		}
	}

	[JSInvokable]
	public void OnFileDropError(string errorMessage)
	{
		_errorMessage = errorMessage;
		StateHasChanged();
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		if (_droppedStreamRef != null)
		{
			try { await _droppedStreamRef.DisposeAsync(); } catch { }
			_droppedStreamRef = null;
		}

		_isDragOver = false;
		_droppedFilePath = null;
		_selectedFile = e.File;
		_selectedFileName = e.File.Name;
		_fileSize = e.File.Size;
		_errorMessage = "";
	}

	private static string FormatFileSize(long bytes)
	{
		if (bytes < 1024) return $"{bytes} B";
		if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):0.1} KB";
		if (bytes < 1024L * 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):0.2} MB";
		return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):0.2} GB";
	}

	private async Task StartImportAsync()
	{
		if (!CanStartImport || string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase)) return;

		_isImporting = true;
		_isFinished = false;
		_errorMessage = "";
		_importCts = new CancellationTokenSource();

		var progressReporter = new Progress<PgnImportProgress>(p =>
		{
			_progress = p;
			InvokeAsync(StateHasChanged);
		});

		var databaseName = DatabaseName;
		var token = _importCts.Token;

		try
		{
			if (_importMode == ImportMode.Text)
			{
				var pgnText = _pastedPgn;
				await Task.Run(() => DatabaseService.ImportPgnTextAsync(databaseName, pgnText, progressReporter, token), token);
			}
			else if (!string.IsNullOrEmpty(_droppedFilePath) && File.Exists(_droppedFilePath))
			{
				var fileName = _selectedFileName;
				var filePath = _droppedFilePath;
				await Task.Run(async () =>
				{
					await using var fsRead = File.OpenRead(filePath);
					await DatabaseService.ImportPgnStreamAsync(databaseName, fsRead, fileName, progressReporter, token);
				}, token);
			}
			else
			{
				// Copy uploaded file/stream into a temporary file on disk using the Blazor thread context.
				// This allows both streaming from JS and reading from background threads without high memory usage.
				string tempFile = Path.Combine(Path.GetTempPath(), $"caissa_import_{Guid.NewGuid():N}.tmp");
				try
				{
					await using (var fs = File.Create(tempFile))
					{
						if (_droppedStreamRef != null)
						{
							await using var jsStream = await _droppedStreamRef.OpenReadStreamAsync(maxAllowedSize: 2048L * 1024 * 1024, cancellationToken: token);
							await jsStream.CopyToAsync(fs, token);
						}
						else if (_selectedFile != null)
						{
							await using var browserStream = _selectedFile.OpenReadStream(maxAllowedSize: 2048L * 1024 * 1024, cancellationToken: token);
							await browserStream.CopyToAsync(fs, token);
						}
						else
						{
							throw new InvalidOperationException("No file was selected for import.");
						}
					}

					var fileName = _selectedFileName;
					await Task.Run(async () =>
					{
						await using var fsRead = File.OpenRead(tempFile);
						await DatabaseService.ImportPgnStreamAsync(databaseName, fsRead, fileName, progressReporter, token);
					}, token);
				}
				finally
				{
					try { if (File.Exists(tempFile)) File.Delete(tempFile); } catch { }
				}
			}

			_isFinished = true;
			if (OnImportCompleted.HasDelegate)
			{
				await OnImportCompleted.InvokeAsync();
			}
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Import was cancelled.";
		}
		catch (Exception ex)
		{
			_errorMessage = $"Import error: {ex.Message}";
		}
		finally
		{
			_isImporting = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void CancelImport()
	{
		_importCts?.Cancel();
	}

	private async Task CloseDialog()
	{
		if (_dropInstance != null)
		{
			await _dropInstance.DisposeJsInstanceAsync();
			_dropInstance = null;
		}
		if (_droppedStreamRef != null)
		{
			try { await _droppedStreamRef.DisposeAsync(); } catch { }
			_droppedStreamRef = null;
		}
		_droppedFilePath = null;
		IsOpen = false;
		_isFinished = false;
		_selectedFile = null;
		_selectedFileName = "";
		_pastedPgn = "";
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}

	private async Task HandleBackdropClick()
	{
		if (!_isImporting)
		{
			await CloseDialog();
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_dropInstance != null)
		{
			await _dropInstance.DisposeJsInstanceAsync();
			_dropInstance = null;
		}
		if (_dropModule != null)
		{
			try { await _dropModule.DisposeAsync(); } catch { }
			_dropModule = null;
		}
		if (_droppedStreamRef != null)
		{
			try { await _droppedStreamRef.DisposeAsync(); } catch { }
			_droppedStreamRef = null;
		}
		_dotNetRef?.Dispose();
		_dotNetRef = null;
	}
}
