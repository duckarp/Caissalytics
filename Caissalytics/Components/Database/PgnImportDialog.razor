@namespace Caissalytics.Components.Database
@using Caissalytics.Data
@inject IDatabaseService DatabaseService

@if (IsOpen)
{
	<div class="modal-backdrop" @onclick="HandleBackdropClick">
		<div class="modal-dialog modal-dialog-large" @onclick:stopPropagation="true">
			<div class="modal-header">
				<h3 class="modal-title">Import Games into @DatabaseName</h3>
				<button class="modal-close-btn" @onclick="CloseDialog">✕</button>
			</div>

			<div class="modal-body">
				@if (string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase))
				{
					<div class="reference-empty-state">
						<span class="empty-state-icon">🔒</span>
						<h4>Protected Database</h4>
						<p>"@DatabaseName" is reserved exclusively for games synchronized via Lichess and Chess.com APIs. Manual PGN imports are disabled.</p>
					</div>
				}
				else if (_isImporting)
				{
					<div class="progress-container">
						<div class="progress-bar-track">
							<div class="progress-bar-fill @($"bar-w-{_progress.PercentComplete}")"></div>
						</div>

						<div class="progress-stats-grid">
							<div>Status: @_progress.CurrentStage</div>
							<div>Progress: @_progress.PercentComplete%</div>
							<div>Games Saved: @_progress.GamesSaved</div>
							<div>Speed: @_progress.GamesPerSecond.ToString("0") games/s</div>
							<div>Elapsed: @_progress.Elapsed.ToString(@"mm\:ss")</div>
							<div>Data: @((_progress.BytesProcessed / 1024.0 / 1024.0).ToString("0.1")) MB</div>
						</div>
					</div>
				}
				else if (_isFinished)
				{
					<div class="reference-empty-state">
						@if (_progress.GamesSaved > 0)
						{
							<span class="empty-state-icon">✅</span>
							<h4>Import Completed!</h4>
							<p>Successfully imported @_progress.GamesSaved @(_progress.GamesSaved == 1 ? "game" : "games") in @_progress.Elapsed.ToString(@"mm\:ss").</p>
						}
						else
						{
							<span class="empty-state-icon">⚠️</span>
							<h4>No Games Imported</h4>
							<p>No valid chess games could be parsed from the provided input. Please check the PGN format and try again.</p>
						}
					</div>
				}
				else
				{
					<div class="import-mode-selector">
						<button type="button"
								class="import-mode-btn @(_importMode == ImportMode.Text ? "active" : "")"
								@onclick="() => SetMode(ImportMode.Text)">
							📝 Paste PGN
						</button>
						<button type="button"
								class="import-mode-btn @(_importMode == ImportMode.File ? "active" : "")"
								@onclick="() => SetMode(ImportMode.File)">
							📁 Upload File
						</button>
					</div>

					@if (_importMode == ImportMode.Text)
					{
						<div class="modal-form-group">
							<div class="import-textarea-header">
								<label class="filter-label">Paste PGN Content</label>
								@if (!string.IsNullOrWhiteSpace(_pastedPgn))
								{
									<span class="import-char-counter">@_pastedPgn.Length.ToString("N0") characters</span>
								}
							</div>
							<textarea class="modal-textarea"
									  placeholder="Paste one or more PGN games here...&#10;&#10;[Event &quot;World Championship 1972&quot;]&#10;[Site &quot;Reykjavik ISL&quot;]&#10;[Date &quot;1972.07.23&quot;]&#10;[Round &quot;6&quot;]&#10;[White &quot;Fischer, Robert J.&quot;]&#10;[Black &quot;Spassky, Boris V.&quot;]&#10;[Result &quot;1-0&quot;]&#10;&#10;1. c4 e6 2. Nf3 d5 3. d4 Nf6 4. Nc3 Be7 5. Bg5 O-O 6. e3 h6 7. Bh4 b6 8. cxd5 Nxd5 9. Bxe7 Qxe7 10. Nxd5 exd5 11. Rc1 Be6 12. Qa4 c5 13. Qa3 Rc8 1-0"
									  @bind="_pastedPgn"
									  @bind:event="oninput"
									  spellcheck="false"
									  rows="9"></textarea>
							<div class="import-textarea-hint">
								<span>Supports single or multiple games. Tags, variations, and comments are preserved.</span>
								@if (!string.IsNullOrWhiteSpace(_pastedPgn))
								{
									<button type="button" class="btn-clear-link" @onclick="ClearPastedPgn">Clear text</button>
								}
							</div>
						</div>
					}
					else
					{
						<div class="modal-form-group">
							<label class="filter-label">Select or Drop Chess File to Import</label>
							<label class="dropzone-box @(_isDragOver ? "drag-active" : "")"
								   @ondragenter="HandleDragEnter"
								   @ondragleave="HandleDragLeave"
								   @ondrop="HandleDrop">
								<div class="dropzone-icon">📥</div>
								<div class="dropzone-text">Click or drag &amp; drop chess file here</div>
								<div class="dropzone-subtext">Supports PGN files (.pgn), Zip archives (.zip), and 7-Zip archives (.7z)</div>
								<div class="import-format-badges">
									<span class="format-badge">.pgn</span>
									<span class="format-badge">.zip (TWIC, Chess.cz)</span>
									<span class="format-badge">.7z (Lumbra's GigaBase)</span>
								</div>
								<InputFile OnChange="HandleFileSelected" class="hidden-file-input" accept=".pgn,.zip,.7z" />
							</label>
						</div>

						@if (!string.IsNullOrEmpty(_selectedFileName))
						{
							<div class="filter-group">
								<span class="filter-label">Selected File:</span>
								<span class="score-cell">@_selectedFileName (@((_fileSize / 1024.0 / 1024.0).ToString("0.2")) MB)</span>
							</div>
						}
					}

					@if (!string.IsNullOrEmpty(_errorMessage))
					{
						<div class="ref-result-black">@_errorMessage</div>
					}
				}
			</div>

			<div class="modal-footer">
				@if (_isImporting)
				{
					<button class="btn-secondary" @onclick="CancelImport">Cancel</button>
				}
				else if (_isFinished)
				{
					@if (_progress.GamesSaved == 0)
					{
						<button class="btn-secondary" @onclick="() => _isFinished = false">Try Again</button>
					}
					<button class="btn-primary" @onclick="CloseDialog">Done</button>
				}
				else
				{
					<button class="btn-secondary" @onclick="CloseDialog">Cancel</button>
					<button class="btn-primary" disabled="@(!CanStartImport)" @onclick="StartImportAsync">Start Import</button>
				}
			</div>
		</div>
	</div>
}

@code {
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public string DatabaseName { get; set; } = "Default";
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback OnImportCompleted { get; set; }

	private enum ImportMode
	{
		Text,
		File
	}

	private ImportMode _importMode = ImportMode.Text;
	private string _pastedPgn = "";
	private IBrowserFile? _selectedFile;
	private string _selectedFileName = "";
	private long _fileSize = 0;
	private bool _isImporting = false;
	private bool _isFinished = false;
	private string _errorMessage = "";
	private PgnImportProgress _progress = new();
	private CancellationTokenSource? _importCts;
	private bool _prevIsOpen = false;

	private bool CanStartImport => !string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase) &&
		(_importMode == ImportMode.Text
			? !string.IsNullOrWhiteSpace(_pastedPgn)
			: _selectedFile != null);

	protected override void OnParametersSet()
	{
		if (IsOpen && !_prevIsOpen)
		{
			_isFinished = false;
			_isImporting = false;
			_errorMessage = "";
		}
		_prevIsOpen = IsOpen;
	}

	private void SetMode(ImportMode mode)
	{
		_importMode = mode;
		_errorMessage = "";
	}

	private void ClearPastedPgn()
	{
		_pastedPgn = string.Empty;
	}

	private bool _isDragOver = false;

	private void HandleDragEnter() => _isDragOver = true;
	private void HandleDragLeave() => _isDragOver = false;
	private void HandleDrop() => _isDragOver = false;

	private void HandleFileSelected(InputFileChangeEventArgs e)
	{
		_isDragOver = false;
		_selectedFile = e.File;
		_selectedFileName = e.File.Name;
		_fileSize = e.File.Size;
		_errorMessage = "";
	}

	private async Task StartImportAsync()
	{
		if (!CanStartImport || string.Equals(DatabaseName, IDatabaseService.ProtectedOnlineDatabaseName, StringComparison.OrdinalIgnoreCase)) return;

		_isImporting = true;
		_isFinished = false;
		_errorMessage = "";
		_importCts = new CancellationTokenSource();

		var progressReporter = new Progress<PgnImportProgress>(p =>
		{
			_progress = p;
			InvokeAsync(StateHasChanged);
		});

		// Capture locals for the background task so we don't capture 'this' state mutably
		var databaseName = DatabaseName;
		var token = _importCts.Token;

		try
		{
			if (_importMode == ImportMode.Text)
			{
				var pgnText = _pastedPgn;
				await Task.Run(() => DatabaseService.ImportPgnTextAsync(databaseName, pgnText, progressReporter, token), token);
			}
			else
			{
				// IBrowserFile.OpenReadStream() is bound to the Blazor render context and cannot be
				// accessed from a background thread. Copy the file into a plain MemoryStream here on
				// the Blazor thread first, then hand the MemoryStream off to the thread pool.
				var ms = new MemoryStream();
				using (var browserStream = _selectedFile!.OpenReadStream(maxAllowedSize: 2048L * 1024 * 1024))
				{
					await browserStream.CopyToAsync(ms, token);
				}
				ms.Position = 0;
				var fileName = _selectedFileName;
				await Task.Run(async () =>
				{
					await using var _ = ms;
					await DatabaseService.ImportPgnStreamAsync(databaseName, ms, fileName, progressReporter, token);
				}, token);
			}

			_isFinished = true;
			if (OnImportCompleted.HasDelegate)
			{
				await OnImportCompleted.InvokeAsync();
			}
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Import was cancelled.";
		}
		catch (Exception ex)
		{
			_errorMessage = $"Import error: {ex.Message}";
		}
		finally
		{
			_isImporting = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void CancelImport()
	{
		_importCts?.Cancel();
	}

	private async Task CloseDialog()
	{
		IsOpen = false;
		_isFinished = false;
		_selectedFile = null;
		_selectedFileName = "";
		_pastedPgn = "";
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}

	private async Task HandleBackdropClick()
	{
		if (!_isImporting)
		{
			await CloseDialog();
		}
	}
}
