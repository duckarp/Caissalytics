@namespace Caissalytics.Components.Dossier
@using Caissalytics.Data
@using Caissalytics.Components
@inject IOpponentDossierService DossierService
@inject IDatabaseService DatabaseService
@inject WorkspaceState Workspace
@implements IDisposable

<div class="dossier-container">
	<!-- Top Bar: Player Search & Source Selector -->
	<header class="dossier-search-bar">
		<div class="dossier-search-left">
			<div class="dossier-search-modes">
				<button type="button" class="search-mode-pill @(_searchMode == "local" ? "active" : "")" @onclick='() => SetSearchMode("local")'>
					<span>💾 Local DB</span>
				</button>
				<button type="button" class="search-mode-pill @(_searchMode == "fide" ? "active" : "")" @onclick='() => SetSearchMode("fide")'>
					<span>🌐 FIDE &amp; Web</span>
				</button>
			</div>

			<div class="dossier-input-wrapper">
				<input type="text"
					   class="dossier-search-input"
					   placeholder="@(_searchMode == "fide" ? "Enter FIDE ID (e.g. 1503014) or Name..." : "Search opponent name (e.g. Kasparov, Carlsen)...")"
					   @bind="_searchQuery"
					   @bind:event="oninput"
					   @onkeyup="HandleKeyUp" />

				@if (_showSuggestions)
				{
					@if (_searchMode == "fide" && _fideSuggestions.Count > 0)
					{
						<div class="dossier-autocomplete-list">
							@foreach (var p in _fideSuggestions)
							{
								<div class="autocomplete-item" @onclick="() => SelectFidePlayer(p)">
									<div class="autocomplete-fide-row">
										@if (!string.IsNullOrEmpty(p.Title))
										{
											<span class="fide-title-badge @GetTitleBadgeClass(p.Title)">@p.Title</span>
										}
										<span class="autocomplete-fide-name">@p.FullName</span>
										<div class="autocomplete-fide-info">
											@if (!string.IsNullOrEmpty(p.Federation))
											{
												<span>@p.Federation</span>
											}
											@if (p.StandardElo.HasValue && p.StandardElo.Value > 0)
											{
												<span>⚡ @p.StandardElo</span>
											}
											<span>ID: @p.FideId</span>
										</div>
									</div>
								</div>
							}
						</div>
					}
					else if (_searchMode == "local" && _suggestions.Count > 0)
					{
						<div class="dossier-autocomplete-list">
							@foreach (var p in _suggestions)
							{
								<div class="autocomplete-item" @onclick="() => SelectPlayer(p)">
									<span>@p</span>
									<span>🔍</span>
								</div>
							}
						</div>
					}
				}
			</div>

			<button class="dossier-action-btn btn-primary" @onclick="() => SearchPlayerAsync(_searchQuery)">
				@(_searchMode == "fide" ? "Scout FIDE & Web" : "Scout Opponent")
			</button>
		</div>

		<div class="dossier-search-actions">
			<select class="dossier-db-select" value="@_selectedDb" @onchange="HandleDbChanged">
				@foreach (var db in _databases)
				{
					<option value="@db.Name">@db.Name (@db.GameCount.ToString("N0") games)</option>
				}
			</select>

			<button class="dossier-action-btn" @onclick="OpenOnlineFetchModal" title="Download games for any online player on Lichess, Chess.com or Chess-Results">
				<span>🌐</span>
				<span>Fetch Online Games</span>
			</button>
		</div>
	</header>

	<!-- Content Viewport -->
	@if (_isLoading)
	{
		<div class="dossier-empty-state">
			<div class="workspace-loading-spinner"></div>
			<div class="empty-state-title">Generating Scouting Dossier...</div>
			<div class="empty-state-desc">Analyzing game records, parsing opening lines, and computing tactical tendencies.</div>
		</div>
	}
	else if (_currentReport == null)
	{
		<div class="dossier-empty-state">
			<span class="empty-state-icon">♟️</span>
			<div class="empty-state-title">No Opponent Selected</div>
			<div class="empty-state-desc">
				Type a player's name above to generate a comprehensive pre-game scouting report, or fetch their latest games from Lichess / Chess.com.
			</div>
		</div>
	}
	else
	{
		<div class="dossier-content-scroll">
			<!-- Hero Card: Dossier Overview -->
			<div class="dossier-hero-card">
				<div class="hero-main-row">
					<div class="hero-identity">
						<div class="hero-avatar-icon">👤</div>
						<div>
							<h2 class="hero-name">
								@if (_currentReport.FideCard != null && !string.IsNullOrEmpty(_currentReport.FideCard.TitleAbbreviation))
								{
									<span class="fide-title-badge @GetTitleBadgeClass(_currentReport.FideCard.TitleAbbreviation)">@_currentReport.FideCard.TitleAbbreviation</span>
								}
								@_currentReport.PlayerName
							</h2>
							<div class="hero-badges-row">
								@if (_currentReport.FideCard != null)
								{
									@if (!string.IsNullOrEmpty(_currentReport.FideCard.Federation))
									{
										<span class="hero-badge">
											@if (!string.IsNullOrEmpty(_currentReport.FideCard.FlagUrl))
											{
												<img class="fide-flag-img" src="@_currentReport.FideCard.FlagUrl" alt="Flag" />
											}
											@_currentReport.FideCard.Federation
										</span>
									}
									<a href="@_currentReport.FideCard.ProfileUrl" target="_blank" class="hero-badge hero-badge-elo fide-profile-link" title="Open FIDE Profile">
										FIDE ID: @_currentReport.FideCard.FideId ↗
									</a>
									@if (_currentReport.FideCard.WorldRankActive.HasValue)
									{
										<span class="hero-badge hero-badge-elo">World: #@_currentReport.FideCard.WorldRankActive</span>
									}
									@if (_currentReport.FideCard.NationalRank.HasValue)
									{
										<span class="hero-badge hero-badge-elo">National: #@_currentReport.FideCard.NationalRank</span>
									}
									@if (_currentReport.FideCard.BirthYear.HasValue)
									{
										<span class="hero-badge">B-Year: @_currentReport.FideCard.BirthYear</span>
									}
								}
								<span class="hero-badge">Database: @_currentReport.DatabaseSource</span>
								@if (_currentReport.PeakElo.HasValue)
								{
									<span class="hero-badge hero-badge-elo">Peak Elo: @_currentReport.PeakElo</span>
								}
								@if (_currentReport.AvgElo.HasValue)
								{
									<span class="hero-badge hero-badge-elo">Avg Elo: @_currentReport.AvgElo</span>
								}
								<span class="hero-badge hero-badge-style">Style: @_currentReport.PlayingStyle</span>
								@if (!string.IsNullOrEmpty(_currentReport.EarliestDate))
								{
									<span class="hero-badge">@_currentReport.EarliestDate — @_currentReport.LatestDate</span>
								}
							</div>

							@if (_currentReport.FideCard != null)
							{
								<div class="fide-ratings-panel">
									<div class="fide-rating-pill standard">
										<span class="fide-rating-category">Classical (Std)</span>
										<span class="fide-rating-num">@(_currentReport.FideCard.StandardElo?.ToString() ?? "Unrated")</span>
									</div>
									<div class="fide-rating-pill rapid">
										<span class="fide-rating-category">Rapid</span>
										<span class="fide-rating-num">@(_currentReport.FideCard.RapidElo?.ToString() ?? "Unrated")</span>
									</div>
									<div class="fide-rating-pill blitz">
										<span class="fide-rating-category">Blitz</span>
										<span class="fide-rating-num">@(_currentReport.FideCard.BlitzElo?.ToString() ?? "Unrated")</span>
									</div>
								</div>
							}
						</div>
					</div>

					<div class="dossier-hero-actions">
						@if (_currentReport.TotalGames > 0)
						{
							<button class="dossier-action-btn" @onclick="OpenExportModal">
								<span>💾</span>
								<span>Export Games (@SelectedGamesCount)</span>
							</button>
						}
						@if (_currentReport.FideCard != null || _currentReport.RecentTournaments.Count > 0)
						{
							<button class="dossier-action-btn btn-primary" @onclick="FetchChessResultsGamesAsync" disabled="@_isFetchingChessResults">
								<span>⬇️</span>
								<span>@(_isFetchingChessResults ? "Importing..." : "Import from Chess-Results")</span>
							</button>
						}
						<button class="dossier-action-btn" @onclick="OpenOnlineFetchModal">
							<span>🌐</span>
							<span>Fetch Online Games</span>
						</button>
					</div>
				</div>

				<!-- Performance Stat Cards -->
				<div class="hero-stats-grid">
					<div class="stat-pill-card">
						<span class="stat-pill-label">Total Games</span>
						<span class="stat-pill-value">@_currentReport.TotalGames.ToString("N0")</span>
						<span class="stat-pill-sub">@_currentReport.OverallScore% score (@_currentReport.TotalWins W / @_currentReport.TotalDraws D / @_currentReport.TotalLosses L)</span>
						@RenderRatioBar(_currentReport.TotalWins, _currentReport.TotalDraws, _currentReport.TotalLosses, _currentReport.TotalGames)
					</div>

					<div class="stat-pill-card">
						<span class="stat-pill-label">When Playing White</span>
						<span class="stat-pill-value">@_currentReport.WhiteScore%</span>
						<span class="stat-pill-sub">@_currentReport.WhiteGamesCount games (@_currentReport.WhiteWins W / @_currentReport.WhiteDraws D / @_currentReport.WhiteLosses L)</span>
						@RenderRatioBar(_currentReport.WhiteWins, _currentReport.WhiteDraws, _currentReport.WhiteLosses, _currentReport.WhiteGamesCount)
					</div>

					<div class="stat-pill-card">
						<span class="stat-pill-label">When Playing Black</span>
						<span class="stat-pill-value">@_currentReport.BlackScore%</span>
						<span class="stat-pill-sub">@_currentReport.BlackGamesCount games (@_currentReport.BlackWins W / @_currentReport.BlackDraws D / @_currentReport.BlackLosses L)</span>
						@RenderRatioBar(_currentReport.BlackWins, _currentReport.BlackDraws, _currentReport.BlackLosses, _currentReport.BlackGamesCount)
					</div>

					<div class="stat-pill-card">
						<span class="stat-pill-label">Tactical Tendency</span>
						<span class="stat-pill-value">@_currentReport.PlayingStyle</span>
						<span class="stat-pill-sub">@_currentReport.LengthTendencies.ShortGamesCount short games (&lt;30 moves)</span>
					</div>
				</div>
			</div>

			<!-- Vulnerability Alerts (if detected) -->
			@if (_currentReport.Vulnerabilities.Count > 0)
			{
				<div class="vulnerabilities-panel">
					@foreach (var vuln in _currentReport.Vulnerabilities)
					{
						<div class="vulnerability-card">
							<div class="vuln-header-row">
								<span class="vuln-title">
									<span>⚠️</span>
									<span>@vuln.Title</span>
								</span>
								<span class="vuln-badge @(vuln.Severity == "High" ? "severity-high" : "severity-moderate")">
									@vuln.Severity Priority
								</span>
							</div>
							<div class="vuln-desc">@vuln.Description</div>
							<div class="vuln-recommendation">🎯 Recommendation: @vuln.Recommendation</div>
						</div>
					}
				</div>
			}

			<!-- Navigation Tabs inside Dossier -->
			<nav class="dossier-nav-tabs">
				<button class="dossier-tab-btn @(_activeSection == "white" ? "active" : "")" @onclick='() => _activeSection = "white"'>
					<span>⚪ White Repertoire (@_currentReport.WhiteGamesCount)</span>
				</button>
				<button class="dossier-tab-btn @(_activeSection == "black" ? "active" : "")" @onclick='() => _activeSection = "black"'>
					<span>⚫ Black Repertoire (@_currentReport.BlackGamesCount)</span>
				</button>
				<button class="dossier-tab-btn @(_activeSection == "style" ? "active" : "")" @onclick='() => _activeSection = "style"'>
					<span>📊 Playing Style &amp; Phases</span>
				</button>
				<button class="dossier-tab-btn @(_activeSection == "games" ? "active" : "")" @onclick='() => _activeSection = "games"'>
					<span>🗄️ Games Archive (@_currentReport.RecentGames.Count)</span>
				</button>
				<button class="dossier-tab-btn @(_activeSection == "tournaments" ? "active" : "")" @onclick='() => _activeSection = "tournaments"'>
					<span>🏆 OTB Tournaments (@(_currentReport.RecentTournaments?.Count ?? 0))</span>
				</button>
			</nav>

			<!-- Section 1: White Repertoire -->
			@if (_activeSection == "white")
			{
				<div class="repertoire-branches-grid">
					@if (_currentReport.WhiteRepertoire.Count == 0)
					{
						<div class="dossier-empty-state">
							<div class="empty-state-title">No games as White found</div>
						</div>
					}
					else
					{
						@foreach (var branch in _currentReport.WhiteRepertoire)
						{
							<div class="repertoire-branch-card">
								<div class="branch-card-header">
									<div class="branch-move-title">
										<span class="move-pill-tag">@branch.Move</span>
										<span class="branch-cat-badge">@branch.Category</span>
									</div>
									<div class="branch-stat-summary">
										<span><strong>@branch.GameCount</strong> games (@branch.FrequencyPct%)</span>
										<span class="branch-score-highlight">Score: @branch.ScorePct%</span>
										<span>(@branch.Wins W / @branch.Draws D / @branch.Losses L)</span>
									</div>
								</div>

								@if (branch.KeyLines.Count > 0)
								{
									<table class="branch-lines-table">
										<thead>
											<tr>
												<th>ECO</th>
												<th>Opening Name</th>
												<th>Key Sequence</th>
												<th>Games</th>
												<th>Score</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var line in branch.KeyLines)
											{
												<tr>
													<td><strong>@line.Eco</strong></td>
													<td>@line.Name</td>
													<td>@line.MoveSequence</td>
													<td>@line.GameCount</td>
													<td><strong>@line.ScorePct%</strong> (@line.Wins/@line.Draws/@line.Losses)</td>
													<td>
														@if (line.SampleGameId.HasValue)
														{
															<button class="game-action-btn" @onclick="() => LoadGameById(line.SampleGameId.Value)" title="Open sample game in Stockfish Analysis">
																Analyze
															</button>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
						}
					}
				</div>
			}

			<!-- Section 2: Black Repertoire -->
			@if (_activeSection == "black")
			{
				<div class="repertoire-branches-grid">
					@if (_currentReport.BlackRepertoire.Count == 0)
					{
						<div class="dossier-empty-state">
							<div class="empty-state-title">No games as Black found</div>
						</div>
					}
					else
					{
						@foreach (var branch in _currentReport.BlackRepertoire)
						{
							<div class="repertoire-branch-card">
								<div class="branch-card-header">
									<div class="branch-move-title">
										<span class="move-pill-tag">@branch.Move</span>
										<span class="branch-cat-badge">@branch.Category</span>
									</div>
									<div class="branch-stat-summary">
										<span><strong>@branch.GameCount</strong> games (@branch.FrequencyPct%)</span>
										<span class="branch-score-highlight">Score: @branch.ScorePct%</span>
										<span>(@branch.Wins W / @branch.Draws D / @branch.Losses L)</span>
									</div>
								</div>

								@if (branch.KeyLines.Count > 0)
								{
									<table class="branch-lines-table">
										<thead>
											<tr>
												<th>ECO</th>
												<th>Opening Name</th>
												<th>Key Sequence</th>
												<th>Games</th>
												<th>Score</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var line in branch.KeyLines)
											{
												<tr>
													<td><strong>@line.Eco</strong></td>
													<td>@line.Name</td>
													<td>@line.MoveSequence</td>
													<td>@line.GameCount</td>
													<td><strong>@line.ScorePct%</strong> (@line.Wins/@line.Draws/@line.Losses)</td>
													<td>
														@if (line.SampleGameId.HasValue)
														{
															<button class="game-action-btn" @onclick="() => LoadGameById(line.SampleGameId.Value)" title="Open sample game in Stockfish Analysis">
																Analyze
															</button>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
						}
					}
				</div>
			}

			<!-- Section 3: Style & Tendencies -->
			@if (_activeSection == "style")
			{
				<div class="style-tendencies-grid">
					<div class="style-card">
						<span class="style-card-title">Playing Style Profile</span>
						<span class="hero-badge hero-badge-style">@_currentReport.PlayingStyle</span>
						<p class="style-card-desc">@_currentReport.StyleDescription</p>
					</div>

					<div class="style-card">
						<span class="style-card-title">Performance by Game Length</span>
						<div class="stat-pill-sub">Short Games (&lt; 30 moves): <strong>@_currentReport.LengthTendencies.ShortGamesCount</strong> games (Score: @_currentReport.LengthTendencies.ShortGamesScore%)</div>
						<div class="stat-pill-sub">Standard Games (30–49 moves): <strong>@_currentReport.LengthTendencies.MediumGamesCount</strong> games (Score: @_currentReport.LengthTendencies.MediumGamesScore%)</div>
						<div class="stat-pill-sub">Deep Endgames (50+ moves): <strong>@_currentReport.LengthTendencies.LongGamesCount</strong> games (Score: @_currentReport.LengthTendencies.LongGamesScore%)</div>
					</div>
				</div>
			}

			<!-- Section 4: Games Archive -->
			@if (_activeSection == "games")
			{
				<div class="dossier-games-table-wrapper">
					<div class="games-archive-header">
						<div class="games-archive-title">
							<span>🗄️</span>
							<span>Games Archive (@_currentReport.RecentGames.Count)</span>
							@if (_selectedGameIds.Count > 0)
							{
								<span class="games-selected-badge">(@_selectedGameIds.Count selected)</span>
							}
						</div>
						<div class="games-archive-actions">
							<button class="dossier-action-btn" @onclick="OpenExportModal">
								<span>💾</span>
								<span>Export Games (@SelectedGamesCount)</span>
							</button>
						</div>
					</div>

					<table class="dossier-games-table">
						<thead>
							<tr>
								<th class="col-checkbox">
									<input type="checkbox" checked="@AllGamesSelected" @onchange="ToggleSelectAllGames" title="Select / deselect all games" />
								</th>
								<th>Date</th>
								<th>White</th>
								<th>Black</th>
								<th>Result</th>
								<th>ECO</th>
								<th>Moves</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var g in _currentReport.RecentGames)
							{
								bool isRowSelected = _selectedGameIds.Contains(g.Id);
								<tr class="@(isRowSelected ? "row-selected" : "")">
									<td class="col-checkbox">
										<input type="checkbox" checked="@isRowSelected" @onchange="() => ToggleGameSelection(g.Id)" />
									</td>
									<td>@g.FormattedDate</td>
									<td>@g.White @(g.WhiteElo.HasValue ? $"({g.WhiteElo})" : "")</td>
									<td>@g.Black @(g.BlackElo.HasValue ? $"({g.BlackElo})" : "")</td>
									<td>
										<span class="@GetResultClass(g.Result)">@g.Result</span>
									</td>
									<td><strong>@g.Eco</strong></td>
									<td>@(g.PlyCount > 0 ? (g.PlyCount / 2).ToString() : "-")</td>
									<td>
										<button class="game-action-btn" @onclick="() => OpenGameInAnalysis(g)">
											Analyze
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			<!-- Section 5: OTB Tournaments (Chess-Results) -->
			@if (_activeSection == "tournaments")
			{
				<div class="tournaments-table-wrapper">
					<div class="tournaments-header-row">
						<div class="tournaments-header-title">
							<span>🏆</span>
							<span>Recent Tournament Appearances &amp; Pairings (Chess-Results.com)</span>
						</div>
						<div class="tournaments-header-actions">
							<button class="dossier-action-btn btn-primary" @onclick="FetchChessResultsGamesAsync" disabled="@_isFetchingChessResults">
								<span>⬇️</span>
								<span>@(_isFetchingChessResults ? "Importing Games..." : "Download Games from Chess-Results")</span>
							</button>
							@if (_currentReport.FideCard != null && !string.IsNullOrEmpty(_currentReport.FideCard.ProfileUrl))
							{
								<a href="@_currentReport.FideCard.ProfileUrl" target="_blank" class="fide-profile-link" title="Open Official FIDE Profile">
									<span>🔗 FIDE Profile ↗</span>
								</a>
							}
						</div>
					</div>

					@if (_currentReport.RecentTournaments == null || _currentReport.RecentTournaments.Count == 0)
					{
						<div class="dossier-empty-state">
							<div class="empty-state-title">No Tournament Records Found</div>
							<div class="empty-state-desc">
								No recent tournament entries were found on Chess-Results for this player.
							</div>
						</div>
					}
					else
					{
						<table class="branch-lines-table">
							<thead>
								<tr>
									<th>End Date</th>
									<th>Tournament</th>
									<th>Club / Team</th>
									<th>Rounds</th>
									<th>Score / Rank</th>
									<th>Players</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var tour in _currentReport.RecentTournaments)
								{
									<tr>
										<td>@tour.EndDate</td>
										<td><strong>@tour.TournamentName</strong></td>
										<td>@(string.IsNullOrEmpty(tour.Club) ? "-" : tour.Club)</td>
										<td>@tour.Rounds</td>
										<td><span class="result-tag-win">@tour.ScoreOrRank</span></td>
										<td>@tour.TotalPlayers</td>
										<td>
											@if (!string.IsNullOrEmpty(tour.PlayerCardUrl))
											{
												<a href="@tour.PlayerCardUrl" target="_blank" class="tournament-link" title="View player pairing card on Chess-Results">
													<span>Pairing Card ↗</span>
												</a>
											}
											else if (!string.IsNullOrEmpty(tour.TournamentUrl))
											{
												<a href="@tour.TournamentUrl" target="_blank" class="tournament-link" title="View tournament on Chess-Results">
													<span>Tournament ↗</span>
												</a>
											}
											else
											{
												<span>-</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			}
		</div>
	}
</div>

<!-- Fetch Online Modal -->
@if (_showOnlineFetchModal)
{
	<div class="fetch-modal-overlay" @onclick="() => _showOnlineFetchModal = false">
		<div class="fetch-modal-content" @onclick:stopPropagation>
			<h3 class="modal-title">Fetch Opponent Games Online</h3>
			<p class="modal-desc">Download games from Lichess, Chess.com, or Chess-Results.com for instant scouting.</p>

			<div class="modal-form-row">
				<label class="field-label">Platform / Source</label>
				<select class="modal-input" @bind="_fetchPlatform">
					<option value="Lichess">Lichess</option>
					<option value="Chess.com">Chess.com</option>
					<option value="Chess-Results">Chess-Results (OTB Tournaments)</option>
				</select>
			</div>

			<div class="modal-form-row">
				<label class="field-label">Player Username</label>
				<input class="modal-input" placeholder="e.g. DrNykterstein, MagnusCarlsen" @bind="_fetchUsername" />
			</div>

			<div class="modal-form-row">
				<label class="field-label">Target Database</label>
				<select class="modal-input" @bind="_fetchTargetDb">
					@foreach (var db in _databases.Where(d => !string.Equals(d.Name, "My online games", StringComparison.OrdinalIgnoreCase)))
					{
						<option value="@db.Name">@db.Name (@db.GameCount games)</option>
					}
				</select>
			</div>

			@if (!string.IsNullOrEmpty(_fetchStatus))
			{
				<div class="stat-pill-sub">@_fetchStatus</div>
			}

			<div class="modal-actions">
				<button class="dossier-action-btn" @onclick="() => _showOnlineFetchModal = false">Cancel</button>
				<button class="dossier-action-btn btn-primary" @onclick="FetchOnlineAsync" disabled="@_isFetchingOnline">
					@(_isFetchingOnline ? "Fetching..." : "Download & Scout")
				</button>
			</div>
		</div>
	</div>
}

<!-- Export Games to Database Modal -->
@if (_showExportModal && _currentReport != null)
{
	<div class="fetch-modal-overlay" @onclick="() => _showExportModal = false">
		<div class="fetch-modal-content export-games-modal-content" @onclick:stopPropagation>
			<h3 class="modal-title">💾 Export Games to Database</h3>
			<p class="modal-desc">
				Export @SelectedGamesCount @(SelectedGamesCount == 1 ? "game" : "games") of <strong>@_currentReport.PlayerName</strong> into a database.
			</p>

			<div class="save-mode-container">
				<span class="save-mode-title">Destination</span>
				<div class="save-mode-options">
					<label class="save-mode-label">
						<input type="radio" name="exportMode" value="new" checked="@(_exportMode == "new")" @onchange='() => _exportMode = "new"' />
						<div class="save-mode-text-col">
							<strong>Create a new database</strong>
							<span class="save-mode-desc">Create a new standalone database for this opponent</span>
						</div>
					</label>

					@if (_exportMode == "new")
					{
						<div class="export-nested-input">
							<input class="modal-input" placeholder="e.g. Opponent: @_currentReport.PlayerName" @bind="_exportNewDbName" />
						</div>
					}

					<label class="save-mode-label">
						<input type="radio" name="exportMode" value="existing" checked="@(_exportMode == "existing")" @onchange='() => _exportMode = "existing"' />
						<div class="save-mode-text-col">
							<strong>Save into existing database</strong>
							<span class="save-mode-desc">Append games to an existing database collection</span>
						</div>
					</label>

					@if (_exportMode == "existing")
					{
						<div class="export-nested-input">
							<select class="modal-input" @bind="_exportTargetDb">
								@foreach (var db in _databases.Where(d => !string.Equals(d.Name, "My online games", StringComparison.OrdinalIgnoreCase)))
								{
									<option value="@db.Name">@db.Name (@db.GameCount games)</option>
								}
							</select>
						</div>
					}
				</div>
			</div>

			@if (!string.IsNullOrEmpty(_exportStatus))
			{
				<div class="stat-pill-sub @(_exportSuccess ? "export-status-success" : "export-status-error")">@_exportStatus</div>
			}

			<div class="modal-actions">
				<button class="dossier-action-btn" @onclick="() => _showExportModal = false">
					@(_exportSuccess ? "Close" : "Cancel")
				</button>
				@if (_exportSuccess && !string.IsNullOrEmpty(_lastExportedDb))
				{
					<button class="dossier-action-btn btn-primary" @onclick="OpenExportedDatabase">
						<span>🗄️ Open '@_lastExportedDb'</span>
					</button>
				}
				else
				{
					<button class="dossier-action-btn btn-primary" @onclick="ExecuteExportGamesAsync" disabled="@_isExporting">
						@(_isExporting ? "Exporting..." : "Export Games")
					</button>
				}
			</div>
		</div>
	</div>
}

@code {
	[Parameter] public OpponentDossierTab Tab { get; set; } = default!;

	private string _searchMode = "local"; // "local" or "fide"
	private string _searchQuery = "";
	private List<string> _suggestions = new();
	private List<FideSearchResult> _fideSuggestions = new();
	private bool _showSuggestions = false;

	private List<DatabaseInfo> _databases = new();
	private string _selectedDb = "";

	private bool _isLoading = false;
	private OpponentScoutingReport? _currentReport;
	private string _activeSection = "white";

	// Game selection state
	private HashSet<long> _selectedGameIds = new();

	// Export Modal state
	private bool _showExportModal = false;
	private string _exportMode = "new";
	private string _exportTargetDb = "";
	private string _exportNewDbName = "";
	private string _exportStatus = "";
	private bool _exportSuccess = false;
	private string _lastExportedDb = "";
	private bool _isExporting = false;

	// Online Fetch state
	private bool _showOnlineFetchModal = false;
	private string _fetchPlatform = "Lichess";
	private string _fetchUsername = "";
	private string _fetchTargetDb = "";
	private bool _isFetchingOnline = false;
	private bool _isFetchingChessResults = false;
	private string _fetchStatus = "";

	private bool AllGamesSelected => _currentReport?.RecentGames.Count > 0 && _selectedGameIds.Count == _currentReport.RecentGames.Count;
	private int SelectedGamesCount => _selectedGameIds.Count > 0 ? _selectedGameIds.Count : (_currentReport?.RecentGames.Count ?? 0);

	private void ToggleSelectAllGames()
	{
		if (_currentReport == null) return;
		if (AllGamesSelected)
		{
			_selectedGameIds.Clear();
		}
		else
		{
			_selectedGameIds = _currentReport.RecentGames.Select(g => g.Id).ToHashSet();
		}
	}

	private void ToggleGameSelection(long gameId)
	{
		if (!_selectedGameIds.Remove(gameId))
		{
			_selectedGameIds.Add(gameId);
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadDatabasesAsync();

		if (!string.IsNullOrEmpty(Tab.TargetPlayer))
		{
			_searchQuery = Tab.TargetPlayer;
			if (_searchQuery.All(char.IsDigit))
			{
				_searchMode = "fide";
			}
			await SearchPlayerAsync(_searchQuery);
		}
	}

	private void SetSearchMode(string mode)
	{
		_searchMode = mode;
		_showSuggestions = false;
	}

	private async Task LoadDatabasesAsync()
	{
		_databases = await DatabaseService.GetDatabasesAsync();
		var active = await DatabaseService.GetActiveDatabaseAsync();
		if (string.IsNullOrEmpty(_selectedDb))
		{
			_selectedDb = active.Name;
		}

		var safeDb = _databases.FirstOrDefault(d => !string.Equals(d.Name, "My online games", StringComparison.OrdinalIgnoreCase));
		if (string.IsNullOrEmpty(_exportTargetDb) && safeDb != null)
		{
			_exportTargetDb = safeDb.Name;
		}
		if (string.IsNullOrEmpty(_fetchTargetDb) && safeDb != null)
		{
			_fetchTargetDb = safeDb.Name;
		}
	}

	private async Task HandleDbChanged(ChangeEventArgs e)
	{
		_selectedDb = e.Value?.ToString() ?? "";
		if (!string.IsNullOrWhiteSpace(_searchQuery))
		{
			await SearchPlayerAsync(_searchQuery);
		}
	}

	private async Task HandleKeyUp(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			_showSuggestions = false;
			await SearchPlayerAsync(_searchQuery);
			return;
		}

		string query = _searchQuery.Trim();
		if (query.Length >= 2)
		{
			if (_searchMode == "fide" || query.All(char.IsDigit))
			{
				if (query.All(char.IsDigit))
				{
					_showSuggestions = false;
				}
				else
				{
					_fideSuggestions = await DossierService.SearchFidePlayersAsync(query);
					_showSuggestions = _fideSuggestions.Count > 0;
				}
			}
			else
			{
				_suggestions = await DossierService.SearchKnownPlayersAsync(query, _selectedDb);
				_showSuggestions = _suggestions.Count > 0;
			}
		}
		else
		{
			_showSuggestions = false;
		}
	}

	private async Task SelectPlayer(string player)
	{
		_searchQuery = player;
		_showSuggestions = false;
		await SearchPlayerAsync(player);
	}

	private async Task SelectFidePlayer(FideSearchResult player)
	{
		_searchQuery = player.FideId;
		_showSuggestions = false;
		await SearchPlayerAsync(player.FideId);
	}

	private async Task SearchPlayerAsync(string playerName)
	{
		if (string.IsNullOrWhiteSpace(playerName)) return;

		_isLoading = true;
		_showSuggestions = false;
		Tab.TargetPlayer = playerName.Trim();
		StateHasChanged();

		try
		{
			_currentReport = await DossierService.GenerateDossierAsync(playerName.Trim(), _selectedDb);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[OpponentDossier] Error generating report: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task LoadGameById(long gameId)
	{
		var game = await DatabaseService.GetGameByIdAsync(_selectedDb, gameId);
		if (game != null)
		{
			OpenGameInAnalysis(game);
		}
	}

	private void OpenGameInAnalysis(GameHeader game)
	{
		string title = $"{game.White} vs {game.Black} ({game.FormattedDate})";
		Workspace.CreateAnalysisTab(title: title, pgn: game.Pgn, targetDatabase: _selectedDb, databaseGameId: game.Id);
	}

	private void OpenOnlineFetchModal()
	{
		if (_currentReport != null)
		{
			_fetchUsername = _currentReport.FideCard?.FideId ?? _currentReport.PlayerName;
		}
		_fetchStatus = "";
		_showOnlineFetchModal = true;
	}

	private async Task FetchChessResultsGamesAsync()
	{
		if (_currentReport == null) return;
		string? fideId = _currentReport.FideCard?.FideId;
		string lastName = OpponentDossierService.ExtractLastName(_currentReport.PlayerName);

		_isFetchingChessResults = true;
		_fetchStatus = "Connecting to Chess-Results...";
		StateHasChanged();
		try
		{
			string? safeTarget = !string.Equals(_selectedDb, "My online games", StringComparison.OrdinalIgnoreCase) ? _selectedDb : null;
			var result = await DossierService.FetchChessResultsGamesAsync(fideId, lastName, targetDatabase: safeTarget);
			if (result.Errors.Count > 0)
			{
				_fetchStatus = string.Join(" ", result.Errors);
			}
			else
			{
				_fetchStatus = $"Imported {result.TotalImported} games from Chess-Results!";
				await SearchPlayerAsync(_searchQuery);
			}
		}
		catch (Exception ex)
		{
			_fetchStatus = $"Error: {ex.Message}";
		}
		finally
		{
			_isFetchingChessResults = false;
			StateHasChanged();
		}
	}

	private async Task FetchOnlineAsync()
	{
		if (string.IsNullOrWhiteSpace(_fetchUsername)) return;

		_isFetchingOnline = true;
		_fetchStatus = $"Connecting to {_fetchPlatform} for '{_fetchUsername}'...";
		StateHasChanged();

		try
		{
			string? safeTarget = !string.Equals(_fetchTargetDb, "My online games", StringComparison.OrdinalIgnoreCase) ? _fetchTargetDb : null;

			if (_fetchPlatform == "Chess-Results")
			{
				string? fideId = _fetchUsername.Trim().All(char.IsDigit) ? _fetchUsername.Trim() : null;
				string lastName = fideId == null ? OpponentDossierService.ExtractLastName(_fetchUsername) : "";
				var result = await DossierService.FetchChessResultsGamesAsync(fideId, lastName, targetDatabase: safeTarget);
				if (result.Errors.Count > 0)
				{
					_fetchStatus = string.Join(" ", result.Errors);
				}
				else
				{
					_fetchStatus = $"Imported {result.TotalImported} games from Chess-Results!";
					_showOnlineFetchModal = false;
					_searchQuery = _fetchUsername;
					await SearchPlayerAsync(_fetchUsername);
				}
			}
			else
			{
				var result = await DossierService.FetchOnlineOpponentGamesAsync(_fetchPlatform, _fetchUsername, maxGames: 60, targetDatabase: safeTarget);
				if (result.Errors.Count > 0)
				{
					_fetchStatus = string.Join(" ", result.Errors);
				}
				else
				{
					_fetchStatus = $"Imported {result.TotalImported} games!";
					_showOnlineFetchModal = false;
					_searchQuery = _fetchUsername;
					await SearchPlayerAsync(_fetchUsername);
				}
			}
		}
		catch (Exception ex)
		{
			_fetchStatus = $"Error: {ex.Message}";
		}
		finally
		{
			_isFetchingOnline = false;
			StateHasChanged();
		}
	}

	private static string GetTitleBadgeClass(string? title)
	{
		if (string.IsNullOrEmpty(title)) return "";
		string upper = title.ToUpperInvariant();
		if (upper.Contains("WGM")) return "badge-wgm";
		if (upper.Contains("WIM")) return "badge-wim";
		if (upper.Contains("WFM")) return "badge-wfm";
		if (upper.Contains("WCM")) return "badge-wcm";
		if (upper.Contains("GM") || upper.Contains("GRANDMASTER")) return "badge-gm";
		if (upper.Contains("IM") || upper.Contains("INTERNATIONAL MASTER")) return "badge-im";
		if (upper.Contains("FM") || upper.Contains("FIDE MASTER")) return "badge-fm";
		if (upper.Contains("CM") || upper.Contains("CANDIDATE MASTER")) return "badge-cm";
		return "badge-fm";
	}

	private void OpenExportModal()
	{
		if (_currentReport == null || _currentReport.RecentGames.Count == 0) return;
		_exportMode = "new";
		_exportNewDbName = $"Opponent - {_currentReport.PlayerName}";
		var safeDb = _databases.FirstOrDefault(d => !string.Equals(d.Name, "My online games", StringComparison.OrdinalIgnoreCase));
		_exportTargetDb = safeDb?.Name ?? "";
		_exportStatus = "";
		_exportSuccess = false;
		_lastExportedDb = "";
		_showExportModal = true;
	}

	private async Task ExecuteExportGamesAsync()
	{
		if (_currentReport == null || _currentReport.RecentGames.Count == 0) return;

		List<GameHeader> gamesToExport;
		if (_selectedGameIds.Count > 0)
		{
			gamesToExport = _currentReport.RecentGames.Where(g => _selectedGameIds.Contains(g.Id)).ToList();
		}
		else
		{
			gamesToExport = _currentReport.RecentGames;
		}

		if (gamesToExport.Count == 0)
		{
			_exportStatus = "No games selected to export.";
			_exportSuccess = false;
			return;
		}

		_isExporting = true;
		_exportStatus = "Exporting games...";
		_exportSuccess = false;
		StateHasChanged();

		try
		{
			string targetDb = "";
			if (_exportMode == "new")
			{
				string newDbName = _exportNewDbName.Trim();
				if (string.IsNullOrWhiteSpace(newDbName))
				{
					newDbName = $"Opponent - {_currentReport.PlayerName}";
				}

				if (string.Equals(newDbName, "My online games", StringComparison.OrdinalIgnoreCase))
				{
					_exportStatus = "Cannot use protected database name 'My online games'.";
					_exportSuccess = false;
					return;
				}

				var created = await DatabaseService.CreateDatabaseAsync(newDbName);
				targetDb = created.Name;
				await LoadDatabasesAsync();
			}
			else
			{
				targetDb = _exportTargetDb;
				if (string.IsNullOrWhiteSpace(targetDb) || string.Equals(targetDb, "My online games", StringComparison.OrdinalIgnoreCase))
				{
					var safeDbs = _databases.Where(d => !string.Equals(d.Name, "My online games", StringComparison.OrdinalIgnoreCase)).ToList();
					targetDb = safeDbs.FirstOrDefault()?.Name ?? "Scouted Games";
				}
			}

			var sb = new System.Text.StringBuilder();
			foreach (var g in gamesToExport)
			{
				sb.AppendLine(g.Pgn);
				sb.AppendLine();
			}

			string pgnText = sb.ToString();
			await DatabaseService.ImportPgnTextAsync(targetDb, pgnText, deduplicate: true);

			_lastExportedDb = targetDb;
			_exportSuccess = true;
			_exportStatus = $"Successfully exported {gamesToExport.Count} games to '{targetDb}'!";
			await LoadDatabasesAsync();
		}
		catch (Exception ex)
		{
			_exportStatus = $"Export error: {ex.Message}";
			_exportSuccess = false;
		}
		finally
		{
			_isExporting = false;
			StateHasChanged();
		}
	}

	private void OpenExportedDatabase()
	{
		_showExportModal = false;
		if (!string.IsNullOrEmpty(_lastExportedDb))
		{
			Workspace.CreateDatabaseTab(_lastExportedDb);
		}
	}

	private static string GetResultClass(string result) => result switch
	{
		"1-0" => "result-tag-win",
		"0-1" => "result-tag-loss",
		"1/2-1/2" => "result-tag-draw",
		_ => ""
	};

	private static RenderFragment RenderRatioBar(int wins, int draws, int losses, int total) => builder =>
	{
		if (total <= 0) return;
		double wPct = Math.Round(wins * 100.0 / total, 1);
		double dPct = Math.Round(draws * 100.0 / total, 1);
		double lPct = Math.Max(0.0, 100.0 - wPct - dPct);

		builder.OpenElement(0, "svg");
		builder.AddAttribute(1, "class", "ratio-svg");
		builder.AddAttribute(2, "viewBox", "0 0 100 6");
		builder.AddAttribute(3, "preserveAspectRatio", "none");

		int seq = 4;
		if (wPct > 0)
		{
			builder.OpenElement(seq++, "rect");
			builder.AddAttribute(seq++, "x", "0");
			builder.AddAttribute(seq++, "y", "0");
			builder.AddAttribute(seq++, "width", wPct.ToString(System.Globalization.CultureInfo.InvariantCulture));
			builder.AddAttribute(seq++, "height", "6");
			builder.AddAttribute(seq++, "class", "bar-win");
			builder.CloseElement();
		}
		if (dPct > 0)
		{
			builder.OpenElement(seq++, "rect");
			builder.AddAttribute(seq++, "x", wPct.ToString(System.Globalization.CultureInfo.InvariantCulture));
			builder.AddAttribute(seq++, "y", "0");
			builder.AddAttribute(seq++, "width", dPct.ToString(System.Globalization.CultureInfo.InvariantCulture));
			builder.AddAttribute(seq++, "height", "6");
			builder.AddAttribute(seq++, "class", "bar-draw");
			builder.CloseElement();
		}
		if (lPct > 0)
		{
			builder.OpenElement(seq++, "rect");
			builder.AddAttribute(seq++, "x", (wPct + dPct).ToString(System.Globalization.CultureInfo.InvariantCulture));
			builder.AddAttribute(seq++, "y", "0");
			builder.AddAttribute(seq++, "width", lPct.ToString(System.Globalization.CultureInfo.InvariantCulture));
			builder.AddAttribute(seq++, "height", "6");
			builder.AddAttribute(seq++, "class", "bar-loss");
			builder.CloseElement();
		}

		builder.CloseElement(); // svg
	};

	public void Dispose()
	{
	}
}
