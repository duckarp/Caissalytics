@page "/"
@namespace Caissalytics.Components.Pages
@using Caissalytics.Components.Layout
@using Caissalytics.Components.Dashboard
@using Caissalytics.Components.Analysis
@using Caissalytics.Components.Database
@using Caissalytics.Components.Settings
@using Caissalytics.Components.Analytics
@using Caissalytics.Components.Puzzles
@using Caissalytics.Components.Repertoire
@using Caissalytics.Components.Dossier
@using Caissalytics.Components.Endgames
@using Caissalytics.Components.Homework
@using Caissalytics.Components.Messages
@using Caissalytics.Components.Practice
@inject WorkspaceState Workspace
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Caissalytics - Chess Analysis & Database</PageTitle>

@if (!_isStorageLoaded)
{
	<div class="workspace-loading">
		<div class="workspace-loading-spinner"></div>
		<div class="workspace-loading-text">App is loading, please wait...</div>
	</div>
}
else
{
	<WorkspaceTabs />

	<div class="workspace-view-container">
		<div class="@(Workspace.ActiveTab is DashboardTab ? "workspace-view" : "workspace-view view-hidden")">
			<DashboardHub />
		</div>

		@foreach (var tab in Workspace.Tabs.OfType<AnalysisTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<AnalysisWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<DatabaseBrowserTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<DatabaseBrowser Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<SettingsTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<SettingsControlCenter Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<AnalyticsTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<PersonalAnalyticsDashboard Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<PuzzleTrainerTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<PuzzleWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<RepertoireExplorerTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<RepertoireWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<OpponentDossierTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<OpponentDossierWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<EndgameTrainerTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<EndgameTrainerWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<PracticeTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<PracticeWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<HomeworkTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<HomeworkWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<ClubHomeworkTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<ClubHomeworkWorkbench Tab="tab" />
			</TabPane>
		}

		@foreach (var tab in Workspace.Tabs.OfType<ClubMessagesTab>())
		{
			bool isActive = tab == Workspace.ActiveTab;
			<TabPane @key="tab.Id" IsActive="isActive">
				<ClubMessagesWorkbench Tab="tab" />
			</TabPane>
		}
	</div>
}

@code {
	private IJSObjectReference? _storageModule;
	private bool _isStorageLoaded = false;
	private bool _isAutosaveEnabled = false;
	private CancellationTokenSource? _saveDebounceCts;
	private bool _isDirty = false;

	protected override void OnInitialized()
	{
		Workspace.OnChange += HandleWorkspaceChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			bool safeToSave = false;
			try
			{
				_storageModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/workspaceStorage.js");
				using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
				string? json = await _storageModule.InvokeAsync<string?>("loadWorkspaceState", cts.Token);
				safeToSave = string.IsNullOrWhiteSpace(json) || Workspace.RestoreStateFromJson(json);
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Error restoring workspace: {ex.Message}");
			}

			if (!safeToSave && _storageModule != null)
			{
				// Restore failed: keep a copy of the stored workspace before autosave replaces it
				try
				{
					safeToSave = await _storageModule.InvokeAsync<bool>("backupWorkspaceState");
				}
				catch (Exception ex)
				{
					Console.WriteLine($"Error backing up workspace: {ex.Message}");
				}
			}

			// Autosave stays off when the stored workspace could be neither restored nor backed up
			_isStorageLoaded = true;
			_isAutosaveEnabled = safeToSave;
			await InvokeAsync(StateHasChanged);
		}

		await SyncActiveTabToKeyboardInteropAsync();
	}

	private Guid? _keyboardActiveTabId;

	// Board workbenches register keyboard listeners per tab and stay mounted while hidden;
	// the script needs the visible tab so it doesn't swallow keys on other tabs.
	private async Task SyncActiveTabToKeyboardInteropAsync()
	{
		var activeId = Workspace.ActiveTab?.Id;
		if (activeId == null || activeId == _keyboardActiveTabId) return;
		try
		{
			await JS.InvokeVoidAsync("notationInterop.setActiveTab", activeId.Value.ToString("N"));
			_keyboardActiveTabId = activeId;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error syncing active tab to keyboard interop: {ex.Message}");
		}
	}

	private void HandleWorkspaceChanged()
	{
		InvokeAsync(StateHasChanged);

		if (_isAutosaveEnabled)
		{
			_isDirty = true;
			DebounceSave();
		}
	}

	private void DebounceSave()
	{
		_saveDebounceCts?.Cancel();
		_saveDebounceCts?.Dispose();
		_saveDebounceCts = new CancellationTokenSource();
		var token = _saveDebounceCts.Token;

		_ = Task.Run(async () =>
		{
			try
			{
				await Task.Delay(250, token);
				if (!token.IsCancellationRequested && _storageModule != null)
				{
					// Snapshot on the renderer's thread: the UI mutates tabs and game trees there
					string json = "";
					await InvokeAsync(() => json = Workspace.ExportStateJson());
					bool saved = await _storageModule.InvokeAsync<bool>("saveWorkspaceState", json);
					if (saved)
					{
						_isDirty = false;
					}
					else
					{
						Console.Error.WriteLine($"Workspace could not be saved to browser storage ({json.Length:N0} characters); it may be over the storage quota.");
					}
				}
			}
			catch (OperationCanceledException) { }
			catch (Exception ex)
			{
				Console.WriteLine($"Error auto-saving workspace: {ex.Message}");
			}
		}, token);
	}

	public async ValueTask DisposeAsync()
	{
		Workspace.OnChange -= HandleWorkspaceChanged;

		if (_saveDebounceCts != null)
		{
			_saveDebounceCts.Cancel();
			_saveDebounceCts.Dispose();
		}

		if (_isDirty && _storageModule != null)
		{
			try
			{
				string json = Workspace.ExportStateJson();
				await _storageModule.InvokeVoidAsync("saveWorkspaceState", json);
			}
			catch { }
		}

		if (_storageModule != null)
		{
			try
			{
				await _storageModule.DisposeAsync();
			}
			catch { }
		}
	}
}
