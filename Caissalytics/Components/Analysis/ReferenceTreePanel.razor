@namespace Caissalytics.Components.Analysis
@using Caissalytics.Core
@using Caissalytics.Data
@using Caissalytics.Components.Database
@inject IDatabaseService DatabaseService
@inject IUserProfileService ProfileService
@inject IRepertoireService RepertoireService
@implements IDisposable

<div class="reference-panel">
	<div class="reference-toolbar">
		<div class="reference-toolbar-left">
			<span class="reference-db-label">Database:</span>
			<select class="reference-db-select" value="@_selectedDb" @onchange="HandleDatabaseSelected">
				@foreach (var db in _databases)
				{
					<option value="@db.Name">@db.Name @(db.IsReference ? "⭐ [Ref]" : "") (@db.GameCount games)</option>
				}
			</select>
		</div>

		<div class="reference-games-count">
			@(_refResult?.TotalPositionGames ?? 0) games
		</div>
	</div>

	<div class="reference-content">
		<div class="reference-section-header">
			<span>Candidate Moves</span>
			<span>Win / Draw / Loss</span>
		</div>

		<div class="reference-table-wrapper">
			@if (_isLoading)
			{
				<div class="reference-empty-state">
					<span>Loading reference statistics...</span>
				</div>
			}
			else if (_refResult == null || _refResult.CandidateMoves.Count == 0)
			{
				<div class="reference-empty-state">
					<span class="empty-state-icon">📖</span>
					<span>No database games found for this position.</span>
				</div>
			}
			else
			{
				<table class="reference-table">
					<thead>
						<tr>
							<th>Rep</th>
							<th>Move</th>
							<th>Games</th>
							<th>Score</th>
							<th>Distribution</th>
							<th>Avg Elo</th>
							<th>Years</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var move in _refResult.CandidateMoves)
						{
							<tr class="reference-row @(move.IsRepertoireMove ? "in-repertoire" : "")" @onclick="() => PlayCandidateMove(move.MoveSan)">
								<td>
									<button class="star-bookmark-btn @(move.IsRepertoireMove ? "bookmarked" : "")"
											title="@(move.IsRepertoireMove ? $"In Repertoire ({move.RepertoireStatus})" : "Add to repertoire")"
											@onclick:stopPropagation="true"
											@onclick="() => ToggleRepertoireMove(move)">
										@(move.IsRepertoireMove ? "★" : "☆")
									</button>
								</td>
								<td class="move-cell">@move.MoveSan</td>
								<td class="number-cell">@move.TotalGames.ToString("N0")</td>
								<td class="score-cell">@move.ScoreRate.ToString("0.0")%</td>
								<td class="bar-cell">
									<div class="winrate-bar-track" title="White: @move.WhiteWinRate.ToString("0.0")% | Draw: @move.DrawRate.ToString("0.0")% | Black: @move.BlackWinRate.ToString("0.0")%">
										<div class="bar-segment bar-white @($"bar-w-{move.WhiteWinPct}")"></div>
										<div class="bar-segment bar-draw @($"bar-w-{move.DrawPct}")"></div>
										<div class="bar-segment bar-black @($"bar-w-{move.BlackWinPct}")"></div>
									</div>
								</td>
								<td class="number-cell">@(move.AvgRating.HasValue ? move.AvgRating.Value.ToString() : "-")</td>
								<td class="number-cell">@move.YearRangeFormatted</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<div class="reference-section-header">
			<span>Games in Position (@(_refResult?.TopGames?.Count ?? 0))</span>
			<span>Result</span>
		</div>

		<div class="reference-games-wrapper">
			@if (_refResult?.TopGames != null && _refResult.TopGames.Count > 0)
			{
				@foreach (var game in _refResult.TopGames)
				{
					<div class="ref-game-item" @onclick="() => OpenGame(game)">
						<div class="ref-game-players">
							<div class="ref-player-line">
								<span class="ref-player-name @(_userProfile.MatchesPlayer(game.White) ? "player-name-user" : "")">
									@game.White
									@if (_userProfile.MatchesPlayer(game.White))
									{
										<span class="db-user-tag" title="You (matches your profile)">You</span>
									}
								</span>
								@if (game.WhiteElo.HasValue)
								{
									<span class="ref-player-elo">(@game.WhiteElo)</span>
								}
							</div>
							<div class="ref-player-line">
								<span class="ref-player-name @(_userProfile.MatchesPlayer(game.Black) ? "player-name-user" : "")">
									@game.Black
									@if (_userProfile.MatchesPlayer(game.Black))
									{
										<span class="db-user-tag" title="You (matches your profile)">You</span>
									}
								</span>
								@if (game.BlackElo.HasValue)
								{
									<span class="ref-player-elo">(@game.BlackElo)</span>
								}
							</div>
						</div>

						<div class="ref-game-meta">
							<div class="ref-game-result-row">
								<PlatformIcon Game="game" />
								<span class="ref-result-badge @GetResultClass(game.Result)">@game.Result</span>
							</div>
							<span class="ref-game-submeta">@(string.IsNullOrEmpty(game.Date) ? "Unknown" : game.FormattedDate) @(string.IsNullOrEmpty(game.Eco) ? "" : $"• {game.Eco}")</span>
						</div>
					</div>
				}
			}
			else
			{
				<div class="reference-empty-state">
					<span>No recorded games for this position.</span>
				</div>
			}
		</div>
	</div>
</div>

@code {
	[Parameter, EditorRequired] public BoardPosition Position { get; set; } = default!;
	[Parameter] public string? InitialDatabase { get; set; }
	[Parameter] public EventCallback<string> OnPlayMove { get; set; }
	[Parameter] public EventCallback<GameHeader> OnOpenGame { get; set; }

	private List<DatabaseInfo> _databases = new();
	private string _selectedDb = "";
	private PositionReferenceResult? _refResult;
	private ulong _lastZobristKey = 0;
	private bool _isLoading = false;
	private UserProfile _userProfile = new();

	protected override async Task OnInitializedAsync()
	{
		DatabaseService.OnActiveDatabaseChanged += HandleActiveDatabaseChanged;
		DatabaseService.OnReferenceDatabaseChanged += HandleReferenceDatabaseChanged;
		ProfileService.OnProfileChanged += HandleProfileChanged;
		await LoadProfileAsync();

		if (!string.IsNullOrWhiteSpace(InitialDatabase))
		{
			_selectedDb = InitialDatabase;
		}

		await RefreshDatabasesAsync();
	}

	private async Task LoadProfileAsync()
	{
		_userProfile = await ProfileService.GetProfileAsync();
	}

	private async void HandleProfileChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadProfileAsync();
			StateHasChanged();
		});
	}

	protected override async Task OnParametersSetAsync()
	{
		if (Position != null && (Position.ZobristKey != _lastZobristKey || _refResult == null))
		{
			_lastZobristKey = Position.ZobristKey;
			await QueryPositionStatsAsync();
		}
	}

	private async Task RefreshDatabasesAsync()
	{
		_databases = await DatabaseService.GetDatabasesAsync();
		if (string.IsNullOrEmpty(_selectedDb) || !_databases.Any(d => string.Equals(d.Name, _selectedDb, StringComparison.OrdinalIgnoreCase)))
		{
			var matchInit = !string.IsNullOrWhiteSpace(InitialDatabase) 
				? _databases.FirstOrDefault(d => string.Equals(d.Name, InitialDatabase, StringComparison.OrdinalIgnoreCase))
				: null;

			var refDb = matchInit
			            ?? _databases.FirstOrDefault(d => d.IsReference) 
			            ?? _databases.FirstOrDefault(d => d.IsActive) 
			            ?? _databases.FirstOrDefault();
			if (refDb != null)
			{
				_selectedDb = refDb.Name;
			}
		}
		await QueryPositionStatsAsync();
	}

	private async Task QueryPositionStatsAsync()
	{
		if (Position == null) return;

		_isLoading = true;
		try
		{
			_refResult = await DatabaseService.QueryPositionAsync(_selectedDb, Position.ZobristKey);
			await AnnotateCandidateMovesAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ReferenceTreePanel] Query error: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task AnnotateCandidateMovesAsync()
	{
		if (_refResult == null || Position == null) return;

		string fen = RepertoireService.NormalizeFen(FenParser.ToFen(Position));
		string turnColor = Position.ActiveColor == PieceColor.White ? "white" : "black";
		var repMoves = await RepertoireService.GetMovesForPositionAsync(fen, turnColor);

		foreach (var m in _refResult.CandidateMoves)
		{
			var match = repMoves.FirstOrDefault(rm => string.Equals(rm.MoveSan, m.MoveSan, StringComparison.OrdinalIgnoreCase));
			if (match != null)
			{
				m.IsRepertoireMove = true;
				m.RepertoireStatus = match.Status;
				m.RepertoireNote = match.Note;
			}
			else
			{
				m.IsRepertoireMove = false;
				m.RepertoireStatus = null;
				m.RepertoireNote = null;
			}
		}
	}

	private async Task ToggleRepertoireMove(PositionMoveStat move)
	{
		if (Position == null) return;
		string fen = RepertoireService.NormalizeFen(FenParser.ToFen(Position));
		string color = Position.ActiveColor == PieceColor.White ? "white" : "black";

		if (move.IsRepertoireMove)
		{
			await RepertoireService.RemoveMoveAsync(fen, move.MoveSan, color);
		}
		else
		{
			await RepertoireService.AddOrUpdateMoveAsync(new RepertoireMove
			{
				Fen = fen,
				MoveSan = move.MoveSan,
				MoveUci = move.MoveUci,
				Color = color,
				Status = "main"
			});
		}

		await AnnotateCandidateMovesAsync();
		StateHasChanged();
	}

	private async Task HandleDatabaseSelected(ChangeEventArgs e)
	{
		_selectedDb = e.Value?.ToString() ?? "";
		await QueryPositionStatsAsync();
	}

	private async void HandleActiveDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			_databases = await DatabaseService.GetDatabasesAsync();
			StateHasChanged();
		});
	}

	private async void HandleReferenceDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			await RefreshDatabasesAsync();
			StateHasChanged();
		});
	}

	private async Task PlayCandidateMove(string moveSan)
	{
		if (OnPlayMove.HasDelegate)
		{
			await OnPlayMove.InvokeAsync(moveSan);
		}
	}

	private async Task OpenGame(GameHeader game)
	{
		if (OnOpenGame.HasDelegate)
		{
			await OnOpenGame.InvokeAsync(game);
		}
	}

	private static string GetResultClass(string result)
	{
		return result switch
		{
			"1-0" => "ref-result-white",
			"0-1" => "ref-result-black",
			"1/2-1/2" => "ref-result-draw",
			_ => ""
		};
	}

	public void Dispose()
	{
		DatabaseService.OnActiveDatabaseChanged -= HandleActiveDatabaseChanged;
		DatabaseService.OnReferenceDatabaseChanged -= HandleReferenceDatabaseChanged;
		ProfileService.OnProfileChanged -= HandleProfileChanged;
	}
}
