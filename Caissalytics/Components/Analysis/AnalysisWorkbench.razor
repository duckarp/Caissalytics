@namespace Caissalytics.Components.Analysis
@using Caissalytics.Core
@using Caissalytics.Engine
@using Caissalytics.Data
@using Caissalytics.Components.Board
@inject IEngineService EngineService
@inject ITablebaseService TablebaseService
@inject IJSRuntime JS
@inject WorkspaceState Workspace
@implements IDisposable

<div class="workbench-layout" @onkeydown="HandleGlobalKey" tabindex="0">
	<div class="workbench-left-panel">
		<div class="board-eval-row">
			<ChessgroundBoard @ref="_boardRef"
							  Position="@Tab.Tree.CurrentNode.Position"
							  LastMove="@(Tab.Tree.CurrentNode.IsRoot ? null : Tab.Tree.CurrentNode.Move)"
							  Orientation="@Tab.Orientation"
							  CanGoBack="@Tab.Tree.CanGoBack"
							  CanGoForward="@Tab.Tree.CanGoForward"
							  OnMoveMade="HandleUserMove"
							  OrientationChanged="HandleOrientationChanged"
							  OnFirst="HandleFirst"
							  OnPrev="HandlePrev"
							  OnNext="HandleNext"
							  OnLast="HandleLast"
							  Tree="@Tab.Tree">
				<SideGauge>
					<EvaluationGauge TopLine="@(Tab.CurrentEvalLines.Count > 0 ? Tab.CurrentEvalLines[0] : null)"
									 IsAnalyzing="@Tab.IsAnalyzing" />
				</SideGauge>
			</ChessgroundBoard>
		</div>
	</div>

	<div class="workbench-right-panel">
		<div class="panel-header-tabs">
			<button class="panel-tab-btn @(_activeRightTab == "moves" ? "tab-active" : "")" 
					@onclick="@(() => _activeRightTab = "moves")">@Loc["Analysis_Tab_Moves"]</button>
			<button class="panel-tab-btn @(_activeRightTab == "report" ? "tab-active" : "")" 
					@onclick="@(() => _activeRightTab = "report")">@Loc["Analysis_Tab_Report"]</button>
			<button class="panel-tab-btn @(_activeRightTab == "reference" ? "tab-active" : "")" 
					@onclick="@(() => _activeRightTab = "reference")">@Loc["Analysis_Tab_Reference"]</button>
			@if (TablebaseService.CanProbePosition(Tab.Tree.CurrentNode.Position))
			{
				<button class="panel-tab-btn tb-tab-btn @(_activeRightTab == "tablebase" ? "tab-active" : "")" 
						@onclick="@(() => _activeRightTab = "tablebase")">@Loc["Analysis_Tab_Tablebase"]</button>
			}
			<button class="panel-tab-btn @(_activeRightTab == "tools" ? "tab-active" : "")" 
					@onclick="@(() => _activeRightTab = "tools")">@Loc["Analysis_Tab_Tools"]</button>
			<div class="workbench-header-actions">
				<button class="btn-primary-small" title="Save game to database" @onclick="() => _showSaveModal = true">@Loc["Analysis_SaveToDb"]</button>
			</div>
		</div>

		<div class="panel-body-content">
			@if (_activeRightTab == "moves")
			{
				<div class="panel-top-section">
					<NotationTree Tree="@Tab.Tree" OnSelectNode="HandleSelectNode" />
					<AnnotationPalette ActiveNode="@Tab.Tree.CurrentNode"
									   OnAnnotationChanged="StateHasChanged"
									   OnPromoteVariation="HandlePromoteVariation"
									   OnDeleteSubtree="HandleDeleteSubtree" />
				</div>
			}
			else if (_activeRightTab == "report")
			{
				<div class="panel-top-section report-section-full">
					<GameReportPanel Tab="Tab" />
				</div>
			}
			else if (_activeRightTab == "reference")
			{
				<div class="panel-top-section">
					<ReferenceTreePanel Position="@Tab.Tree.CurrentNode.Position"
										InitialDatabase="@Tab.TargetDatabase"
										OnPlayMove="HandleReferenceMoveSelected"
										OnOpenGame="HandleReferenceGameOpened" />
				</div>
			}
			else if (_activeRightTab == "tablebase")
			{
				<div class="panel-top-section">
					<TablebasePanel Position="@Tab.Tree.CurrentNode.Position"
									OnPlayMove="HandleTablebaseMovePlayed" />
				</div>
			}
			else
			{
				<div class="panel-top-section tools-panel-body">
					<div class="modal-form-group">
						<button class="btn-primary" @onclick="() => _showSaveModal = true">@Loc["Analysis_SaveGameToDb"]</button>
					</div>

					<h3 class="section-title">@Loc["Analysis_GameHeaders"]</h3>
					<div class="headers-grid">
						<span class="header-key">@Loc["Analysis_White"]</span>
						<span class="header-value">@(Tab.Tree.Headers.GetValueOrDefault("White", "White"))</span>
						<span class="header-key">@Loc["Analysis_Black"]</span>
						<span class="header-value">@(Tab.Tree.Headers.GetValueOrDefault("Black", "Black"))</span>
						<span class="header-key">@Loc["Analysis_Event"]</span>
						<span class="header-value">@(Tab.Tree.Headers.GetValueOrDefault("Event", Loc["Analysis_CasualAnalysis"]))</span>
						<span class="header-key">@Loc["Analysis_Result"]</span>
						<span class="header-value">@(Tab.Tree.Headers.GetValueOrDefault("Result", "*"))</span>
					</div>

					<div class="tools-header-row">
						<h3 class="tools-subheading">@Loc["Analysis_Fen"]</h3>
						<button class="btn-copy-action" @onclick="CopyFenAsync" title="Copy FEN to clipboard">
							@(_fenCopied ? Loc["Analysis_Copied"] : Loc["Analysis_CopyFen"])
						</button>
					</div>
					<input class="comment-input-field" readonly value="@FenParser.ToFen(Tab.Tree.CurrentNode.Position)" />

					<div class="tools-header-row">
						<h3 class="tools-subheading">@Loc["Analysis_PgnExport"]</h3>
						<button class="btn-copy-action" @onclick="CopyPgnAsync" title="Copy PGN to clipboard">
							@(_pgnCopied ? Loc["Analysis_Copied"] : Loc["Analysis_CopyPgn"])
						</button>
					</div>
					<textarea class="comment-input-field pgn-export-area" rows="6" readonly>@PgnHandler.ExportPgn(Tab.Tree)</textarea>
				</div>
			}

			@if (_activeRightTab != "report")
			{
				<div class="panel-bottom-section">
					<EngineAnalysisPanel Position="@Tab.Tree.CurrentNode.Position"
										 IsAnalyzing="@Tab.IsAnalyzing"
										 MultiPv="@Tab.MultiPv"
										 EvalLines="@Tab.CurrentEvalLines"
										 IsAnalyzingChanged="HandleAnalyzingToggled"
										 MultiPvChanged="HandleMultiPvChanged"
										 OnInsertPvVariation="HandleInsertPvVariation" />
				</div>
			}
		</div>
	</div>
</div>

<SaveGameDialog IsOpen="_showSaveModal"
				Tree="@Tab.Tree"
				InitialDatabase="@Tab.TargetDatabase"
				ExistingGameId="@Tab.DatabaseGameId"
				OnGameSaved="HandleGameSaved"
				OnClose="() => _showSaveModal = false" />

@code {
	[Parameter, EditorRequired] public AnalysisTab Tab { get; set; } = default!;

	private ChessgroundBoard? _boardRef;
	private string _activeRightTab = "moves";
	private CancellationTokenSource? _engineCts;
	private bool _isDisposed = false;
	private bool _showSaveModal = false;
	private bool _fenCopied = false;
	private bool _pgnCopied = false;

	private async Task CopyFenAsync()
	{
		string fen = FenParser.ToFen(Tab.Tree.CurrentNode.Position);
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", fen);
			_fenCopied = true;
			StateHasChanged();
			_ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() => { _fenCopied = false; StateHasChanged(); }));
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[AnalysisWorkbench] Failed to copy FEN: {ex.Message}");
		}
	}

	private async Task CopyPgnAsync()
	{
		string pgn = PgnHandler.ExportPgn(Tab.Tree);
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", pgn);
			_pgnCopied = true;
			StateHasChanged();
			_ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() => { _pgnCopied = false; StateHasChanged(); }));
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[AnalysisWorkbench] Failed to copy PGN: {ex.Message}");
		}
	}

	private void HandleGameSaved(long gameId)
	{
		Tab.DatabaseGameId = gameId;
		string white = Tab.Tree.Headers.GetValueOrDefault("White", "White");
		string black = Tab.Tree.Headers.GetValueOrDefault("Black", "Black");
		string dateStr = DateHelper.Format(Tab.Tree.Headers.GetValueOrDefault("Date", ""));
		string dateSuffix = string.IsNullOrEmpty(dateStr) ? "" : $" ({dateStr})";
		Tab.SetTitle($"{white} vs {black}{dateSuffix}");
		_showSaveModal = false;
		StateHasChanged();
	}

	protected override void OnInitialized()
	{
		Tab.Tree.PositionChanged += OnPositionChanged;
		Loc.OnLanguageChanged += StateHasChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && Tab.IsAnalyzing)
		{
			await RestartEngineAnalysisAsync();
		}
	}

	private async void OnPositionChanged()
	{
		try
		{
			if (_isDisposed) return;
			await SyncBoardAndEngineAsync();
			if (!_isDisposed)
			{
				await InvokeAsync(StateHasChanged);
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[AnalysisWorkbench] Exception in OnPositionChanged: {ex.Message}");
		}
	}

	private async Task SyncBoardAndEngineAsync()
	{
		var shapes = GenerateBestMoveShapes();
		if (_boardRef != null)
		{
			await _boardRef.UpdateBoardStateAsync(
				Tab.Tree.CurrentNode.Position,
				Tab.Tree.CurrentNode.IsRoot ? null : Tab.Tree.CurrentNode.Move,
				shapes);
		}

		if (Tab.IsAnalyzing)
		{
			await RestartEngineAnalysisAsync();
		}
	}

	private async Task HandleUserMove(Move move)
	{
		Tab.Tree.AddMove(move);
	}

	private void HandleReferenceMoveSelected(string san)
	{
		Tab.Tree.AddMoveSan(san);
	}

	private void HandleTablebaseMovePlayed(string san)
	{
		Tab.Tree.AddMoveSan(san);
	}

	private void HandleReferenceGameOpened(GameHeader game)
	{
		string title = $"{game.White} vs {game.Black} ({game.FormattedDate})";
		Workspace.CreateAnalysisTab(title: title, pgn: game.Pgn);
	}

	private async Task HandleSelectNode(MoveNode node)
	{
		Tab.Tree.NavigateTo(node);
	}

	private void HandleFirst() => Tab.Tree.GoToStart();
	private void HandlePrev() => Tab.Tree.GoBack();
	private void HandleNext() => Tab.Tree.GoForward();
	private void HandleLast() => Tab.Tree.GoToEnd();

	private void HandleOrientationChanged(string orientation)
	{
		Tab.Orientation = orientation;
	}

	private void HandlePromoteVariation(MoveNode node)
	{
		Tab.Tree.PromoteVariation(node);
	}

	private void HandleDeleteSubtree(MoveNode node)
	{
		Tab.Tree.DeleteSubtree(node);
	}

	private async Task HandleAnalyzingToggled(bool analyzing)
	{
		Tab.IsAnalyzing = analyzing;
		if (analyzing)
		{
			await RestartEngineAnalysisAsync();
		}
		else
		{
			_engineCts?.Cancel();
			await EngineService.StopAnalysisAsync();
			Tab.CurrentEvalLines.Clear();
			if (_boardRef != null)
			{
				await _boardRef.UpdateBoardStateAsync(
					Tab.Tree.CurrentNode.Position,
					Tab.Tree.CurrentNode.IsRoot ? null : Tab.Tree.CurrentNode.Move,
					new List<object>());
			}
		}
		StateHasChanged();
	}

	private async Task HandleMultiPvChanged(int count)
	{
		Tab.MultiPv = count;
		if (Tab.IsAnalyzing)
		{
			await RestartEngineAnalysisAsync();
		}
	}

	private async Task RestartEngineAnalysisAsync()
	{
		if (_isDisposed) return;

		try
		{
			_engineCts?.Cancel();
			_engineCts?.Dispose();
		}
		catch { }

		_engineCts = new CancellationTokenSource();

		string fen = FenParser.ToFen(Tab.Tree.CurrentNode.Position);

		try
		{
			await EngineService.StartAnalysisAsync(fen, Tab.MultiPv, async lines =>
			{
				if (_isDisposed) return;

				Tab.CurrentEvalLines = lines;
				var shapes = GenerateBestMoveShapes();
				if (_boardRef != null && !_isDisposed)
				{
					try
					{
						await _boardRef.UpdateBoardStateAsync(
							Tab.Tree.CurrentNode.Position,
							Tab.Tree.CurrentNode.IsRoot ? null : Tab.Tree.CurrentNode.Move,
							shapes);
					}
					catch (ObjectDisposedException) { }
				}

				if (!_isDisposed)
				{
					try
					{
						await InvokeAsync(StateHasChanged);
					}
					catch (ObjectDisposedException) { }
					catch (InvalidOperationException) { }
				}
			}, _engineCts.Token);
		}
		catch (OperationCanceledException) { }
	}

	private List<object> GenerateBestMoveShapes()
	{
		var shapes = new List<object>();
		if (Tab.IsAnalyzing && Tab.CurrentEvalLines.Count > 0)
		{
			var top = Tab.CurrentEvalLines[0];
			if (!string.IsNullOrEmpty(top.BestMove) && top.BestMove.Length >= 4)
			{
				string orig = top.BestMove.Substring(0, 2);
				string dest = top.BestMove.Substring(2, 2);
				shapes.Add(new { orig = orig, dest = dest, brush = "green" });
			}
		}
		return shapes;
	}

	private async Task HandleInsertPvVariation(List<string> uciMoves)
	{
		var tempPos = Tab.Tree.CurrentNode.Position.Clone();
		var baseNode = Tab.Tree.CurrentNode;

		foreach (var uci in uciMoves)
		{
			if (uci.Length < 4) break;
			var from = SquareExtensions.Parse(uci.Substring(0, 2));
			var to = SquareExtensions.Parse(uci.Substring(2, 2));
			var promo = uci.Length > 4 ? uci[4] switch
			{
				'q' => PieceType.Queen,
				'r' => PieceType.Rook,
				'b' => PieceType.Bishop,
				'n' => PieceType.Knight,
				_ => PieceType.None
			} : PieceType.None;

			var legal = MoveGenerator.GenerateLegalMoves(tempPos);
			var move = legal.FirstOrDefault(m => m.From == from && m.To == to && (promo == PieceType.None || m.Promotion == promo));
			if (move.IsEmpty) break;

			Tab.Tree.AddMove(move);
			tempPos = MoveGenerator.ApplyMove(tempPos, move);
		}

		Tab.Tree.NavigateTo(baseNode);
	}

	private void HandleGlobalKey(KeyboardEventArgs e)
	{
		if (e.Key == "ArrowLeft")
		{
			HandlePrev();
		}
		else if (e.Key == "ArrowRight")
		{
			HandleNext();
		}
		else if (e.Key == "Home")
		{
			HandleFirst();
		}
		else if (e.Key == "End")
		{
			HandleLast();
		}
	}

	public void Dispose()
	{
		_isDisposed = true;
		Tab.Tree.PositionChanged -= OnPositionChanged;
		Loc.OnLanguageChanged -= StateHasChanged;
		try
		{
			_engineCts?.Cancel();
			_engineCts?.Dispose();
		}
		catch { }
		_ = EngineService.StopAnalysisAsync();
	}
}
