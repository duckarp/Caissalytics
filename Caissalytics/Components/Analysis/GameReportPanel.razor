@namespace Caissalytics.Components.Analysis
@using Caissalytics.Core
@using Caissalytics.Engine
@inject IGameAnalysisService GameAnalysisService
@inject IEngineService EngineService
@implements IDisposable

<div class="gamereport-container">
	@if (_isAnalyzing)
	{
		<div class="gamereport-progress-card">
			<div class="progress-header-row">
				<span class="progress-title-text">@Loc["Report_AnalyzingWithStockfish"]</span>
				<span class="progress-percent-text">@(_progress?.PercentComplete ?? 0)%</span>
			</div>

			<div class="gamereport-progress-track">
				<div class="gamereport-progress-bar bar-w-@(Math.Clamp(_progress?.PercentComplete ?? 0, 0, 100))"></div>
			</div>

			<div class="progress-details-row">
				<span>@Loc["Report_MoveProgress", _progress?.CurrentPly ?? 0, _progress?.TotalPlies ?? 0, _progress?.CurrentMoveSan ?? "..."]</span>
				<button class="btn-secondary" @onclick="CancelAnalysis">@Loc["Common_Cancel"]</button>
			</div>
		</div>
	}
	else if (Tab.AnalysisReport == null)
	{
		<div class="gamereport-cta-card">
			<div class="gamereport-cta-icon">📊</div>
			<h3 class="gamereport-cta-title">@Loc["Report_FullGameAnalysis"]</h3>
			<p class="gamereport-cta-desc">
				@Loc["Report_FullGameDesc"]
			</p>

			<div class="gamereport-speed-selector">
				<button class="speed-option-btn @(_selectedSpeed == "Quick" ? "speed-active" : "")"
						@onclick='() => _selectedSpeed = "Quick"'>
					@Loc["Report_QuickScan"]
				</button>
				<button class="speed-option-btn @(_selectedSpeed == "Standard" ? "speed-active" : "")"
						@onclick='() => _selectedSpeed = "Standard"'>
					@Loc["Report_Standard"]
				</button>
				<button class="speed-option-btn @(_selectedSpeed == "Deep" ? "speed-active" : "")"
						@onclick='() => _selectedSpeed = "Deep"'>
					@Loc["Report_Deep"]
				</button>
			</div>

			@if (!string.IsNullOrEmpty(_errorMessage))
			{
				<div class="modal-warning-box">
					<span>@_errorMessage</span>
				</div>
			}

			<button class="btn-primary" @onclick="StartAnalysisAsync">@Loc["Report_AnalyzeEntireGame"]</button>
		</div>
	}
	else
	{
		var report = Tab.AnalysisReport;
		string whitePlayer = Tab.Tree.Headers.GetValueOrDefault("White", "White");
		string blackPlayer = Tab.Tree.Headers.GetValueOrDefault("Black", "Black");

		<!-- Accuracy Header -->
		<div class="report-accuracy-grid">
			<div class="accuracy-card">
				<span class="accuracy-player-title" title="@whitePlayer">⚪ @whitePlayer</span>
				<span class="accuracy-big-score @GetAccuracyClass(report.WhiteAccuracy)">@report.WhiteAccuracy.ToString("F1")%</span>
				<span class="accuracy-meta-text">ACPL: @report.WhiteAcpl.ToString("F1")</span>
			</div>
			<div class="accuracy-card">
				<span class="accuracy-player-title" title="@blackPlayer">⚫ @blackPlayer</span>
				<span class="accuracy-big-score @GetAccuracyClass(report.BlackAccuracy)">@report.BlackAccuracy.ToString("F1")%</span>
				<span class="accuracy-meta-text">ACPL: @report.BlackAcpl.ToString("F1")</span>
			</div>
		</div>

		<!-- Advantage Graph -->
		<EvaluationChart Plies="@report.Plies"
						 ActivePly="@CurrentPlyIndex"
						 OnSelectPly="HandleChartPlySelected" />

		<!-- Move Quality Breakdown Table -->
		<div class="quality-breakdown-card">
			<div class="quality-card-header">@Loc["Report_Classification"]</div>
			<div class="quality-table-wrapper">
				<table class="quality-table">
					<thead>
						<tr>
							<th>@Loc["Report_Classification"]</th>
							<th>@Loc["Analysis_White"].Replace(":", "")</th>
							<th>@Loc["Analysis_Black"].Replace(":", "")</th>
						</tr>
					</thead>
					<tbody>
						<tr class="quality-row">
							<td><span class="quality-badge badge-best">@Loc["Report_Best"]</span></td>
							<td>@report.WhiteBestCount</td>
							<td>@report.BlackBestCount</td>
						</tr>
						<tr class="quality-row">
							<td><span class="quality-badge badge-excellent">@Loc["Report_Excellent"]</span></td>
							<td>@report.WhiteExcellentCount</td>
							<td>@report.BlackExcellentCount</td>
						</tr>
						<tr class="quality-row">
							<td><span class="quality-badge badge-good">@Loc["Report_Good"]</span></td>
							<td>@report.WhiteGoodCount</td>
							<td>@report.BlackGoodCount</td>
						</tr>
						<tr class="quality-row">
							<td><span class="quality-badge badge-inaccuracy">@Loc["Report_Inaccuracy"]</span></td>
							<td>@report.WhiteInaccuracyCount</td>
							<td>@report.BlackInaccuracyCount</td>
						</tr>
						<tr class="quality-row">
							<td><span class="quality-badge badge-mistake">@Loc["Report_Mistake"]</span></td>
							<td>@report.WhiteMistakeCount</td>
							<td>@report.BlackMistakeCount</td>
						</tr>
						<tr class="quality-row">
							<td><span class="quality-badge badge-blunder">@Loc["Report_Blunder"]</span></td>
							<td>@report.WhiteBlunderCount</td>
							<td>@report.BlackBlunderCount</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Action Buttons -->
		<div class="report-actions-row">
			<button class="btn-primary" @onclick="AnnotateTree" disabled="@_isAnnotated">
				@(_isAnnotated ? Loc["Report_TreeAnnotated"] : Loc["Report_AnnotateTree"])
			</button>
			<button class="btn-secondary" @onclick="NextMistake">
				@Loc["Report_NextMistake"]
			</button>
			<button class="btn-secondary" @onclick="() => Tab.AnalysisReport = null">
				🔄 Re-analyze
			</button>
		</div>
	}
</div>

@code {
	[Parameter, EditorRequired] public AnalysisTab Tab { get; set; } = default!;
	[Parameter] public EventCallback<int> OnSelectPly { get; set; }

	private bool _isAnalyzing = false;
	private CancellationTokenSource? _analysisCts;
	private GameAnalysisProgress? _progress;
	private string _selectedSpeed = "Standard";
	private string? _errorMessage;
	private bool _isAnnotated = false;
	private bool _isDisposed = false;

	private int? CurrentPlyIndex
	{
		get
		{
			int count = -1;
			var curr = Tab.Tree.CurrentNode;
			while (curr.Parent != null)
			{
				count++;
				curr = curr.Parent;
			}
			return curr == Tab.Tree.Root && count >= 0 ? count : null;
		}
	}

	private async Task StartAnalysisAsync()
	{
		_errorMessage = null;
		_isAnalyzing = true;
		_isAnnotated = false;
		_progress = new GameAnalysisProgress();

		var options = _selectedSpeed switch
		{
			"Quick" => GameAnalysisOptions.Quick,
			"Deep" => GameAnalysisOptions.Deep,
			_ => GameAnalysisOptions.Standard
		};

		_analysisCts = new CancellationTokenSource();
		var token = _analysisCts.Token;

		var progress = new Progress<GameAnalysisProgress>(p =>
		{
			if (_isDisposed) return;
			_progress = p;
			_ = InvokeAsync(() =>
			{
				if (!_isDisposed)
				{
					StateHasChanged();
				}
			});
		});

		try
		{
			var report = await GameAnalysisService.AnalyzeGameAsync(Tab.Tree, options, progress, token);
			if (!_isDisposed)
			{
				Tab.AnalysisReport = report;
			}
		}
		catch (OperationCanceledException)
		{
			// User canceled
		}
		catch (Exception ex)
		{
			if (!_isDisposed)
			{
				_errorMessage = ex.Message;
			}
		}
		finally
		{
			_isAnalyzing = false;
			if (!_isDisposed)
			{
				try
				{
					await InvokeAsync(StateHasChanged);
				}
				catch { }
			}
		}
	}

	private void CancelAnalysis()
	{
		try
		{
			_analysisCts?.Cancel();
		}
		catch { }
	}

	private void HandleChartPlySelected(int plyIndex)
	{
		var curr = Tab.Tree.Root;
		for (int i = 0; i <= plyIndex; i++)
		{
			if (curr.Children.Count > 0)
			{
				curr = curr.Children[0];
			}
			else
			{
				break;
			}
		}
		Tab.Tree.NavigateTo(curr);
		OnSelectPly.InvokeAsync(plyIndex);
	}

	private void AnnotateTree()
	{
		if (Tab.AnalysisReport != null)
		{
			try
			{
				GameAnalysisService.AnnotateGameTree(Tab.Tree, Tab.AnalysisReport);
				_isAnnotated = true;
				StateHasChanged();
			}
			catch (Exception ex)
			{
				_errorMessage = $"Error annotating move tree: {ex.Message}";
			}
		}
	}

	private void NextMistake()
	{
		if (Tab.AnalysisReport == null || Tab.AnalysisReport.Plies.Count == 0) return;

		int current = CurrentPlyIndex ?? -1;
		var mistakes = Tab.AnalysisReport.Plies.Where(p =>
			p.Classification == MoveClassification.Blunder ||
			p.Classification == MoveClassification.Mistake ||
			p.Classification == MoveClassification.Inaccuracy).ToList();

		if (mistakes.Count == 0) return;

		var next = mistakes.FirstOrDefault(p => p.Ply > current) ?? mistakes[0];
		HandleChartPlySelected(next.Ply);
	}

	private static string GetAccuracyClass(double acc)
	{
		if (acc >= 85.0) return "accuracy-score-high";
		if (acc >= 70.0) return "accuracy-score-mid";
		return "accuracy-score-low";
	}

	public void Dispose()
	{
		_isDisposed = true;
		try
		{
			_analysisCts?.Cancel();
		}
		catch { }
	}
}
