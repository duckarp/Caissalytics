@namespace Caissalytics.Components.Endgames
@using Caissalytics.Core
@using Caissalytics.Data
@using Caissalytics.Engine
@using Caissalytics.Components.Board
@inject ITablebaseService TablebaseService
@inject IAppearanceService AppearanceService
@inject IEngineService EngineService
@implements IDisposable

<div class="endgames-workbench-container">
	<!-- Left: Interactive Board & Status Header -->
	<div class="endgames-board-area">
		<div class="endgames-turn-indicator">
			<div class="endgames-turn-left">
				<span class="turn-color-dot @(_tree.CurrentNode.Position.ActiveColor == PieceColor.White ? "white" : "black")"></span>
				<span>@(_tree.CurrentNode.Position.ActiveColor == PieceColor.White ? Loc["Endgame_WhiteToMove"] : Loc["Endgame_BlackToMove"])</span>
				<span class="endgame-target-pill @(_currentPosition.TargetOutcome == "Win" ? "target-win" : "target-draw")">
					@(_currentPosition.TargetOutcome == "Win" ? Loc["Endgame_TargetWin", _currentPosition.PlayerColor] : Loc["Endgame_TargetDraw", _currentPosition.PlayerColor])
				</span>
			</div>

			<div class="endgames-turn-right">
				@if (_tbResult != null && _tbResult.Success)
				{
					<span class="endgame-tb-verdict-pill" title="Tablebase Verdict">
						🏆 @_tbResult.FormattedVerdict
					</span>
				}
				else if (_isComputerThinking)
				{
					<span class="endgame-tb-verdict-pill">@Loc["Endgame_OpponentThinking"]</span>
				}
			</div>
		</div>

		<ChessgroundBoard @ref="_boardRef"
						  Position="@_tree.CurrentNode.Position"
						  LastMove="@(_tree.CurrentNode.IsRoot ? null : _tree.CurrentNode.Move)"
						  Orientation="@_orientation"
						  CanGoBack="@_tree.CanGoBack"
						  CanGoForward="@_tree.CanGoForward"
						  OnMoveMade="HandleUserMove"
						  Tree="@_tree"
						  OnFirst="HandleFirst"
						  OnPrev="HandlePrev"
						  OnNext="HandleNext"
						  OnLast="HandleLast" />
	</div>

	<!-- Right: Curriculum Selector & Theory/Coaching Sidebar -->
	<div class="endgames-sidebar">
		<!-- 1. Position & Progress Card -->
		<div class="endgames-card">
			<div class="endgames-card-header">
				<h3 class="endgames-card-title">
					<span>@Loc["Endgame_ClassicalEndgames"]</span>
				</h3>
				<span class="endgames-progress-badge">
					@Loc["Endgame_Mastered", _solvedIds.Count, EndgameCurriculum.AllPositions.Count, (EndgameCurriculum.AllPositions.Count > 0 ? (_solvedIds.Count * 100 / EndgameCurriculum.AllPositions.Count) : 0)]
				</span>
			</div>

			<!-- Category Filter Bar -->
			<div class="endgame-category-bar">
				<button class="endgame-cat-btn @(_selectedCategory == "all" ? "active" : "")" @onclick='() => SetCategory("all")'>@Loc["Endgame_Cat_All"]</button>
				<button class="endgame-cat-btn @(_selectedCategory == "Pawns" ? "active" : "")" @onclick='() => SetCategory("Pawns")'>@Loc["Endgame_Cat_Pawns"]</button>
				<button class="endgame-cat-btn @(_selectedCategory == "Rooks" ? "active" : "")" @onclick='() => SetCategory("Rooks")'>@Loc["Endgame_Cat_Rooks"]</button>
				<button class="endgame-cat-btn @(_selectedCategory == "Queens" ? "active" : "")" @onclick='() => SetCategory("Queens")'>@Loc["Endgame_Cat_Queens"]</button>
				<button class="endgame-cat-btn @(_selectedCategory == "MinorPieces" ? "active" : "")" @onclick='() => SetCategory("MinorPieces")'>@Loc["Endgame_Cat_MinorPieces"]</button>
				<button class="endgame-cat-btn @(_selectedCategory == "Practical" ? "active" : "")" @onclick='() => SetCategory("Practical")'>@Loc["Endgame_Cat_Practical"]</button>
			</div>

			<!-- Positions Scroll List -->
			<div class="endgame-list-scroll">
				@foreach (var pos in FilteredPositions)
				{
					bool isSelected = pos.Id == _currentPosition.Id;
					bool isSolved = _solvedIds.Contains(pos.Id);

					<div class="endgame-item-card @(isSelected ? "item-selected" : "")" @onclick="() => SelectPosition(pos)">
						<div class="endgame-item-info">
							<div class="endgame-item-title-row">
								<span class="endgame-item-title">@pos.Title</span>
								<span class="endgame-difficulty-pill diff-@pos.Difficulty.ToString().ToLowerInvariant()">@pos.Difficulty</span>
							</div>
							<span class="endgame-item-subtitle">@pos.Subtitle</span>
						</div>
						<div class="endgame-status-icon">
							@(isSolved ? "✅" : "○")
						</div>
					</div>
				}
			</div>
		</div>

		<!-- 2. Coaching & Theory Card -->
		<div class="endgames-card">
			<div class="endgames-card-header">
				<h3 class="endgames-card-title">@_currentPosition.Title</h3>
				<span class="endgame-target-pill @(_currentPosition.TargetOutcome == "Win" ? "target-win" : "target-draw")">
					@(_currentPosition.TargetOutcome == "Win" ? Loc["Endgame_TargetWinShort", _currentPosition.PlayerColor] : Loc["Endgame_TargetDrawShort", _currentPosition.PlayerColor])
				</span>
			</div>

			<p class="theory-desc-text">@_currentPosition.Description</p>

			@if (_showHint)
			{
				<div class="coaching-tip-box">
					<span class="tip-icon">💡</span>
					<span>@_currentPosition.CoachingTip</span>
				</div>
			}

			@if (_currentPosition.KeySquares.Count > 0)
			{
				<div class="key-squares-row">
					<span class="key-squares-label">@Loc["Endgame_KeySquares"]</span>
					@foreach (var sq in _currentPosition.KeySquares)
					{
						<span class="key-square-badge">@sq</span>
					}
				</div>
			}

			<!-- Move Feedback Banner -->
			<div class="move-feedback-banner feedback-@_feedbackType">
				<span>@_feedbackMessage</span>
			</div>

			<!-- Actions Controls -->
			<div class="endgame-actions-bar">
				<div class="actions-left">
					<button class="btn-secondary btn-sm" @onclick="ResetCurrentPosition" title="Reset to starting position">
						@Loc["Endgame_Reset"]
					</button>
					<button class="btn-secondary btn-sm" @onclick="ToggleHint">
						@(_showHint ? Loc["Endgame_HideHint"] : Loc["Endgame_Hint"])
					</button>
					<button class="btn-secondary btn-sm" @onclick="ToggleTablebaseView">
						@(_showTablebase ? Loc["Endgame_HideMoves"] : Loc["Endgame_Tablebase"])
					</button>
				</div>
				<div class="actions-right">
					<button class="btn-primary btn-sm" @onclick="GoToNextEndgame">
						@Loc["Endgame_Next"]
					</button>
				</div>
			</div>
		</div>

		<!-- 3. Candidate Moves Tablebase Card (if toggled) -->
		@if (_showTablebase && _tbResult != null && _tbResult.Success)
		{
			<div class="endgames-card">
				<div class="endgames-card-header">
					<h4 class="endgames-card-title">@Loc["Endgame_TbCandidates"]</h4>
					<span class="theory-desc-text">@Loc["Db_GamesCount", _tbResult.Moves.Count]</span>
				</div>

				<div class="tablebase-moves-container">
					<div class="tablebase-moves-header">
						<span class="col-move">@Loc["Tablebase_Move"]</span>
						<span class="col-outcome">@Loc["Tablebase_Result"]</span>
						<span class="col-dtz">@Loc["Tablebase_Dtz"]</span>
						<span class="col-dtm">@Loc["Tablebase_Dtm"]</span>
						<span class="col-action">@Loc["Tablebase_Action"]</span>
					</div>

					<div class="tablebase-moves-list">
						@foreach (var m in _tbResult.Moves.Take(8))
						{
							string catClass = m.Category.ToString().ToLowerInvariant();
							<div class="tablebase-move-row">
								<div class="col-move move-notation">
									<span class="move-san">@m.San</span>
								</div>
								<div class="col-outcome">
									<span class="outcome-badge badge-@catClass">@m.Category</span>
								</div>
								<div class="col-dtz">
									@(m.Dtz.HasValue && m.Dtz.Value != 0 ? Math.Abs(m.Dtz.Value).ToString() : "-")
								</div>
								<div class="col-dtm">
									@(m.Dtm.HasValue && m.Dtm.Value != 0 ? Math.Abs(m.Dtm.Value).ToString() : "-")
								</div>
								<div class="col-action">
									<button class="btn-play-tb-move" @onclick="() => PlayCandidateMove(m.San)">
										▶
									</button>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter, EditorRequired] public EndgameTrainerTab Tab { get; set; } = default!;

	private ChessgroundBoard? _boardRef;
	private GameTree _tree = new();
	private EndgamePosition _currentPosition = EndgameCurriculum.AllPositions[0];
	private string _selectedCategory = "all";
	private readonly HashSet<string> _solvedIds = new();
	private string _orientation = "white";

	private string _feedbackMessage = "Make a move on the board to practice against the theoretical tablebase.";
	private string _feedbackType = "neutral";
	private bool _showHint = false;
	private bool _showTablebase = false;
	private bool _isComputerThinking = false;
	private TablebaseResult? _tbResult;
	private int _consecutiveCorrectMoves = 0;
	private bool _isDisposed = false;

	private IEnumerable<EndgamePosition> FilteredPositions =>
		_selectedCategory == "all"
			? EndgameCurriculum.AllPositions
			: EndgameCurriculum.AllPositions.Where(p => p.Category.ToString().Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));

	protected override async Task OnInitializedAsync()
	{
		Loc.OnLanguageChanged += StateHasChanged;
		if (!string.IsNullOrEmpty(Tab.SelectedPositionId))
		{
			var match = EndgameCurriculum.GetById(Tab.SelectedPositionId);
			if (match != null) _currentPosition = match;
		}

		await LoadPositionAsync(_currentPosition);
	}

	private async Task SelectPosition(EndgamePosition pos)
	{
		_currentPosition = pos;
		Tab.SelectedPositionId = pos.Id;
		await LoadPositionAsync(pos);
	}

	private async Task LoadPositionAsync(EndgamePosition pos)
	{
		_currentPosition = pos;
		_orientation = pos.PlayerColor == PieceColor.White ? "white" : "black";
		_tree = new GameTree(pos.Fen);
		_showHint = false;
		_showTablebase = false;
		_consecutiveCorrectMoves = 0;
		_feedbackMessage = $"Goal: {pos.TargetOutcome} as {pos.PlayerColor}. {pos.Subtitle}.";
		_feedbackType = "neutral";

		await ProbeCurrentPositionAsync();
	}

	private async Task ResetCurrentPosition()
	{
		await LoadPositionAsync(_currentPosition);
	}

	private async Task ProbeCurrentPositionAsync()
	{
		try
		{
			_tbResult = await TablebaseService.ProbePositionAsync(_tree.CurrentNode.Position);
		}
		catch
		{
			_tbResult = null;
		}
	}

	private async Task HandleUserMove(Move move)
	{
		if (_isComputerThinking) return;

		// Check side to move matches player color
		bool isUserTurn = _tree.CurrentNode.Position.ActiveColor == _currentPosition.PlayerColor;
		_tree.AddMove(move);

		await AppearanceService.PlaySoundAsync(move.IsCapture ? ChessSoundType.Capture : ChessSoundType.Move);

		var posAfterUser = _tree.CurrentNode.Position;
		await ProbeCurrentPositionAsync();

		// Check terminal conditions
		var legalAfter = MoveGenerator.GenerateLegalMoves(posAfterUser);
		bool inCheck = MoveGenerator.IsInCheck(posAfterUser, posAfterUser.ActiveColor);

		if (legalAfter.Count == 0)
		{
			if (inCheck)
			{
				// Checkmate!
				_feedbackMessage = "🎉 Checkmate! Theoretical mastery achieved!";
				_feedbackType = "solved";
				MarkCurrentSolved();
				await AppearanceService.PlaySoundAsync(ChessSoundType.Victory);
				return;
			}
			else
			{
				// Stalemate
				if (_currentPosition.TargetOutcome == "Draw")
				{
					_feedbackMessage = "🎉 Stalemate! Perfect drawing fortress achieved!";
					_feedbackType = "solved";
					MarkCurrentSolved();
					await AppearanceService.PlaySoundAsync(ChessSoundType.Victory);
				}
				else
				{
					_feedbackMessage = "⚠️ Stalemate! The win slipped away into a draw. Reset to try again.";
					_feedbackType = "blunder";
				}
				return;
			}
		}

		// Evaluate move quality via tablebase
		if (_tbResult != null && _tbResult.Success)
		{
			// Current ActiveColor is the OPPONENT now
			// If user's goal was Win: opponent should be in Loss or BlessedLoss
			if (_currentPosition.TargetOutcome == "Win")
			{
				if (_tbResult.Category == TablebaseCategory.Loss || _tbResult.Category == TablebaseCategory.BlessedLoss)
				{
					_consecutiveCorrectMoves++;
					_feedbackMessage = $"🎯 Excellent move! Still winning ({_tbResult.FormattedVerdict}).";
					_feedbackType = "success";

					if (_consecutiveCorrectMoves >= 3 || _tbResult.Checkmate)
					{
						MarkCurrentSolved();
					}
				}
				else if (_tbResult.Category == TablebaseCategory.Draw)
				{
					_feedbackMessage = "⚠️ Blunder! That dropped the win into a theoretical draw. Click Reset to retry.";
					_feedbackType = "blunder";
				}
				else
				{
					_feedbackMessage = "❌ Mistake! That allowed a counter-loss. Click Reset to retry.";
					_feedbackType = "blunder";
				}
			}
			else // Target is Draw
			{
				if (_tbResult.Category == TablebaseCategory.Draw || _tbResult.Category == TablebaseCategory.BlessedLoss || _tbResult.Category == TablebaseCategory.Loss)
				{
					_consecutiveCorrectMoves++;
					_feedbackMessage = "🛡️ Solid defense! Theoretical draw maintained.";
					_feedbackType = "success";

					if (_consecutiveCorrectMoves >= 3)
					{
						MarkCurrentSolved();
					}
				}
				else
				{
					_feedbackMessage = "❌ That loses the position. Click Reset to try a different defensive line.";
					_feedbackType = "blunder";
				}
			}
		}

		// If opponent's turn, make opponent tablebase move
		if (posAfterUser.ActiveColor != _currentPosition.PlayerColor)
		{
			await MakeComputerDefenseMoveAsync();
		}
	}

	private async Task MakeComputerDefenseMoveAsync()
	{
		_isComputerThinking = true;
		StateHasChanged();

		await Task.Delay(350);
		if (_isDisposed) return;

		try
		{
			string? bestMoveSan = null;

			if (_tbResult != null && _tbResult.Success && _tbResult.Moves.Count > 0)
			{
				// Pick the best defensive move from opponent's perspective (first in sorted list)
				bestMoveSan = _tbResult.Moves[0].San;
			}

			if (string.IsNullOrEmpty(bestMoveSan))
			{
				var legal = MoveGenerator.GenerateLegalMoves(_tree.CurrentNode.Position);
				if (legal.Count > 0)
				{
					var chosen = legal[0];
					_tree.AddMove(chosen);
					await AppearanceService.PlaySoundAsync(chosen.IsCapture ? ChessSoundType.Capture : ChessSoundType.Move);
				}
			}
			else
			{
				_tree.AddMoveSan(bestMoveSan);
				await AppearanceService.PlaySoundAsync(bestMoveSan.Contains('x') ? ChessSoundType.Capture : ChessSoundType.Move);
			}

			await ProbeCurrentPositionAsync();
		}
		finally
		{
			_isComputerThinking = false;
			StateHasChanged();
		}
	}

	private void MarkCurrentSolved()
	{
		_solvedIds.Add(_currentPosition.Id);
	}

	private async Task PlayCandidateMove(string san)
	{
		_tree.AddMoveSan(san);
		await ProbeCurrentPositionAsync();
		StateHasChanged();
	}

	private void SetCategory(string cat)
	{
		_selectedCategory = cat;
	}

	private void ToggleHint()
	{
		_showHint = !_showHint;
	}

	private void ToggleTablebaseView()
	{
		_showTablebase = !_showTablebase;
	}

	private async Task GoToNextEndgame()
	{
		var list = FilteredPositions.ToList();
		int idx = list.FindIndex(p => p.Id == _currentPosition.Id);
		if (idx >= 0 && idx < list.Count - 1)
		{
			await SelectPosition(list[idx + 1]);
		}
		else if (list.Count > 0)
		{
			await SelectPosition(list[0]);
		}
	}

	private void HandleFirst() => _tree.GoToStart();
	private void HandlePrev() => _tree.GoBack();
	private void HandleNext() => _tree.GoForward();
	private void HandleLast() => _tree.GoToEnd();

	public void Dispose()
	{
		_isDisposed = true;
		Loc.OnLanguageChanged -= StateHasChanged;
	}
}
