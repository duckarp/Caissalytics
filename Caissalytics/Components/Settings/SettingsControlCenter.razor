@namespace Caissalytics.Components.Settings
@using Caissalytics.Data
@using Caissalytics.Engine
@using Caissalytics.Components.Database
@inject IUserProfileService ProfileService
@inject IEngineService EngineService
@inject IOnlineGameSyncService SyncService
@inject IDatabaseService DatabaseService
@inject ITablebaseService TablebaseService
@inject IUpdateService UpdateService
@inject IAppearanceService AppearanceService
@inject WorkspaceState Workspace
@using System.Runtime.InteropServices
@implements IDisposable

<div class="control-center-container">
	<div class="control-center-header">
		<div class="control-title-group">
			<span class="control-header-icon">⚙️</span>
			<div>
				<h2 class="control-heading">Control Center</h2>
				<p class="control-subtitle">Manage user profile, configure chess engines, and customize online sync preferences.</p>
			</div>
		</div>
	</div>

	<div class="control-center-body">
		<aside class="control-sidebar">
			<nav class="control-nav-menu">
				<button class="@GetNavClass("profile")" @onclick='() => SetCategory("profile")'>
					<span class="nav-item-icon">👤</span>
					<div class="nav-item-content">
						<span class="nav-item-title">Profile &amp; Handles</span>
						<span class="nav-item-desc">Name, FIDE ID, online accounts</span>
					</div>
				</button>

				<button class="@GetNavClass("appearance")" @onclick='() => SetCategory("appearance")'>
					<span class="nav-item-icon">🎨</span>
					<div class="nav-item-content">
						<span class="nav-item-title">Board &amp; Audio</span>
						<span class="nav-item-desc">Themes, sound effects, volume</span>
					</div>
				</button>

				<button class="@GetNavClass("engines")" @onclick='() => SetCategory("engines")'>
					<span class="nav-item-icon">⚙️</span>
					<div class="nav-item-content">
						<span class="nav-item-title">Chess Engines</span>
						<span class="nav-item-desc">Installed engines, active UCI, 1-click install</span>
					</div>
				</button>

				<button class="@GetNavClass("tablebases")" @onclick='() => SetCategory("tablebases")'>
					<span class="nav-item-icon">🏆</span>
					<div class="nav-item-content">
						<span class="nav-item-title">Syzygy Tablebases</span>
						<span class="nav-item-desc">Endgame probe, local path, online API</span>
					</div>
				</button>

				<button class="@GetNavClass("sync")" @onclick='() => SetCategory("sync")'>
					<span class="nav-item-icon">🌐</span>
					<div class="nav-item-content">
						<span class="nav-item-title">Online Games Sync</span>
						<span class="nav-item-desc">Batch size, database status, auto sync</span>
					</div>
				</button>

				<button class="@GetNavClass("updates")" @onclick='() => SetCategory("updates")'>
					<span class="nav-item-icon">🚀</span>
					<div class="nav-item-content">
						<span class="nav-item-title">App &amp; Updates</span>
						<span class="nav-item-desc">Version, releases, auto-updater</span>
					</div>
				</button>
			</nav>
		</aside>

		<main class="control-content-panel">
			@if (_activeCategory == "profile")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">👤 User Profile & Accounts</h3>
						<p class="card-section-desc">Personalize your identity and connect your online chess playing accounts.</p>
					</div>

					<div class="control-form-grid">
						<div class="form-field-block">
							<label class="field-label">First Name</label>
							<input class="field-input" placeholder="e.g. Garry" @bind="_profile.FirstName" @bind:event="oninput" />
						</div>

						<div class="form-field-block">
							<label class="field-label">Last Name</label>
							<input class="field-input" placeholder="e.g. Kasparov" @bind="_profile.LastName" @bind:event="oninput" />
						</div>

						<div class="form-field-block form-field-full">
							<label class="field-label">FIDE ID</label>
							<div class="input-with-link-row">
								<input class="field-input" placeholder="e.g. 4100018" @bind="_profile.FideId" @bind:event="oninput" />
								@if (_profile.HasFideId)
								{
									<a class="external-profile-link" href="@_profile.FideProfileUrl" target="_blank" rel="noopener noreferrer">
										<span>🌐 View FIDE Card</span>
									</a>
								}
							</div>
							<span class="field-hint">Official World Chess Federation player identification number.</span>
						</div>
					</div>

					<div class="section-divider"></div>

					<div class="card-section-header">
						<h4 class="card-section-subtitle">Connected Online Accounts</h4>
						<p class="card-section-desc">Used to automatically synchronize your online games into "My online games" (MoG).</p>
					</div>

					<div class="control-form-grid">
						<div class="form-field-block">
							<div class="field-label-group">
								<span class="platform-badge platform-badge-lichess">♞ Lichess</span>
								<label class="field-label">Username</label>
							</div>
							<div class="input-with-link-row">
								<input class="field-input" placeholder="e.g. magnuscarlsen" @bind="_profile.LichessUsername" @bind:event="oninput" />
								@if (_profile.HasLichess)
								{
									<a class="external-profile-link" href="@_profile.LichessProfileUrl" target="_blank" rel="noopener noreferrer">
										<span>🌐 Open</span>
									</a>
								}
							</div>
						</div>

						<div class="form-field-block">
							<div class="field-label-group">
								<span class="platform-badge platform-badge-chesscom">♟️ Chess.com</span>
								<label class="field-label">Username</label>
							</div>
							<div class="input-with-link-row">
								<input class="field-input" placeholder="e.g. hikaru" @bind="_profile.ChessComUsername" @bind:event="oninput" />
								@if (_profile.HasChessCom)
								{
									<a class="external-profile-link" href="@_profile.ChessComProfileUrl" target="_blank" rel="noopener noreferrer">
										<span>🌐 Open</span>
									</a>
								}
							</div>
						</div>

						<div class="form-field-block form-field-full">
							<div class="field-label-group">
								<span class="platform-badge platform-badge-lichess">🔑 Lichess API Token</span>
								<label class="field-label">Personal Access Token (Free)</label>
							</div>
							<div class="input-with-link-row">
								<input class="field-input" type="password" placeholder="lip_..." @bind="_profile.LichessApiToken" @bind:event="oninput" />
								<a class="external-profile-link" href="https://lichess.org/account/oauth/token" target="_blank" rel="noopener noreferrer">
									<span>🔗 Generate Token ↗</span>
								</a>
							</div>
							<span class="field-hint">Required by Lichess to query the Online Opening Explorer (Masters &amp; Community). Free to generate on Lichess without any special permissions.</span>
						</div>
					</div>

					<div class="form-action-bar">
						<button class="btn-primary" @onclick="SaveProfileAsync">💾 Save Profile Changes</button>
						@if (_profileSaved)
						{
							<span class="save-status-badge">✅ Profile changes saved!</span>
						}
					</div>
				</div>
			}
			else if (_activeCategory == "engines")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">⚙️ Chess Engines (UCI)</h3>
						<p class="card-section-desc">Manage installed engines, select the active engine for live analysis and game reports, or add custom binaries.</p>
					</div>

					<!-- Registered engines list -->
					<div class="engines-list-wrapper">
						@foreach (var eng in _engines)
						{
							bool isActive = eng.IsActive;
							string cardClass = isActive ? "engine-entry-card engine-entry-active" : "engine-entry-card";

							<div class="@cardClass">
								<div class="engine-entry-main">
									<div class="engine-entry-header">
										<div class="engine-name-group">
											<span class="status-dot @(eng.IsInstalled ? "dot-ready" : "")"></span>
											<span class="engine-card-name">@eng.Name</span>
											@if (isActive)
											{
												<span class="engine-badge-active">Active Engine</span>
											}
											@if (eng.IsCustom)
											{
												<span class="engine-badge-custom">Custom</span>
											}
										</div>
										@if (!string.IsNullOrEmpty(eng.Author))
										{
											<span class="engine-card-author">by @eng.Author</span>
										}
									</div>

									<div class="engine-entry-details">
										@if (eng.IsInstalled)
										{
											<span class="engine-path-text" title="@eng.ExecutablePath">📁 @eng.ExecutablePath</span>
										}
										else
										{
											<span class="engine-path-missing">⚠️ Not installed yet</span>
										}
									</div>
								</div>

								<div class="engine-entry-actions">
									@if (eng.IsInstalled)
									{
										@if (!isActive)
										{
											<button class="btn-secondary btn-sm" @onclick="() => SetActiveEngineAsync(eng.Id)">Set as Active</button>
										}
										<button class="btn-secondary btn-sm" @onclick="() => TestEngineHandshakeAsync(eng)" title="Verify UCI communication">⚡ Test</button>
									}
									else if (!string.IsNullOrEmpty(eng.DownloadUrl))
									{
										<button class="btn-primary btn-sm" disabled="@_isInstalling" @onclick="() => InstallEngineAsync(eng.Id)">
											@(_isInstalling && _installingEngineId == eng.Id ? $"Installing ({_installProgress}%)..." : "⚡ 1-Click Install")
										</button>
									}

									@if (eng.IsCustom)
									{
										<button class="btn-danger-outline btn-sm" @onclick="() => RemoveCustomEngineAsync(eng.Id)" title="Remove custom engine">🗑️</button>
									}
								</div>
							</div>
						}
					</div>

					<!-- Engine Handshake Probe Result Feedback -->
					@if (_handshakeResult != null)
					{
						<div class="probe-feedback-box @(_handshakeResult.Success ? "probe-success" : "probe-error")">
							<div class="probe-header">
								<span>@(_handshakeResult.Success ? "✅ UCI Handshake Succeeded" : "❌ UCI Handshake Failed")</span>
								<button class="btn-close-probe" @onclick="() => _handshakeResult = null">✕</button>
							</div>
							@if (_handshakeResult.Success)
							{
								<div class="probe-details">
									<div><strong>Identified Name:</strong> @_handshakeResult.Name</div>
									@if (!string.IsNullOrEmpty(_handshakeResult.Author))
									{
										<div><strong>Author:</strong> @_handshakeResult.Author</div>
									}
									<div><strong>Protocol:</strong> UCI communication confirmed (responds to uci / isready)</div>
								</div>
							}
							else
							{
								<div class="probe-error-text">@_handshakeResult.ErrorMessage</div>
							}
						</div>
					}

					<div class="section-divider"></div>

					<!-- Add new engine block -->
					<div class="add-engine-container">
						<div class="card-section-header">
							<h4 class="card-section-subtitle">➕ Add New Engine</h4>
							<p class="card-section-desc">Register a local UCI executable binary or auto-scan your operating system.</p>
						</div>

						<div class="add-engine-modes-row">
							<button class="@GetAddModeClass("local")" @onclick='() => _addEngineMode = "local"'>📁 Local File</button>
							<button class="@GetAddModeClass("scan")" @onclick='() => _addEngineMode = "scan"'>🔍 Auto-Scan System</button>
						</div>

						@if (_addEngineMode == "local")
						{
							<div class="local-engine-form">
								<div class="form-field-block form-field-full">
									<label class="field-label">Executable File Path</label>
									<div class="input-with-action-row">
										<input class="field-input"
											   placeholder="e.g. /usr/games/stockfish, C:\Chess\stockfish.exe, or /usr/local/bin/lc0"
											   @bind="_customExecutablePath"
											   @bind:event="oninput" />
										<button class="btn-primary"
												disabled="@(string.IsNullOrWhiteSpace(_customExecutablePath) || _isProbing)"
												@onclick="AddLocalEngineAsync">
											@(_isProbing ? "Probing..." : "🔍 Probe & Register")
										</button>
									</div>
									<span class="field-hint">Path to an executable file on your computer supporting the standard Universal Chess Interface (UCI).</span>
								</div>

								<div class="form-field-block">
									<label class="field-label">Custom Display Name (Optional)</label>
									<input class="field-input" placeholder="Leave blank to use engine's reported name" @bind="_customDisplayName" @bind:event="oninput" />
								</div>

								@if (!string.IsNullOrEmpty(_customAddError))
								{
									<div class="probe-feedback-box probe-error">
										<span>⚠️ @_customAddError</span>
									</div>
								}
								@if (!string.IsNullOrEmpty(_customAddSuccess))
								{
									<div class="probe-feedback-box probe-success">
										<span>✅ @_customAddSuccess</span>
									</div>
								}
							</div>
						}
						else if (_addEngineMode == "scan")
						{
							<div class="scan-engine-box">
								<p class="scan-desc">
									Caissalytics can automatically inspect standard system directories
									and search your system PATH for popular UCI engines (<code>stockfish</code>, <code>lc0</code>, <code>komodo</code>, <code>crafty</code>).
								</p>

								<div class="scan-action-row">
									<button class="btn-primary" disabled="@_isScanning" @onclick="ScanSystemEnginesAsync">
										@(_isScanning ? "Scanning System Directories..." : "🔍 Scan System for Engines")
									</button>
								</div>

								@if (!string.IsNullOrEmpty(_scanResultText))
								{
									<div class="probe-feedback-box probe-success">
										<span>@_scanResultText</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
			}
			else if (_activeCategory == "tablebases")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">🏆 Syzygy Endgame Tablebases</h3>
						<p class="card-section-desc">Evaluate 3-4-5-6-7 piece endgames with mathematical precision for exact Win/Draw/Loss and DTZ/DTM conversion metrics.</p>
					</div>

					<div class="control-form-grid">
						<div class="form-field-block form-field-full">
							<label class="field-label">Online Tablebase Probing (Lichess 7-Piece API)</label>
							<div class="toggle-control-row">
								<label class="sound-checkbox-label">
									<input type="checkbox" class="sound-check-box"
										   checked="@_onlineTbEnabled"
										   @onchange="ToggleOnlineTb" />
									<span>Enable instant online lookups (covers all &le; 7 piece endgames without downloading 18 TB)</span>
								</label>
							</div>
						</div>

						<div class="form-field-block form-field-full">
							<label class="field-label">Local Syzygy Directory Path (Optional)</label>
							<div class="input-with-action-row">
								<input class="field-input"
									   placeholder="e.g. /home/user/chess/syzygy or C:\Chess\Syzygy"
									   @bind="_localSyzygyPath"
									   @bind:event="oninput" />
								<button class="btn-primary" @onclick="SaveSyzygyPathAsync">💾 Save Path</button>
							</div>
							<span class="field-hint">Folder containing local <code>.rtbw</code> and <code>.rtbz</code> tablebase files. Automatically configured for Stockfish UCI via <code>setoption name SyzygyPath</code>.</span>
							@if (_syzygyPathSaved)
							{
								<span class="save-status-badge">✓ Syzygy path saved and applied to engine!</span>
							}
						</div>

						<div class="form-field-block form-field-full">
							<h4 class="card-section-subtitle">🔍 Test Tablebase Position</h4>
							<div class="input-with-action-row">
								<input class="field-input"
									   placeholder="Enter endgame FEN (&le; 7 pieces)..."
									   @bind="_testTbFen"
									   @bind:event="oninput" />
								<button class="btn-secondary" disabled="@_isProbingTb" @onclick="TestProbeFenAsync">
									@(_isProbingTb ? "Probing..." : "⚡ Probe FEN")
								</button>
							</div>

							@if (_testTbResult != null)
							{
								<div class="probe-feedback-box @(_testTbResult.Success ? "probe-success" : "probe-error")">
									@if (_testTbResult.Success)
									{
										<div class="probe-details">
											<div><strong>Theoretical Outcome:</strong> @_testTbResult.FormattedVerdict</div>
											@if (_testTbResult.Moves.Count > 0)
											{
												<div class="probe-meta-line">
													Candidate moves:
													@foreach (var m in _testTbResult.Moves.Take(5))
													{
														<span class="badge-tag">@m.San: @m.Category @m.FormattedDtz</span>
													}
												</div>
											}
										</div>
									}
									else
									{
										<div class="probe-error-text">@_testTbResult.ErrorMessage</div>
									}
								</div>
							}
						</div>
					</div>
				</div>
			}
			else if (_activeCategory == "sync")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">🌐 Online Games Sync Settings</h3>
						<p class="card-section-desc">Manage game download limits and inspect synchronization history.</p>
					</div>

					<div class="sync-status-grid">
						<div class="sync-info-card">
							<div class="sync-info-label">Target Database</div>
							<div class="sync-info-value">@SyncService.OnlineGamesDatabaseName</div>
							<div class="sync-info-desc">Dedicated local SQLite collection with 64-bit Zobrist indexing.</div>
						</div>

						<div class="sync-info-card">
							<div class="sync-info-label">Games Stored</div>
							<div class="sync-info-value">@_onlineDbGamesCount.ToString("N0")</div>
							<div class="sync-info-desc">Total online games downloaded and indexed.</div>
						</div>

						<div class="sync-info-card">
							<div class="sync-info-label">Last Sync</div>
							<div class="sync-info-value">@FormattedLastSync</div>
							<div class="sync-info-desc">Timestamp of previous sync pass.</div>
						</div>
					</div>

					<div class="section-divider"></div>

					<div class="card-section-header">
						<h4 class="card-section-subtitle">Sync Preferences</h4>
					</div>

					<div class="control-form-grid">
						<div class="form-field-block">
							<label class="field-label">Batch Size / History Limit</label>
							<select class="field-select" @bind="_syncConfig.MaxGamesPerPlatform">
								<option value="50">Latest 50 games per platform</option>
								<option value="100">Latest 100 games per platform (Recommended)</option>
								<option value="250">Latest 250 games per platform</option>
								<option value="500">Latest 500 games per platform</option>
							</select>
							<span class="field-hint">Limits the number of recent games queried per sync pass.</span>
						</div>
					</div>

					<div class="sync-accounts-summary">
						<div class="summary-label">Configured Handles:</div>
						<div class="summary-handles-row">
							<div class="summary-handle-item">
								<span class="platform-badge platform-badge-lichess">♞ Lichess</span>
								<span class="handle-name">@(!string.IsNullOrEmpty(_profile.LichessUsername) ? _profile.LichessUsername : "Not configured")</span>
							</div>
							<div class="summary-handle-item">
								<span class="platform-badge platform-badge-chesscom">♟️ Chess.com</span>
								<span class="handle-name">@(!string.IsNullOrEmpty(_profile.ChessComUsername) ? _profile.ChessComUsername : "Not configured")</span>
							</div>
							<button class="btn-link" @onclick='() => SetCategory("profile")'>Edit in Profile ➔</button>
						</div>
					</div>

					<div class="form-action-bar">
						<button class="btn-secondary" @onclick="SaveSyncPreferencesAsync">Save Sync Preferences</button>
						<button class="btn-primary" @onclick="() => _showSyncModal = true">🔄 Sync Online Games Now</button>
						@if (_syncConfigSaved)
						{
							<span class="save-status-badge">✅ Preferences saved!</span>
						}
					</div>
				</div>
			}

			@if (_activeCategory == "updates")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">🚀 Application Updates &amp; About</h3>
						<p class="card-section-desc">Manage desktop software updates, check GitHub releases, and view release notes.</p>
					</div>

					<div class="update-settings-grid">
						<div class="update-info-card">
							<div class="update-info-label">Installed Version</div>
							<div class="update-info-value">
								<span class="version-badge version-badge-current">v@_currentVersion</span>
								<span class="version-os-badge">@RuntimeInformation.OSDescription</span>
							</div>
						</div>

						<div class="update-info-card">
							<div class="update-info-label">Update Status</div>
							<div class="update-info-value">
								@if (_isCheckingUpdates)
								{
									<span class="update-status-checking">Checking for updates...</span>
								}
								else if (_latestUpdate != null && _latestUpdate.IsUpdateAvailable)
								{
									<span class="update-status-available">New version v@_latestUpdate.LatestVersion available!</span>
								}
								else
								{
									<span class="update-status-uptodate">You have the latest version.</span>
								}
							</div>
						</div>
					</div>

					<div class="modal-form-group">
						<label class="filter-label">GitHub Repository Source</label>
						<div class="repo-input-group">
							<input class="modal-input" placeholder="owner/repo (e.g. tomask/Caissalytics)" @bind="_updateSettings.Repository" />
							<button class="btn-secondary" @onclick="SaveUpdateSettingsAsync">Save Repository</button>
						</div>
						<div class="form-hint-text">Release packages and changelogs will be checked against this GitHub repository.</div>
					</div>

					<div class="settings-checkbox-row">
						<label class="checkbox-label">
							<input type="checkbox" @bind="_updateSettings.AutoCheckOnStartup" @bind:after="SaveUpdateSettingsAsync" />
							<span>Automatically check for updates on startup</span>
						</label>
					</div>

					<div class="form-action-bar">
						<button class="btn-primary" disabled="@_isCheckingUpdates" @onclick="CheckForUpdatesNowAsync">
							@(_isCheckingUpdates ? "Checking..." : "🔍 Check for Updates Now")
						</button>

						@if (_latestUpdate != null && _latestUpdate.IsUpdateAvailable)
						{
							<button class="btn-primary" @onclick="() => _showUpdateDialogFromSettings = true">
								🚀 View Release &amp; Install Update
							</button>
						}

						@if (_updateSettingsSaved)
						{
							<span class="save-status-badge">✅ Settings saved!</span>
						}
					</div>

					@if (_latestUpdate != null && !string.IsNullOrWhiteSpace(_latestUpdate.ReleaseNotes))
					{
						<div class="update-notes-container">
							<h4 class="update-notes-title">Latest Release: @_latestUpdate.ReleaseTitle</h4>
							<div class="update-notes-scroll">
								<pre class="update-notes-pre">@_latestUpdate.ReleaseNotes</pre>
							</div>
						</div>
					}
				</div>
			}

			@if (_activeCategory == "appearance")
			{
				<div class="control-section-card">
					<div class="card-section-header">
						<h3 class="card-section-title">🎨 Visual Board Themes</h3>
						<p class="card-section-desc">Select your preferred vector chessboard styling. Crisp rendering at all display resolutions.</p>
					</div>

					<div class="board-themes-grid">
						@foreach (var theme in AppearanceSettings.AvailableBoardThemes)
						{
							bool isSelected = _appearanceSettings.BoardTheme == theme;
							<div class="theme-card @(isSelected ? "theme-card-selected" : "")" @onclick="() => SelectBoardTheme(theme)">
								<div class="board-theme-swatch swatch-@theme">
									<div class="swatch-sq swatch-light"></div>
									<div class="swatch-sq swatch-dark"></div>
									<div class="swatch-sq swatch-dark"></div>
									<div class="swatch-sq swatch-light"></div>
								</div>
								<div class="theme-card-info">
									<div class="theme-card-name">@GetThemeDisplayName(theme)</div>
									<div class="theme-card-desc">@GetThemeDescription(theme)</div>
								</div>
								@if (isSelected)
								{
									<span class="theme-active-pill">Active</span>
								}
							</div>
						}
					</div>

					<div class="section-divider"></div>

					<div class="card-section-header">
						<h3 class="card-section-title">🔊 Chess Sound Engine</h3>
						<p class="card-section-desc">Zero-latency synthesized audio effects powered by Web Audio API.</p>
					</div>

					<div class="audio-settings-card">
						<div class="audio-master-row">
							<div class="toggle-switch-wrapper">
								<input type="checkbox" id="masterSoundToggle" class="switch-input"
									   checked="@_appearanceSettings.SoundEnabled"
									   @onchange="ToggleMasterSound" />
								<label for="masterSoundToggle" class="switch-slider"></label>
							</div>
							<div class="audio-master-label">
								<span class="audio-master-title">Enable Sound Effects</span>
								<span class="audio-master-desc">Play acoustic cues for moves, captures, checks, and achievements.</span>
							</div>
						</div>

						@if (_appearanceSettings.SoundEnabled)
						{
							<div class="audio-volume-panel">
								<div class="volume-slider-header">
									<span class="volume-label">Master Volume</span>
									<span class="volume-value-badge">@_appearanceSettings.Volume%</span>
								</div>
								<div class="volume-slider-row">
									<span class="volume-icon">🔈</span>
									<input type="range" class="volume-slider-input" min="0" max="100" step="5"
										   value="@_appearanceSettings.Volume"
										   @oninput="HandleVolumeChanged" />
									<span class="volume-icon">🔊</span>
								</div>
							</div>

							<div class="sound-events-section">
								<h4 class="card-section-subtitle">Sound Triggers &amp; Sound Test</h4>
								<div class="sound-events-grid">
									<div class="sound-event-row">
										<label class="sound-checkbox-label">
											<input type="checkbox" class="sound-check-box"
												   checked="@_appearanceSettings.PlayMoveSound"
												   @onchange='e => ToggleSoundEvent("move", e)' />
											<span>Move (tactile wood click)</span>
										</label>
										<button class="sound-test-btn" @onclick='() => TestSound(ChessSoundType.Move)' title="Test Move Sound">
											<span>▶ Test</span>
										</button>
									</div>

									<div class="sound-event-row">
										<label class="sound-checkbox-label">
											<input type="checkbox" class="sound-check-box"
												   checked="@_appearanceSettings.PlayCaptureSound"
												   @onchange='e => ToggleSoundEvent("capture", e)' />
											<span>Capture (crisp mechanical snap)</span>
										</label>
										<button class="sound-test-btn" @onclick='() => TestSound(ChessSoundType.Capture)' title="Test Capture Sound">
											<span>▶ Test</span>
										</button>
									</div>

									<div class="sound-event-row">
										<label class="sound-checkbox-label">
											<input type="checkbox" class="sound-check-box"
												   checked="@_appearanceSettings.PlayCheckSound"
												   @onchange='e => ToggleSoundEvent("check", e)' />
											<span>Check (dual-tone alert chime)</span>
										</label>
										<button class="sound-test-btn" @onclick='() => TestSound(ChessSoundType.Check)' title="Test Check Sound">
											<span>▶ Test</span>
										</button>
									</div>

									<div class="sound-event-row">
										<label class="sound-checkbox-label">
											<input type="checkbox" class="sound-check-box"
												   checked="@_appearanceSettings.PlayVictorySound"
												   @onchange='e => ToggleSoundEvent("victory", e)' />
											<span>Victory / Puzzle Solved (major triad chime)</span>
										</label>
										<button class="sound-test-btn" @onclick='() => TestSound(ChessSoundType.Victory)' title="Test Victory Sound">
											<span>▶ Test</span>
										</button>
									</div>

									<div class="sound-event-row">
										<label class="sound-checkbox-label">
											<input type="checkbox" class="sound-check-box"
												   checked="@_appearanceSettings.PlayLowTimeSound"
												   @onchange='e => ToggleSoundEvent("lowtime", e)' />
											<span>Low Time (clock tick alert)</span>
										</label>
										<button class="sound-test-btn" @onclick='() => TestSound(ChessSoundType.LowTime)' title="Test Low Time Sound">
											<span>▶ Test</span>
										</button>
									</div>
								</div>
							</div>
						}

						<div class="form-action-row">
							<button class="btn btn-primary" @onclick="SaveAppearanceSettingsAsync">
								💾 Save Preferences
							</button>
							@if (_appearanceSettingsSaved)
							{
								<span class="save-status-badge">✓ Preferences saved!</span>
							}
						</div>
					</div>
				</div>
			}
		</main>
	</div>
</div>

<OnlineGamesSyncDialog IsOpen="_showSyncModal"
					   OnClose="HandleSyncModalClosed"
					   OnDatabaseSelected="HandleOnlineDbSelected" />

<UpdateDialog IsOpen="_showUpdateDialogFromSettings"
			  Update="_latestUpdate"
			  OnClose="() => _showUpdateDialogFromSettings = false" />

@code {
	[Parameter] public SettingsTab Tab { get; set; } = default!;

	private string _activeCategory = "profile";

	// Profile State
	private UserProfile _profile = new();
	private bool _profileSaved = false;

	// Engines State
	private List<EngineInfo> _engines = new();
	private bool _isInstalling = false;
	private string _installingEngineId = "";
	private int _installProgress = 0;
	private EngineProbeResult? _handshakeResult;
	private string _addEngineMode = "local";
	private string _customExecutablePath = "";
	private string _customDisplayName = "";
	private bool _isProbing = false;
	private string _customAddError = "";
	private string _customAddSuccess = "";
	private bool _isScanning = false;
	private string _scanResultText = "";

	// Online Sync State
	private OnlineSyncConfig _syncConfig = new();
	private bool _syncConfigSaved = false;
	private int _onlineDbGamesCount = 0;
	private bool _showSyncModal = false;

	// Updates State
	private UpdateSettings _updateSettings = new();
	private UpdateInfo? _latestUpdate;
	private string _currentVersion = "";
	private bool _isCheckingUpdates = false;
	private bool _updateSettingsSaved = false;
	private bool _showUpdateDialogFromSettings = false;

	// Appearance & Audio State
	private AppearanceSettings _appearanceSettings = new();
	private bool _appearanceSettingsSaved = false;

	// Tablebase State
	private string? _localSyzygyPath;
	private bool _onlineTbEnabled = true;
	private string _testTbFen = "8/8/8/4k3/8/4P3/4K3/8 w - - 0 1";
	private bool _isProbingTb = false;
	private TablebaseResult? _testTbResult;
	private bool _syzygyPathSaved = false;

	private string FormattedLastSync => _syncConfig.LastSyncUtc.HasValue
		? _syncConfig.LastSyncUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
		: "Never";

	protected override async Task OnInitializedAsync()
	{
		EngineService.OnEnginesChanged += HandleEnginesChanged;
		ProfileService.OnProfileChanged += HandleProfileChanged;
		UpdateService.OnUpdateStateChanged += HandleUpdateChanged;

		_currentVersion = UpdateService.GetCurrentVersion();
		_latestUpdate = UpdateService.CachedUpdate;
		_updateSettings = await UpdateService.GetSettingsAsync();
		_appearanceSettings = await AppearanceService.GetSettingsAsync();

		await LoadProfileAsync();
		await LoadEnginesAsync();
		await LoadSyncConfigAsync();
		await LoadOnlineDatabaseInfoAsync();

		_localSyzygyPath = TablebaseService.LocalSyzygyPath ?? EngineService.SyzygyPath;
		_onlineTbEnabled = TablebaseService.IsOnlineProbeEnabled;
	}

	private async Task SaveSyzygyPathAsync()
	{
		TablebaseService.LocalSyzygyPath = _localSyzygyPath;
		await EngineService.SetSyzygyPathAsync(_localSyzygyPath);
		_syzygyPathSaved = true;
		_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _syzygyPathSaved = false; StateHasChanged(); }));
	}

	private void ToggleOnlineTb(ChangeEventArgs e)
	{
		if (e.Value is bool b)
		{
			_onlineTbEnabled = b;
			TablebaseService.IsOnlineProbeEnabled = b;
		}
	}

	private async Task TestProbeFenAsync()
	{
		if (string.IsNullOrWhiteSpace(_testTbFen)) return;
		_isProbingTb = true;
		StateHasChanged();
		try
		{
			_testTbResult = await TablebaseService.ProbePositionAsync(_testTbFen);
		}
		catch (Exception ex)
		{
			_testTbResult = new TablebaseResult { Success = false, ErrorMessage = ex.Message };
		}
		finally
		{
			_isProbingTb = false;
			StateHasChanged();
		}
	}

	private void SetCategory(string category)
	{
		_activeCategory = category;
		_handshakeResult = null;
		_customAddError = "";
		_customAddSuccess = "";
		_scanResultText = "";
	}

	private string GetNavClass(string category)
	{
		return _activeCategory == category ? "control-nav-item nav-item-active" : "control-nav-item";
	}

	private string GetAddModeClass(string mode)
	{
		return _addEngineMode == mode ? "mode-tab-btn mode-tab-active" : "mode-tab-btn";
	}

	private async Task LoadProfileAsync()
	{
		_profile = await ProfileService.GetProfileAsync();
	}

	private async Task LoadEnginesAsync()
	{
		var list = await EngineService.GetEnginesAsync();
		_engines = list.ToList();
	}

	private async Task LoadSyncConfigAsync()
	{
		_syncConfig = await SyncService.GetConfigAsync();
	}

	private async Task LoadOnlineDatabaseInfoAsync()
	{
		try
		{
			var databases = await DatabaseService.GetDatabasesAsync();
			var onlineDb = databases.FirstOrDefault(d => d.Name == SyncService.OnlineGamesDatabaseName);
			_onlineDbGamesCount = onlineDb?.GameCount ?? 0;
		}
		catch { }
	}

	private async Task SaveProfileAsync()
	{
		await ProfileService.SaveProfileAsync(_profile);
		_profileSaved = true;
		_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _profileSaved = false; StateHasChanged(); }));
	}

	private async Task SetActiveEngineAsync(string engineId)
	{
		await EngineService.SetActiveEngineAsync(engineId);
		await LoadEnginesAsync();
	}

	private async Task TestEngineHandshakeAsync(EngineInfo engine)
	{
		if (string.IsNullOrEmpty(engine.ExecutablePath)) return;
		_handshakeResult = await EngineService.ProbeEngineFileAsync(engine.ExecutablePath);
	}

	private async Task RemoveCustomEngineAsync(string engineId)
	{
		await EngineService.RemoveEngineAsync(engineId);
		await LoadEnginesAsync();
	}

	private async Task InstallEngineAsync(string engineId)
	{
		_isInstalling = true;
		_installingEngineId = engineId;
		_installProgress = 0;

		var progress = new Progress<int>(p =>
		{
			_installProgress = p;
			InvokeAsync(StateHasChanged);
		});

		await EngineService.InstallEngineAsync(engineId, progress);
		_isInstalling = false;
		_installingEngineId = "";
		await LoadEnginesAsync();
	}

	private async Task AddLocalEngineAsync()
	{
		_isProbing = true;
		_customAddError = "";
		_customAddSuccess = "";

		try
		{
			var probe = await EngineService.ProbeEngineFileAsync(_customExecutablePath.Trim());
			if (!probe.Success)
			{
				_customAddError = probe.ErrorMessage ?? "Engine probe failed.";
				return;
			}

			bool added = await EngineService.AddCustomEngineAsync(_customDisplayName.Trim(), _customExecutablePath.Trim());
			if (added)
			{
				_customAddSuccess = $"Successfully registered engine: {probe.Name}!";
				_customExecutablePath = "";
				_customDisplayName = "";
				await LoadEnginesAsync();
			}
			else
			{
				_customAddError = "Failed to add engine.";
			}
		}
		catch (Exception ex)
		{
			_customAddError = ex.Message;
		}
		finally
		{
			_isProbing = false;
		}
	}

	private async Task ScanSystemEnginesAsync()
	{
		_isScanning = true;
		_scanResultText = "";

		try
		{
			var newEngines = await EngineService.ScanSystemEnginesAsync();
			if (newEngines.Count > 0)
			{
				_scanResultText = $"Found and registered {newEngines.Count} new chess engine(s): {string.Join(", ", newEngines.Select(e => e.Name))}!";
				await LoadEnginesAsync();
			}
			else
			{
				_scanResultText = "Scan complete. No new chess engines found in standard system directories.";
			}
		}
		catch (Exception ex)
		{
			_scanResultText = $"Error during scan: {ex.Message}";
		}
		finally
		{
			_isScanning = false;
		}
	}

	private async Task SaveSyncPreferencesAsync()
	{
		await SyncService.SaveConfigAsync(_syncConfig);
		_syncConfigSaved = true;
		_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _syncConfigSaved = false; StateHasChanged(); }));
	}

	private async Task HandleSyncModalClosed()
	{
		_showSyncModal = false;
		await LoadSyncConfigAsync();
		await LoadOnlineDatabaseInfoAsync();
	}

	private async Task HandleOnlineDbSelected(string dbName)
	{
		_showSyncModal = false;
		await DatabaseService.SetActiveDatabaseAsync(dbName);
		Workspace.CreateDatabaseTab();
	}

	private async void HandleEnginesChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadEnginesAsync();
			StateHasChanged();
		});
	}

	private async void HandleProfileChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadProfileAsync();
			await LoadSyncConfigAsync();
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		EngineService.OnEnginesChanged -= HandleEnginesChanged;
		ProfileService.OnProfileChanged -= HandleProfileChanged;
		UpdateService.OnUpdateStateChanged -= HandleUpdateChanged;
	}

	private async Task CheckForUpdatesNowAsync()
	{
		_isCheckingUpdates = true;
		StateHasChanged();
		try
		{
			_latestUpdate = await UpdateService.CheckForUpdatesAsync(force: true);
		}
		finally
		{
			_isCheckingUpdates = false;
			StateHasChanged();
		}
	}

	private async Task SaveUpdateSettingsAsync()
	{
		await UpdateService.SaveSettingsAsync(_updateSettings);
		_updateSettingsSaved = true;
		_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _updateSettingsSaved = false; StateHasChanged(); }));
	}

	private async void HandleUpdateChanged(UpdateInfo update)
	{
		await InvokeAsync(() =>
		{
			_latestUpdate = update;
			StateHasChanged();
		});
	}

	private static string GetThemeDisplayName(string theme) => theme switch
	{
		"brown" => "Classic Walnut",
		"green" => "Tournament Green",
		"blue" => "Ocean Blue",
		"slate" => "Dark Slate",
		"marble" => "Cool Marble",
		"monochrome" => "Monochrome",
		_ => theme
	};

	private static string GetThemeDescription(string theme) => theme switch
	{
		"brown" => "Warm traditional wooden board styling.",
		"green" => "Standard FIDE tournament & club green.",
		"blue" => "Calming ocean azure with cool contrast.",
		"slate" => "Contemporary dark charcoal slate.",
		"marble" => "Clean frost-textured marble aesthetic.",
		"monochrome" => "High-contrast vintage newspaper print.",
		_ => ""
	};

	private async Task SelectBoardTheme(string theme)
	{
		_appearanceSettings.BoardTheme = theme;
		await AppearanceService.SaveSettingsAsync(_appearanceSettings);
	}

	private async Task ToggleMasterSound(ChangeEventArgs e)
	{
		if (e.Value is bool b)
		{
			_appearanceSettings.SoundEnabled = b;
			await AppearanceService.SaveSettingsAsync(_appearanceSettings);
		}
	}

	private async Task HandleVolumeChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int vol))
		{
			_appearanceSettings.Volume = vol;
			await AppearanceService.SaveSettingsAsync(_appearanceSettings);
		}
	}

	private async Task ToggleSoundEvent(string ev, ChangeEventArgs e)
	{
		bool val = e.Value is bool b && b;
		switch (ev)
		{
			case "move": _appearanceSettings.PlayMoveSound = val; break;
			case "capture": _appearanceSettings.PlayCaptureSound = val; break;
			case "check": _appearanceSettings.PlayCheckSound = val; break;
			case "victory": _appearanceSettings.PlayVictorySound = val; break;
			case "lowtime": _appearanceSettings.PlayLowTimeSound = val; break;
		}
		await AppearanceService.SaveSettingsAsync(_appearanceSettings);
	}

	private async Task TestSound(ChessSoundType soundType)
	{
		await AppearanceService.PlaySoundAsync(soundType);
	}

	private async Task SaveAppearanceSettingsAsync()
	{
		await AppearanceService.SaveSettingsAsync(_appearanceSettings);
		_appearanceSettingsSaved = true;
		_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _appearanceSettingsSaved = false; StateHasChanged(); }));
	}
}
