@namespace Caissalytics.Components.Layout
@using Caissalytics.Data
@using Caissalytics.Components.Settings
@inject WorkspaceState Workspace
@inject IDatabaseService DatabaseService
@inject IUpdateService UpdateService
@inject ISkppIntegrationService SkppService
@implements IDisposable

<header class="app-header">
	<div class="app-brand">
		<span class="brand-title">@Loc["Nav_Brand"]</span>
		<span class="brand-badge">v@(UpdateService.GetCurrentVersion())</span>
	</div>
	<div class="header-actions">
		@if (_availableUpdate != null && _availableUpdate.IsUpdateAvailable)
		{
			<button class="header-update-pill"
					title="New version v@(_availableUpdate.LatestVersion) is available! Click to update."
					@onclick="() => _showUpdateDialog = true">
				<span class="update-pill-icon">🚀</span>
				<span class="update-pill-text">@Loc["Nav_Update", _availableUpdate.LatestVersion]</span>
			</button>
		}
		@if (_activeDb != null)
		{
			<button class="btn-secondary header-db-btn"
					title="Active Database: @_activeDb.Name (@_activeDb.GameCount.ToString("N0") games, @_activeDb.FormattedSize) - Click to explore"
					@onclick="() => Workspace.CreateDatabaseTab()">
				<span class="header-db-icon">🗄️</span>
				<span class="header-db-name">@_activeDb.Name</span>
				<span class="header-db-details">(@_activeDb.GameCount.ToString("N0") games, @_activeDb.FormattedSize)</span>
			</button>
		}
		else
		{
			<button class="btn-secondary header-db-btn"
					title="Open Database"
					@onclick="() => Workspace.CreateDatabaseTab()">
				<span class="header-db-icon">🗄️</span>
				<span class="header-db-name">@Loc["Nav_Database"]</span>
			</button>
		}
		<button class="btn-secondary header-messages-btn @(_unreadMessagesCount > 0 ? "has-unread" : "")"
				title="@Loc["Nav_Messages_Tooltip"]"
				@onclick="() => Workspace.CreateMessagesTab()">
			<svg class="header-btn-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
				<polyline points="22,6 12,13 2,6"/>
			</svg>
			<span class="header-messages-label">@Loc["Nav_Messages"]</span>
			@if (_unreadMessagesCount > 0)
			{
				<span class="messages-unread-badge">@_unreadMessagesCount</span>
			}
		</button>
		<button class="btn-secondary header-control-btn"
				title="Open Settings & Control Center (User profile, engine management, sync accounts)"
				@onclick="() => Workspace.CreateSettingsTab()">
			<span>⚙️</span>
			<span class="header-control-label">@Loc["Nav_ControlCenter"]</span>
		</button>
		<button class="btn-primary" @onclick="() => Workspace.CreateAnalysisTab()">@Loc["Nav_NewBoard"]</button>
	</div>
</header>

<nav class="workspace-tabs-container">
	<div class="tab-list">
		@foreach (var tab in Workspace.Tabs)
		{
			bool isActive = tab == Workspace.ActiveTab;
			string tabClass = isActive ? "workspace-tab tab-active" : "workspace-tab";

			<button class="@tabClass" @onclick="() => Workspace.SelectTab(tab.Id)">
				<span class="tab-icon">
					@if (tab is ClubMessagesTab)
					{
						<svg class="tab-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 2px;">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
					}
					else if (tab is ClubHomeworkTab)
					{
						<svg class="tab-svg-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 2px;">
							<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
							<polyline points="8 13 12 17 16 13"/>
							<line x1="12" y1="9" x2="12" y2="17"/>
						</svg>
					}
					else
					{
						@tab.Icon
					}
				</span>
				<span>@GetTabTitle(tab)</span>
				@if (tab.CanClose)
				{
					<span class="tab-close-btn" @onclick="() => Workspace.CloseTab(tab.Id)" @onclick:stopPropagation="true">✕</span>
				}
			</button>
		}
		<button class="new-tab-btn" title="Open new analysis board" @onclick="() => Workspace.CreateAnalysisTab()">+</button>
	</div>
</nav>

<UpdateDialog IsOpen="_showUpdateDialog"
			  Update="_availableUpdate"
			  OnClose="() => _showUpdateDialog = false" />

@code {
	private DatabaseInfo? _activeDb;
	private UpdateInfo? _availableUpdate;
	private bool _showUpdateDialog = false;
	private int _unreadMessagesCount = 0;

	protected override async Task OnInitializedAsync()
	{
		Workspace.OnChange += StateHasChanged;
		DatabaseService.OnActiveDatabaseChanged += HandleDatabaseChanged;
		DatabaseService.OnDatabaseModified += HandleDatabaseModified;
		UpdateService.OnUpdateStateChanged += HandleUpdateStateChanged;
		Loc.OnLanguageChanged += StateHasChanged;
		SkppService.OnUnreadCountChanged += HandleUnreadCountChanged;
		SkppService.OnConnectionStateChanged += HandleSkppStateChanged;

		_unreadMessagesCount = SkppService.UnreadMessageCount;
		_availableUpdate = UpdateService.CachedUpdate;
		await LoadActiveDatabaseAsync();
		_ = SkppService.CheckUnreadMessagesAsync();
	}

	private void HandleUnreadCountChanged(int count)
	{
		_unreadMessagesCount = count;
		InvokeAsync(StateHasChanged);
	}

	private void HandleSkppStateChanged()
	{
		_unreadMessagesCount = SkppService.UnreadMessageCount;
		InvokeAsync(StateHasChanged);
	}

	private async Task LoadActiveDatabaseAsync()
	{
		try
		{
			_activeDb = await DatabaseService.GetActiveDatabaseAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[WorkspaceTabs] Error loading active database: {ex.Message}");
		}
	}

	private async void HandleDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadActiveDatabaseAsync();
			StateHasChanged();
		});
	}

	private async void HandleDatabaseModified(string dbName)
	{
		await InvokeAsync(async () =>
		{
			await LoadActiveDatabaseAsync();
			StateHasChanged();
		});
	}

	private async void HandleUpdateStateChanged(UpdateInfo update)
	{
		await InvokeAsync(() =>
		{
			_availableUpdate = update;
			StateHasChanged();
		});
	}

	private string GetTabTitle(WorkspaceTab tab) => tab switch
	{
		DashboardTab => Loc["Tab_Dashboard"],
		DatabaseBrowserTab => Loc["Tab_Database"],
		SettingsTab => Loc["Tab_Settings"],
		AnalyticsTab => Loc["Tab_Analytics"],
		PuzzleTrainerTab => Loc["Tab_Puzzles"],
		RepertoireExplorerTab => Loc["Tab_Repertoire"],
		OpponentDossierTab => Loc["Tab_OpponentDossier"],
		EndgameTrainerTab => Loc["Tab_Endgames"],
		HomeworkTab => Loc["Tab_Homework"],
		ClubHomeworkTab => Loc["Tab_ClubHomework"],
		ClubMessagesTab => Loc["Tab_Messages"],
		AnalysisTab a when a.Title == "Analysis Board" => Loc["Tab_Analysis"],
		_ => tab.Title
	};

	public void Dispose()
	{
		Workspace.OnChange -= StateHasChanged;
		DatabaseService.OnActiveDatabaseChanged -= HandleDatabaseChanged;
		DatabaseService.OnDatabaseModified -= HandleDatabaseModified;
		UpdateService.OnUpdateStateChanged -= HandleUpdateStateChanged;
		Loc.OnLanguageChanged -= StateHasChanged;
		SkppService.OnUnreadCountChanged -= HandleUnreadCountChanged;
		SkppService.OnConnectionStateChanged -= HandleSkppStateChanged;
	}
}
