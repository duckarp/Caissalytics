@namespace Caissalytics.Components.Layout
@using Caissalytics.Data
@inject WorkspaceState Workspace
@inject IDatabaseService DatabaseService
@implements IDisposable

<header class="app-header">
	<div class="app-brand">
		<span class="brand-title">Caissalytics</span>
		<span class="brand-badge">Alpha</span>
	</div>
	<div class="header-actions">
		@if (_activeDb != null)
		{
			<button class="btn-secondary header-db-btn"
					title="Active Database: @_activeDb.Name (@_activeDb.GameCount.ToString("N0") games, @_activeDb.FormattedSize) - Click to explore"
					@onclick="() => Workspace.CreateDatabaseTab()">
				<span class="header-db-icon">🗄️</span>
				<span class="header-db-name">@_activeDb.Name</span>
				<span class="header-db-details">(@_activeDb.GameCount.ToString("N0") games, @_activeDb.FormattedSize)</span>
			</button>
		}
		else
		{
			<button class="btn-secondary header-db-btn"
					title="Open Database"
					@onclick="() => Workspace.CreateDatabaseTab()">
				<span class="header-db-icon">🗄️</span>
				<span class="header-db-name">Database</span>
			</button>
		}
		<button class="btn-primary" @onclick="() => Workspace.CreateAnalysisTab()">+ New Board</button>
	</div>
</header>

<nav class="workspace-tabs-container">
	<div class="tab-list">
		@foreach (var tab in Workspace.Tabs)
		{
			bool isActive = tab == Workspace.ActiveTab;
			string tabClass = isActive ? "workspace-tab tab-active" : "workspace-tab";

			<button class="@tabClass" @onclick="() => Workspace.SelectTab(tab.Id)">
				<span class="tab-icon">@tab.Icon</span>
				<span>@tab.Title</span>
				@if (tab.CanClose)
				{
					<span class="tab-close-btn" @onclick="() => Workspace.CloseTab(tab.Id)" @onclick:stopPropagation="true">✕</span>
				}
			</button>
		}
		<button class="new-tab-btn" title="Open new analysis board" @onclick="() => Workspace.CreateAnalysisTab()">+</button>
	</div>
</nav>

@code {
	private DatabaseInfo? _activeDb;

	protected override async Task OnInitializedAsync()
	{
		Workspace.OnChange += StateHasChanged;
		DatabaseService.OnActiveDatabaseChanged += HandleDatabaseChanged;
		DatabaseService.OnDatabaseModified += HandleDatabaseModified;
		await LoadActiveDatabaseAsync();
	}

	private async Task LoadActiveDatabaseAsync()
	{
		try
		{
			_activeDb = await DatabaseService.GetActiveDatabaseAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[WorkspaceTabs] Error loading active database: {ex.Message}");
		}
	}

	private async void HandleDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			await LoadActiveDatabaseAsync();
			StateHasChanged();
		});
	}

	private async void HandleDatabaseModified(string dbName)
	{
		await InvokeAsync(async () =>
		{
			await LoadActiveDatabaseAsync();
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		Workspace.OnChange -= StateHasChanged;
		DatabaseService.OnActiveDatabaseChanged -= HandleDatabaseChanged;
		DatabaseService.OnDatabaseModified -= HandleDatabaseModified;
	}
}
