@namespace Caissalytics.Components.Dashboard
@using Caissalytics.Data
@using Caissalytics.Components.Database
@inject WorkspaceState Workspace
@inject IDatabaseService DatabaseService
@inject IUserProfileService ProfileService
@inject IOnlineGameSyncService SyncService
@implements IDisposable

<div class="dashboard-container">
	<div class="dashboard-hero">
		<h1 class="dashboard-heading">@Loc["Dash_Welcome"]</h1>
		<p class="dashboard-subtitle">@Loc["Dash_Subtitle"]</p>
	</div>

	<div class="quick-actions-grid">
		<div class="action-card" @onclick="() => Workspace.CreateAnalysisTab()">
			<div class="card-icon">♟️</div>
			<h2 class="card-title">@Loc["Dash_Card_Analysis"]</h2>
			<p class="card-description">@Loc["Dash_Card_Analysis_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateDatabaseTab()">
			<div class="card-icon">🗄️</div>
			<h2 class="card-title">@Loc["Dash_Card_Databases"]</h2>
			<p class="card-description">@Loc["Dash_Card_Databases_Desc"]</p>
		</div>

		<label class="action-card">
			<div class="card-icon">📂</div>
			<h2 class="card-title">@Loc["Dash_Card_OpenPgn"]</h2>
			<p class="card-description">@Loc["Dash_Card_OpenPgn_Desc"]</p>
			<InputFile OnChange="HandlePgnUpload" class="hidden-file-input" accept=".pgn" />
		</label>

		<div class="action-card" @onclick="HandleMyOnlineGamesClicked">
			<div class="card-icon">🌐</div>
			<h2 class="card-title">@Loc["Dash_Card_OnlineGames"]</h2>
			<p class="card-description">@Loc["Dash_Card_OnlineGames_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreatePuzzleTrainerTab()">
			<div class="card-icon">🧩</div>
			<h2 class="card-title">@Loc["Dash_Card_Puzzles"]</h2>
			<p class="card-description">@Loc["Dash_Card_Puzzles_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateRepertoireTab()">
			<div class="card-icon">📖</div>
			<h2 class="card-title">@Loc["Dash_Card_Repertoire"]</h2>
			<p class="card-description">@Loc["Dash_Card_Repertoire_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateOpponentDossierTab()">
			<div class="card-icon">🕵️‍♂️</div>
			<h2 class="card-title">@Loc["Dash_Card_Dossier"]</h2>
			<p class="card-description">@Loc["Dash_Card_Dossier_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateEndgameTrainerTab()">
			<div class="card-icon">🏆</div>
			<h2 class="card-title">@Loc["Dash_Card_Endgames"]</h2>
			<p class="card-description">@Loc["Dash_Card_Endgames_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateAnalyticsTab()">
			<div class="card-icon">📊</div>
			<h2 class="card-title">@Loc["Nav_Insights"]</h2>
			<p class="card-description">@Loc["Dash_Card_Insights_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateHomeworkTab()">
			<div class="card-icon">📝</div>
			<h2 class="card-title">@Loc["Dash_Card_Homework"]</h2>
			<p class="card-description">@Loc["Dash_Card_Homework_Desc"]</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateSettingsTab()">
			<div class="card-icon">⚙️</div>
			<h2 class="card-title">@Loc["Dash_Card_Settings"]</h2>
			<p class="card-description">@Loc["Dash_Card_Settings_Desc"]</p>
		</div>
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		Loc.OnLanguageChanged += HandleLanguageChanged;
	}

	public void Dispose()
	{
		Loc.OnLanguageChanged -= HandleLanguageChanged;
	}

	private void HandleLanguageChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async Task HandleMyOnlineGamesClicked()
	{
		var profile = await ProfileService.GetProfileAsync();
		bool hasHandle = profile.HasLichess || profile.HasChessCom;

		if (hasHandle)
		{
			string onlineDbName = SyncService.OnlineGamesDatabaseName;
			var existingDbs = await DatabaseService.GetDatabasesAsync();
			if (!existingDbs.Any(d => string.Equals(d.Name, onlineDbName, StringComparison.OrdinalIgnoreCase)))
			{
				await DatabaseService.CreateDatabaseAsync(onlineDbName);
			}

			await DatabaseService.SetActiveDatabaseAsync(onlineDbName);
			Workspace.CreateDatabaseTab(onlineDbName);
		}
		else
		{
			Workspace.CreateSettingsTab("sync");
		}
	}

	private async Task HandlePgnUpload(InputFileChangeEventArgs e)
	{
		try
		{
			using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
			using var reader = new StreamReader(stream);
			string pgn = await reader.ReadToEndAsync();
			string title = Path.GetFileNameWithoutExtension(e.File.Name);
			Workspace.CreateAnalysisTab(title: title, pgn: pgn);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Dashboard] Failed to read PGN: {ex.Message}");
		}
	}
}
