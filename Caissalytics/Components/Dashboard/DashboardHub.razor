@namespace Caissalytics.Components.Dashboard
@using Caissalytics.Data
@using Caissalytics.Components.Database
@inject WorkspaceState Workspace
@inject IDatabaseService DatabaseService

<div class="dashboard-container">
	<div class="dashboard-hero">
		<h1 class="dashboard-heading">Welcome to Caissalytics</h1>
		<p class="dashboard-subtitle">A modern, open-source chess analysis and database platform.</p>
	</div>

	<div class="quick-actions-grid">
		<div class="action-card" @onclick="() => Workspace.CreateAnalysisTab()">
			<div class="card-icon">♟️</div>
			<h2 class="card-title">New Analysis Board</h2>
			<p class="card-description">Open an interactive board to explore moves, build variations, annotate with glyphs, and run Stockfish.</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateDatabaseTab()">
			<div class="card-icon">🗄️</div>
			<h2 class="card-title">Browse Databases</h2>
			<p class="card-description">Manage collections, search games by player, ECO, or Elo, and import your PGN libraries.</p>
		</div>

		<label class="action-card">
			<div class="card-icon">📂</div>
			<h2 class="card-title">Open PGN File</h2>
			<p class="card-description">Import a game or study from your computer. Supports full notation, branching variations, and annotations.</p>
			<InputFile OnChange="HandlePgnUpload" class="hidden-file-input" accept=".pgn" />
		</label>

		<div class="action-card" @onclick="() => _showOnlineSyncModal = true">
			<div class="card-icon">🌐</div>
			<h2 class="card-title">My Online Games</h2>
			<p class="card-description">Sync and analyze your games from Lichess and Chess.com into your local database.</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateSettingsTab()">
			<div class="card-icon">⚙️</div>
			<h2 class="card-title">Control Center</h2>
			<p class="card-description">Configure your player profile, manage UCI engines, and customize online sync preferences.</p>
		</div>
	</div>
</div>

<OnlineGamesSyncDialog IsOpen="_showOnlineSyncModal"
					   OnClose="() => _showOnlineSyncModal = false"
					   OnDatabaseSelected="HandleOnlineDbSelected" />

@code {
	private bool _showOnlineSyncModal = false;

	private async Task HandleOnlineDbSelected(string dbName)
	{
		await DatabaseService.SetActiveDatabaseAsync(dbName);
		Workspace.CreateDatabaseTab();
	}

	private async Task HandlePgnUpload(InputFileChangeEventArgs e)
	{
		try
		{
			using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
			using var reader = new StreamReader(stream);
			string pgn = await reader.ReadToEndAsync();
			string title = Path.GetFileNameWithoutExtension(e.File.Name);
			Workspace.CreateAnalysisTab(title: title, pgn: pgn);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Dashboard] Failed to read PGN: {ex.Message}");
		}
	}
}
