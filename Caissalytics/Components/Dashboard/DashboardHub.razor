@namespace Caissalytics.Components.Dashboard
@using Caissalytics.Data
@inject WorkspaceState Workspace
@inject IEngineService EngineService
@inject IDatabaseService DatabaseService
@implements IDisposable

<div class="dashboard-container">
	<div class="dashboard-hero">
		<h1 class="dashboard-heading">Welcome to Caissalytics</h1>
		<p class="dashboard-subtitle">A modern, open-source chess analysis and database platform.</p>
	</div>

	<div class="quick-actions-grid">
		<div class="action-card" @onclick="() => Workspace.CreateAnalysisTab()">
			<div class="card-icon">♟️</div>
			<h2 class="card-title">New Analysis Board</h2>
			<p class="card-description">Open an interactive board to explore moves, build variations, annotate with glyphs, and run Stockfish.</p>
		</div>

		<div class="action-card" @onclick="() => Workspace.CreateDatabaseTab()">
			<div class="card-icon">🗄️</div>
			<h2 class="card-title">Browse Databases</h2>
			<p class="card-description">Manage collections, search games by player, ECO, or Elo, and import your PGN libraries.</p>
		</div>

		<label class="action-card">
			<div class="card-icon">📂</div>
			<h2 class="card-title">Open PGN File</h2>
			<p class="card-description">Import a game or study from your computer. Supports full notation, branching variations, and annotations.</p>
			<InputFile OnChange="HandlePgnUpload" class="hidden-file-input" accept=".pgn" />
		</label>

		<div class="action-card" @onclick="OpenSampleGame">
			<div class="card-icon">🏆</div>
			<h2 class="card-title">Load Immortal Game</h2>
			<p class="card-description">Quickly load Adolf Anderssen vs Lionel Kieseritzky (1851) to test the board and engine analysis.</p>
		</div>
	</div>

	<div class="dashboard-section">
		<div class="section-header">
			<h3 class="section-title">Database Hub</h3>
		</div>

		<div class="engine-status-row">
			<div class="engine-info-block">
				<div class="status-dot dot-ready"></div>
				<div>
					<div class="engine-label">@(_activeDb?.Name ?? "ClassicalMasters")</div>
					<div class="engine-subtext">
						<span>@(_activeDb?.GameCount.ToString("N0") ?? "0") games indexed (@(_activeDb?.FormattedSize ?? "0 B"))</span>
					</div>
				</div>
			</div>

			<div>
				<button class="btn-primary" @onclick="() => Workspace.CreateDatabaseTab()">Explore Database</button>
			</div>
		</div>
	</div>

	<div class="dashboard-section">
		<div class="section-header">
			<h3 class="section-title">Engine Hub</h3>
		</div>

		<div class="engine-status-row">
			<div class="engine-info-block">
				<div class="status-dot @(_activeEngine?.IsInstalled == true ? "dot-ready" : "")"></div>
				<div>
					<div class="engine-label">@(_activeEngine?.Name ?? "Stockfish 17")</div>
					<div class="engine-subtext">
						@if (_isInstalling)
						{
							<span>Downloading official Stockfish binary... (@_installProgress%)</span>
						}
						else if (_activeEngine?.IsInstalled == true)
						{
							<span>Ready for local UCI analysis (@_activeEngine.ExecutablePath)</span>
						}
						else
						{
							<span>Not installed yet. Click to enable 1-click local Stockfish analysis.</span>
						}
					</div>
				</div>
			</div>

			<div>
				@if (_isInstalling)
				{
					<button class="btn-primary" disabled>Installing...</button>
				}
				else if (_activeEngine?.IsInstalled == true)
				{
					<button class="btn-secondary" @onclick="() => Workspace.CreateAnalysisTab()">Start Analyzing</button>
				}
				else
				{
					<button class="btn-primary" @onclick="InstallStockfish">⚡ 1-Click Install Stockfish</button>
				}
			</div>
		</div>
	</div>
</div>

@code {
	private EngineInfo? _activeEngine;
	private DatabaseInfo? _activeDb;
	private bool _isInstalling = false;
	private int _installProgress = 0;

	protected override async Task OnInitializedAsync()
	{
		DatabaseService.OnActiveDatabaseChanged += HandleActiveDatabaseChanged;
		_activeEngine = await EngineService.GetActiveEngineAsync();
		_activeDb = await DatabaseService.GetActiveDatabaseAsync();
	}

	private async void HandleActiveDatabaseChanged()
	{
		await InvokeAsync(async () =>
		{
			_activeDb = await DatabaseService.GetActiveDatabaseAsync();
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		DatabaseService.OnActiveDatabaseChanged -= HandleActiveDatabaseChanged;
	}

	private async Task InstallStockfish()
	{
		_isInstalling = true;
		var progress = new Progress<int>(p =>
		{
			_installProgress = p;
			InvokeAsync(StateHasChanged);
		});

		bool success = await EngineService.InstallEngineAsync("stockfish-17", progress);
		_isInstalling = false;
		if (success)
		{
			_activeEngine = await EngineService.GetActiveEngineAsync();
		}
		StateHasChanged();
	}

	private async Task HandlePgnUpload(InputFileChangeEventArgs e)
	{
		try
		{
			using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
			using var reader = new StreamReader(stream);
			string pgn = await reader.ReadToEndAsync();
			string title = Path.GetFileNameWithoutExtension(e.File.Name);
			Workspace.CreateAnalysisTab(title: title, pgn: pgn);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Dashboard] Failed to read PGN: {ex.Message}");
		}
	}

	private void OpenSampleGame()
	{
		string pgn = @"[Event ""London""]
[Site ""London""]
[Date ""1851.06.21""]
[Round ""?""]
[White ""Anderssen, Adolf""]
[Black ""Kieseritzky, Lionel""]
[Result ""1-0""]

1. e4 e5 2. f4 exf4 3. Bc4 Qh4+ 4. Kf1 b5 5. Bxb5 Nf6 6. Nf3 Qh6 7. d3 Nh5 8. Nh4 Qg5 9. Nf5 c6 10. g4 Nf6 11. Rg1 cxb5 12. h4 Qg6 13. h5 Qg5 14. Qf3 Ng8 15. Bxf4 Qf6 16. Nc3 Bc5 17. Nd5 Qxb2 18. Bd6 Bxg1 ( 18... Qxa1+ 19. Ke2 Qb2 20. Kd2 Bxg1 21. e5 ) 19. e5 Qxa1+ 20. Ke2 Na6 21. Nxg7+ Kd8 22. Qf6+ Nxf6 23. Be7# 1-0";

		Workspace.CreateAnalysisTab(title: "The Immortal Game", pgn: pgn);
	}
}
