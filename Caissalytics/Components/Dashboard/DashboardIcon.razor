@namespace Caissalytics.Components.Dashboard

<div class="card-icon-badge card-icon-@Type">
	@switch (Type)
	{
		case "analysis":
			<!-- Chess Knight / Pawn -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M19 20H5v-2c0-1.5 1-2.5 2-3l1-1c-1-1-1.5-2.5-1-4l1-3 2-2 3 1 2 3-1 2c1 .5 2 1.5 2 3v2c1 .5 2 1.5 2 3v2z" />
				<line x1="8" y1="20" x2="16" y2="20" />
				<circle cx="10" cy="9" r="1" fill="currentColor" />
			</svg>
			break;

		case "databases":
			<!-- Database Cylinders -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<ellipse cx="12" cy="5" rx="9" ry="3" />
				<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
				<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
			</svg>
			break;

		case "open-pgn":
			<!-- Open Folder / File Upload -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2z" />
				<polyline points="12 11 12 17" />
				<polyline points="9 14 12 11 15 14" />
			</svg>
			break;

		case "online-games":
			<!-- Connected Globe -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10" />
				<line x1="2" y1="12" x2="22" y2="12" />
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
			</svg>
			break;

		case "puzzles":
			<!-- Puzzle Piece -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M19.439 7.85c-.049-.322.059-.659.289-.889l.71-.71a2.121 2.121 0 0 0-3-3l-.71.71a.985.985 0 0 1-.889.289c-.588-.088-1.187-.049-1.749.111l-.09-.09a2.121 2.121 0 0 0-3 3l.09.09c-.16.562-.199 1.161-.111 1.749.049.322-.059.659-.289.889l-.71.71a2.121 2.121 0 0 0 3 3l.71-.71c.23-.23.567-.338.889-.289.588.088 1.187.049 1.749-.111l.09.09a2.121 2.121 0 0 0 3-3l-.09-.09c.16-.562.199-1.161.111-1.749z" />
				<path d="M4 14.5A2.5 2.5 0 0 0 6.5 17H8v-1.5a2.5 2.5 0 1 1 5 0V17h1.5a2.5 2.5 0 0 0 2.5-2.5V13h-1.5a2.5 2.5 0 1 1 0-5H17V6.5A2.5 2.5 0 0 0 14.5 4H13v1.5a2.5 2.5 0 1 1-5 0V4H6.5A2.5 2.5 0 0 0 4 6.5V8h1.5a2.5 2.5 0 1 1 0 5H4v1.5z" />
			</svg>
			break;

		case "repertoire":
			<!-- Opening Repertoire Book -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
				<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
				<line x1="9" y1="7" x2="15" y2="7" />
				<line x1="9" y1="11" x2="13" y2="11" />
			</svg>
			break;

		case "dossier":
			<!-- Opponent Dossier / Detective -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8" />
				<line x1="21" y1="21" x2="16.65" y2="16.65" />
				<circle cx="11" cy="11" r="3" />
				<line x1="11" y1="5" x2="11" y2="7" />
				<line x1="11" y1="15" x2="11" y2="17" />
				<line x1="5" y1="11" x2="7" y2="11" />
				<line x1="15" y1="11" x2="17" y2="11" />
			</svg>
			break;

		case "endgames":
			<!-- Trophy / Mastery -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
				<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
				<path d="M4 22h16" />
				<path d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1c0 .55.45 1 1 1h8c.55 0 1-.45 1-1v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34" />
				<path d="M18 2H6v7a6 6 0 0 0 12 0V2z" />
			</svg>
			break;

		case "practice":
			<!-- AI Bot / Robot Head -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="11" width="18" height="10" rx="2" />
				<circle cx="8.5" cy="16" r="1.5" fill="currentColor" />
				<circle cx="15.5" cy="16" r="1.5" fill="currentColor" />
				<path d="M12 2v4" />
				<circle cx="12" cy="2" r="1" fill="currentColor" />
				<line x1="2" y1="16" x2="3" y2="16" />
				<line x1="21" y1="16" x2="22" y2="16" />
			</svg>
			break;

		case "analytics":
			<!-- Insights Trend & Chart -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="20" x2="18" y2="10" />
				<line x1="12" y1="20" x2="12" y2="4" />
				<line x1="6" y1="20" x2="6" y2="14" />
				<polyline points="3 11 9 5 13 9 21 1" />
				<polyline points="17 1 21 1 21 5" />
			</svg>
			break;

		case "homework":
			<!-- Coaching Checklist / Homework -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
				<rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
				<path d="M9 14l2 2 4-4" />
			</svg>
			break;

		case "club-homework":
			<!-- Received Inbox -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
				<path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
				<line x1="12" y1="6" x2="12" y2="12" />
				<polyline points="9 9 12 12 15 9" />
			</svg>
			break;

		case "settings":
		default:
			<!-- Mechanical Gear -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="3" />
				<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
			</svg>
			break;
	}
</div>

@code {
	[Parameter, EditorRequired] public string Type { get; set; } = "";
}
